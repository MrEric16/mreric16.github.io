,["you (formal or plural)","ön / ti","urn / tee"],["they","ők","urk"]],"ex":[["I am a student","diák vagyok","DEE-ahk VO-dyok"],["you are tall","magas vagy","MO-gosh vodj"],["she is my older sister","ő a nővérem","ur o NUR-vay-rem"],["we are friends","barátok vagyunk","BO-rah-tok VO-dyoonk"],["they are teachers","tanárok","TO-nah-rok"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Add -k to the noun. After a vowel it is -k; after a consonant it adds a vowel first: könyv, könyvek. After a number, the noun stays singular: két könyv (two book)."],"rows":[["könyv (book)","könyvek","KURNV-ek"],["ház (house)","házak","HAH-zok"],["gyerek (child)","gyerekek","DYEH-reh-kek"],["macska (cat)","macskák","MOCH-kahk"],["after a number: singular","két könyv","kayt kurnv"]],"ex":[["one house, houses","egy ház, házak","ed hahz HAH-zok"],["one book, books","egy könyv, könyvek","ed kurnv KURNV-ek"],["one cat, cats","egy macska, macskák","ed MOCH-ko MOCH-kahk"],["two books","két könyv","kayt kurnv"],["the children","a gyerekek","o DYEH-reh-kek"]]},{"id":"to-be-lenni","title":"To be: lenni","text":["In the present, \"van\" (is) is dropped with adjectives and nouns for he and she. Learn: vagyok, vagy, van, vagyunk, vagytok, vannak."],"rows":[["I am","vagyok","VO-dyok"],["you are","vagy","vodj"],["he / she is","van","von"],["we are","vagyunk","VO-dyoonk"],["you are (formal)","van","von"],["they are","vannak","VON-nok"]],"ex":[["I am a student","diák vagyok","DEE-ahk VO-dyok"],["you are tired","fáradt vagy","FAH-rodt vodj"],["he is a doctor","ő orvos","ur OR-vosh"],["we are happy","boldogok vagyunk","BOL-do-gok VO-dyoonk"],["they are at home","otthon vannak","OT-thon VON-nok"]]},{"id":"van-have","title":"Van: have","text":["Hungarian says \"to me there is\": nekem van (I have), neked van (you have), neki van (he has). The owned thing takes an ending: nekem van autóm."],"rows":[["I have","nekem van","NEH-kem von"],["you have","neked van","NEH-ked von"],["he / she has","neki van","NEH-kee von"],["we have","nekünk van","NEH-kewnk von"],["I do not have","nincs","neench"]],"ex":[["I have an older brother","nekem van egy bátyám","NEH-kem von ed BAH-tyahm"],["I have a car","nekem van autóm","NEH-kem von OW-tohm"],["I do not have time","nincs időm","neench EE-durm"],["there is a problem","van egy probléma","von ed PROB-lay-mo"],["there is no water","nincs víz","neench veez"]]},{"id":"present-tense","title":"Present tense","text":["The verb ending shows the person. Dolgozni (to work): dolgozom, dolgozol, dolgozik, dolgozunk, dolgoztok, dolgoznak."],"rows":[["I work","dolgozom","DOL-go-zom"],["you work","dolgozol","DOL-go-zol"],["he / she works","dolgozik","DOL-go-zik"],["we work","dolgozunk","DOL-go-zoonk"],["you work (formal)","dolgozik","DOL-go-zik"],["they work","dolgoznak","DOL-goz-nok"]],"ex":[["I am eating bread","kenyeret eszem","KEN-yeh-ret E-sem"],["you are reading a book","könyvet olvasol","KURN-vet OL-vo-shol"],["she works in a bank","bankban dolgozik","BONK-bon DOL-go-zik"],["we drink tea","teát iszunk","TEH-aht EE-soonk"],["they are sleeping","alszanak","OL-so-nok"]]},{"id":"basic-sentences","title":"Basic sentences","text":["The usual order is who, what, verb, but Hungarian is flexible. The word you stress goes first. \"A\" or \"az\" means \"the\"."],"rows":[["I read a book","könyvet olvasok","KURN-vet OL-vo-shok"],["she drinks tea","teát iszik","TEH-aht EE-sik"],["we go to school","iskolába megyünk","ISH-ko-lah-bo MED-yewnk"]],"ex":[["I read a book","könyvet olvasok","KURN-vet OL-vo-shok"],["he drinks tea","teát iszik","TEH-aht EE-sik"],["we go to school","iskolába megyünk","ISH-ko-lah-bo MED-yewnk"],["they eat bread","kenyeret esznek","KEN-yeh-ret ES-nek"],["the teacher writes","a tanár ír","o TO-nahr eer"]]},{"id":"negation","title":"Negation","text":["Put \"nem\" before the verb: megyek (I go), nem megyek (I do not go). For \"there is not\", use \"nincs\" or \"nincsenek\"."],"rows":[["I go","megyek","MED-yek"],["I do not go","nem megyek","nem MED-yek"],["is","van","von"],["is not","nincs","neench"]],"ex":[["I want","akarok","O-ko-rok"],["I do not want","nem akarok","nem O-ko-rok"],["I speak English","beszélek angolul","BES-ay-lek ON-go-lool"],["I do not speak English","nem beszélek angolul","nem BES-ay-lek ON-go-lool"],["I like it","tetszik","TET-sik"],["I do not like it","nem tetszik","nem TET-sik"],["she is here","ő itt van","ur eet von"],["she is not here","ő nincs itt","ur neench eet"],["I have a car","nekem van autóm","NEH-kem von OW-tohm"],["I do not have a car","nincs autóm","neench OW-tohm"],["I understand","értem","AYR-tem"],["I do not understand","nem értem","nem AYR-tem"],["we are tired","fáradtak vagyunk","FAH-rod-tok VO-dyoonk"],["we are not tired","nem vagyunk fáradtak","nem VO-dyoonk FAH-rod-tok"],["he works on Sundays","vasárnap dolgozik","VO-shahr-nop DOL-go-zik"],["he does not work on Sundays","vasárnap nem dolgozik","VO-shahr-nop nem DOL-go-zik"]]},{"id":"asking-questions","title":"Asking questions","text":["The word order does not change. Just raise your voice at the end. You can also add the little ending \"-e\" in written Hungarian."],"rows":[["you are a student","diák vagy"],["are you a student?","diák vagy?"],["he is here","ő itt van"],["is he here?","ő itt van?"]],"ex":[["is this your book?","ez a te könyved?","ez o teh KURN-ved"],["are they here?","itt vannak?","eet VON-nok"],["do you like tea?","szereted a teát?","SEH-reh-ted o TEH-aht"],["is it cold?","hideg van?","HEE-deg von"],["do you speak English?","beszél angolul?","BES-ayl ON-go-lool"]]},{"id":"question-words","title":"Question words","text":["Question words usually come just before the verb."],"rows":[["what","mi","mee"],["who","ki","kee"],["where","hol","hol"],["when","mikor","MEE-kor"],["why","miért","MEE-ayrt"],["how","hogyan","HOD-yon"],["how much","mennyi","MEN-nyee"],["which","melyik","MEH-yik"]],"ex":[["what is your name?","hogy hívnak?","hodj HEEV-nok"],["who is he?","ki ő?","kee ur"],["where do you live?","hol laksz?","hol loks"],["when is the lesson?","mikor van az óra?","MEE-kor von oz OH-ro"],["why are you late?","miért késtél?","MEE-ayrt KAYSH-tayl"],["how much is it?","mennyibe kerül?","MEN-nyee-beh KEH-rewl"],["which book?","melyik könyv?","MEH-yik kurnv"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["The owned thing takes an ending: -m (my), -d (your), -ja / -e (his, her), -nk (our), -tok (your, formal), -juk (their): könyvem, könyved, könyve. To like something, use \"szeretni\"."],"rows":[["my book","a könyvem","o KURN-vem"],["your book","a könyved","o KURN-ved"],["his / her book","a könyve","o KURN-veh"],["our book","a könyvünk","o KURN-vewnk"],["your book (formal)","az ön könyve","oz urn KURN-veh"]],"ex":[["my phone","a telefonom","o TEH-leh-fo-nom"],["your house (formal)","az ön háza","oz urn HAH-zo"],["his sister","a nővére","o NUR-vay-reh"],["I like music","szeretem a zenét","SEH-reh-tem o ZEH-nayt"],["I love football","imádom a focit","EE-mah-dom o FO-tsit"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["te (informal): friends, family, children. ön (formal): strangers, older people, work. The verb ending changes: vagy / van, beszélsz / beszél."],"rows":[["how are you?","hogy vagy? / hogy van?","hodj vodj / hodj von"],["you speak","beszélsz / beszél","BES-ayls / BES-ayl"],["your name","a neved / az ön neve","o NEH-ved / oz urn NEH-veh"]],"ex":[["how are you? (informal)","hogy vagy?","hodj vodj"],["how are you? (formal)","hogy van?","hodj von"],["where are you going? (informal)","hova mész?","HO-vo mays"],["where are you going? (formal)","hova megy?","HO-vo medj"],["please sit down (formal)","foglaljon helyet, kérem","FOG-lol-yon HEH-yet, KAY-rem"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: add -t- to the stem and the person ending: mentem (I went). Future: \"fogok\" + the basic verb: fogok menni (I will go)."],"rows":[["I went","mentem","MEN-tem"],["you went","mentél","MEN-tayl"],["he went","ment","ment"],["we went","mentünk","MEN-tewnk"]],"ex":[["yesterday I was tired","tegnap fáradt voltam","TEG-nop FAH-rodt VOL-tom"],["I will study tomorrow","holnap tanulni fogok","HOL-nop TO-nool-nee FO-gok"],["we went to the park","a parkba mentünk","o POR-kbo MEN-tewnk"],["I saw him","láttam őt","LAHT-tom urt"],["she wrote a letter","levelet írt","LEH-veh-let eert"]]},{"id":"commands","title":"Commands","text":["Informal: the stem with a vowel (gyere). Formal: a different form (jöjjön). To forbid, put \"ne\" in front: ne gyere."],"rows":[["come (informal)","gyere","DYEH-reh"],["come (formal)","jöjjön","YURY-yurn"],["do not come","ne gyere","neh DYEH-reh"],["sit down","ülj le","ewly leh"]],"ex":[["come here","gyere ide","DYEH-reh EE-deh"],["do not come here","ne gyere ide","neh DYEH-reh EE-deh"],["sit down","ülj le","ewly leh"],["do not sit down","ne ülj le","neh ewly leh"],["be quiet","légy csendben","layj CHEND-ben"],["do not be late","ne késs el","neh kaysh el"],["open the door","nyisd ki az ajtót","nyeesd kee oz OY-toht"],["close the window","csukd be az ablakot","chookd beh oz OB-lo-kot"],["listen to me","hallgass meg","HOL-gosh meg"],["do not worry","ne aggódj","neh OG-goh-dj"],["speak slowly","beszélj lassan","BES-ayly LOSH-shon"],["wait a moment","várj egy percet","vahry ed PER-tset"]]},{"id":"can-must-want","title":"Can, must, want","text":["Tudni (can): tudok + basic verb. Kell (must): mennem kell. Akarni (want): menni akarok."],"rows":[["I can swim","tudok úszni"],["I cannot swim","nem tudok úszni"],["I must go","mennem kell"],["I want to go","menni akarok"]],"ex":[["I can swim","tudok úszni","TOO-dok OOS-nee"],["I cannot swim","nem tudok úszni","nem TOO-dok OOS-nee"],["can you help me?","tud segíteni?","tood SHEH-gee-teh-nee"],["we must go","mennünk kell","MEN-newnk kell"],["we must not go","nem szabad mennünk","nem SO-bod MEN-newnk"],["I want to eat","enni akarok","EN-nee O-ko-rok"],["I do not want to eat","nem akarok enni","nem O-ko-rok EN-nee"],["you can come","jöhetsz","YUR-hetz"],["you cannot come","nem jöhetsz","nem YUR-hetz"],["she wants to study","tanulni akar","TO-nool-nee O-kor"],["I must work today","ma dolgoznom kell","mo DOL-goz-nom kell"],["you must not run","nem szabad futnod","nem SO-bod FOOT-nod"]]},{"id":"in-on-at","title":"In, on, at","text":["Hungarian uses endings, not words in front: -ban / -ben (in), -on / -en / -ön (on), -nál / -nél (at), -ba / -be (into), -tól / -től (from). The vowel follows harmony."],"rows":[["in","-ban / -ben","bon / ben"],["on","-on / -en / -ön","on / en / urn"],["at","-nál / -nél","nahl / nayl"],["into","-ba / -be","bo / beh"]],"ex":[["the book is on the table","a könyv az asztalon van","o kurnv oz OS-to-lon von"],["the cat is under the table","a macska az asztal alatt van","o MOCH-ko oz OS-tol O-lott von"],["I am at school","az iskolában vagyok","oz ISH-ko-lah-bon VO-dyok"],["I am at home","otthon vagyok","OT-thon VO-dyok"],["the shop is next to the bank","a bolt a bank mellett van","o bolt o bonk MEL-lett von"],["the park is near the station","a park az állomás közelében van","o pork oz AHL-lo-mahsh KUR-zeh-lay-ben von"],["we meet in the morning","reggel találkozunk","REG-gel TOL-ol-ko-zoonk"],["the lesson is at nine","az óra kilenckor van","oz OH-ro KEE-lents-kor von"],["the key is in the bag","a kulcs a táskában van","o koolch o TAHSH-kah-bon von"]]},{"id":"comparing-things","title":"Comparing things","text":["Add -bb for \"more\": nagy, nagyobb. For \"the most\" put \"leg-\" in front: legnagyobb. \"Than\" is \"mint\"."],"rows":[["big, bigger, the biggest","nagy, nagyobb, legnagyobb"],["small, smaller, the smallest","kicsi, kisebb, legkisebb"]],"ex":[["big, bigger, the biggest","nagy, nagyobb, legnagyobb","nodj NOD-yobb LEG-nod-yobb"],["small, smaller, the smallest","kicsi, kisebb, legkisebb","KEE-chee KEE-shebb LEG-kee-shebb"],["this is better than that","ez jobb, mint az","ez yobb mint oz"],["this is worse than that","ez rosszabb, mint az","ez ROS-sobb mint oz"],["she is taller than me","ő magasabb nálam","ur MO-go-shobb NAH-lom"],["Tashkent is bigger than Samarkand","Taskent nagyobb, mint Szamarkand","TOSH-kent NOD-yobb mint SO-mor-kond"],["it is the cheapest","ez a legolcsóbb","ez o LEG-ol-choh-bb"],["the same as","ugyanolyan, mint","OO-dyon-o-yon mint"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Quick sentences to copy and change."],"rows":[],"ex":[["he is a teacher","ő tanár","ur TO-nahr"],["you (plural) are students","ti diákok vagytok","tee DEE-ah-kok VODJ-tok"],["I am happy","boldog vagyok","BOL-dog VO-dyok"],["she is at school","ő az iskolában van","ur oz ISH-ko-lah-bon von"],["you are my friend","te vagy a barátom","teh vodj o BO-rah-tom"],["it is cold","hideg van","HEE-deg von"],["I study English","angolul tanulok","ON-go-lool TO-noo-lok"],["he teaches maths","matematikát tanít","MO-teh-mo-tee-kaht TO-neet"],["they work every day","minden nap dolgoznak","MIN-den nop DOL-goz-nok"],["is this your book?","ez az ön könyve?","ez oz urn KURN-veh"],["are they here?","itt vannak?","eet VON-nok"],["do you like tea?","szereti a teát?","SEH-reh-tee o TEH-aht"],["what time is it?","hány óra van?","hahny OH-ro von"],["whose book is this?","kié ez a könyv?","KEE-ay ez o kurnv"],["how old are you?","hány éves vagy?","hahny AY-vesh vodj"],["how do you say it?","hogy mondják ezt?","hodj MOND-yahk ezt"],["your book (formal)","az ön könyve","oz urn KURN-veh"],["their house","az ő házuk","oz ur HAH-zook"],["my phone","a telefonom","o TEH-leh-fo-nom"],["excuse me, sir","elnézést, uram","EL-nay-zaysht, OO-rom"],["please sit down (formal)","foglaljon helyet, kérem","FOG-lol-yon HEH-yet, KAY-rem"],["come here (informal)","gyere ide","DYEH-reh EE-deh"],["yesterday I was tired","tegnap fáradt voltam","TEG-nop FAH-rodt VOL-tom"],["I will study tomorrow","holnap tanulni fogok","HOL-nop TO-nool-nee FO-gok"],["we went to the park","a parkba mentünk","o POR-kbo MEN-tewnk"]]}],"name":"Hungarian","id":"hu","flag":"hu","note":""}