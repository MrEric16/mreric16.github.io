,["you (to a woman)","anchi","አንቺ"],["you (formal)","irswo","እርስዎ"],["he","isu","እሱ"],["she","iswa","እሷ"],["we","inya","እኛ"],["you (plural)","inante","እናንተ"],["they","inesu","እነሱ"]],"ex":[["I am a student","ene temari negn","","እኔ ተማሪ ነኝ"],["you are tall","ante rejim neh","","አንተ ረጅም ነህ"],["she is my sister","iswa ihite nat","","እሷ እህቴ ናት"],["we are friends","inya gwadegnamoch nen","","እኛ ጓደኛሞች ነን"],["they are teachers","inesu astemariwoch nachew","","እነሱ አስተማሪዎች ናቸው"],["I am happy","ene destegna negn","","እኔ ደስተኛ ነኝ"],["he is a doctor","isu hakim new","","እሱ ሐኪም ነው"],["you all are late","inante zegyitachihwal","","እናንተ ዘግይታችኋል"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["The plural ending is -och (-woch after a vowel). Amharic nouns do not change after a number: hulet mets'haf (two book)."],"rows":[["-och","mets'haf → mets'hafoch","መጽሐፍ → መጽሐፎች"],["-woch (after a vowel)","temari → temariwoch","ተማሪ → ተማሪዎች"],["after a number","hulet mets'haf","ሁለት መጽሐፍ"]],"ex":[["the boy","wend lij","","ወንድ ልጅ"],["the girl","set lij","","ሴት ልጅ"],["the books","mets'hafoch","","መጽሐፎች"],["a red house","qey bet","","ቀይ ቤት"],["the cities","ketemoch","","ከተሞች"],["one cat, two cats","and dimet, hulet dimet","","አንድ ድመት ሁለት ድመት"],["one pen, two pens","and iskribito, hulet iskribito","","አንድ እስክሪብቶ ሁለት እስክሪብቶ"],["a lesson, lessons","timihirt, timihirtoch","","ትምህርት ትምህርቶች"]]},{"id":"to-be-who-or-what","title":"To be (who or what)","text":["The word \"to be\" is separate. It changes for person: negn (I am), neh (you, man), nesh (you, woman), new (he is), nat (she is), nen (we are), nachihu (you are, plural), nachew (they are)."],"rows":[["I am","negn","ነኝ"],["you are (to a man)","neh","ነህ"],["you are (to a woman)","nesh","ነሽ"],["he is","new","ነው"],["she is","nat","ናት"],["we are","nen","ነን"],["you are (plural)","nachihu","ናችሁ"],["they are","nachew","ናቸው"]],"ex":[["I am English","engilizawi negn","","እንግሊዛዊ ነኝ"],["he is a doctor","hakim new","","ሐኪም ነው"],["it is Monday","zare segno new","","ዛሬ ሰኞ ነው"],["we are from Uzbekistan","inya keuzbekistan nen","","እኛ ከኡዝቤኪስታን ነን"],["they are tall","rejim nachew","","ረጅም ናቸው"],["I am at home","bet negn","","ቤት ነኝ"],["where are you?","yet neh?","","የት ነህ?"],["we are well","dehna nen","","ደህና ነን"],["the soup is cold","shorbaw qezqaza new","","ሾርባው ቀዝቃዛ ነው"],["she is tired","dekimwatal","","ደክሟታል"]]},{"id":"ale-to-have-and-to-be-there","title":"Ale: to have and to be there","text":["\"Alegn\" (to me there is) means \"I have\". It changes: alegn (I), aleh (you, man), alesh (you, woman), alew (he), alat (she), alen (we), alachihu (you pl.), alachew (they). \"There is\" is ale. Negative: yelem (there is not)."],"rows":[["I have","alegn","አለኝ"],["you have (to a man)","aleh","አለህ"],["you have (to a woman)","alesh","አለሽ"],["he has","alew","አለው"],["she has","alat","አላት"],["we have","alen","አለን"],["they have","alachew","አላቸው"]],"ex":[["I have a brother","wendim alegn","","ወንድም አለኝ"],["she has two cats","hulet dimet alat","","ሁለት ድመት አላት"],["we have time","gize alen","","ጊዜ አለን"],["they have a car","mekina alachew","","መኪና አላቸው"],["there is a lesson today","zare timihirt ale","","ዛሬ ትምህርት አለ"],["there is no teacher","astemari yelem","","አስተማሪ የለም"],["I have a question","t'iyaqe alegn","","ጥያቄ አለኝ"],["I am hungry","rebognal","","ርቦኛል"]]},{"id":"verbs-present-and-future","title":"Verbs: present and future","text":["The same form is used for habit and future: i-sera-lehu (I work / I will work). The prefixes are: i- (I), ti- (you), yi- (he), ti- (she), in- (we), yi- ... -u (they). For \"now\", use eye- + verb + new: eyaneb ebku new (I am reading)."],"rows":[["I work","iseralehu","እሰራለሁ"],["you work (man)","tiseraleh","ትሰራለህ"],["you work (woman)","tiseralesh","ትሰራለሽ"],["he works","yiseral","ይሰራል"],["she works","tiseralech","ትሰራለች"],["we work","inseralen","እንሰራለን"],["they work","yiseralu","ይሰራሉ"]],"ex":[["I work","iseralehu","","እሰራለሁ"],["you speak","tinageraleh","","ትናገራለህ"],["she reads","tanebalech","","ታነባለች"],["we eat","inbelalen","","እንበላለን"],["they live in Tashkent","tashkent yinoralu","","ታሽከንት ይኖራሉ"],["I am reading now","ahun eyanebebku new","","አሁን እያነበብኩ ነው"],["he is sleeping","eyetegna new","","እየተኛ ነው"],["I drink tea every day","beyeqenu shay et'et'alehu","","በየቀኑ ሻይ እጠጣለሁ"]]},{"id":"going-mehed","title":"Going: mehed","text":["\"Mehed\" is to go. The forms are ihedalehu (I go), tihedaleh (you go), yihedal (he goes), tihedalech (she goes), inihedalen (we go), yihedalu (they go). \"To\" is wede."],"rows":[["I go","ihedalehu","እሄዳለሁ"],["you go (man)","tihedaleh","ትሄዳለህ"],["he goes","yihedal","ይሄዳል"],["she goes","tihedalech","ትሄዳለች"],["we go","inihedalen","እንሄዳለን"],["they go","yihedalu","ይሄዳሉ"]],"ex":[["I am going to school","wede timihirt bet ihedalehu","","ወደ ትምህርት ቤት እሄዳለሁ"],["she is going to the shop","wede suq tihedalech","","ወደ ሱቅ ትሄዳለች"],["we go to the park","wede menafesha inihedalen","","ወደ መናፈሻ እንሄዳለን"],["he goes to work","wede sira yihedal","","ወደ ስራ ይሄዳል"],["I am going home","wede bet ihedalehu","","ወደ ቤት እሄዳለሁ"],["they are going to the city","wede ketema yihedalu","","ወደ ከተማ ይሄዳሉ"],["where are you going?","wede yet tihedaleh?","","ወደ የት ትሄዳለህ?"],["I come from London","kelenden imet'alehu","","ከለንደን እመጣለሁ"],["she comes from Tashkent","ketashkent timet'alech","","ከታሽከንት ትመጣለች"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Word order is subject – object – verb. The verb comes last. Adjectives come before nouns. \"To be\" also comes last."],"rows":[["subject – object – verb","mets'haf ianebalehu","መጽሐፍ አነባለሁ"],["adjective before noun","tiliq bet","ትልቅ ቤት"],["time first","nege imarallehu","ነገ እማራለሁ"]],"ex":[["I read a book","mets'haf anebalehu","","መጽሐፍ አነባለሁ"],["the teacher asks a question","astemariw t'iyaqe yit'eyiqal","","አስተማሪው ጥያቄ ይጠይቃል"],["she drinks tea","shay tit'et'alech","","ሻይ ትጠጣለች"],["we watch television","televizhin inayalen","","ቴሌቪዥን እናያለን"],["I live in Tashkent","tashkent enoralehu","","ታሽከንት እኖራለሁ"],["the dog is big","wushaw tiliq new","","ውሻው ትልቅ ነው"],["tomorrow I will study","nege imaralehu","","ነገ እማራለሁ"]]},{"id":"negation","title":"Negation","text":["A verb is negated with al- at the front and -m at the end: efeligalehu → alefeligim (I do not want). \"Is not\" is aydelem. \"There is none\" is yelem. Always compare with the positive form."],"rows":[["not (verb)","al- ... -m","አል- ... -ም"],["is not","aydelem","አይደለም"],["there is none","yelem","የለም"],["no","ay","አይ"]],"ex":[["I want","efeligalehu","","እፈልጋለሁ"],["I do not want","alefeligim","","አልፈልግም"],["I speak English","englizigna enageralehu","","እንግሊዝኛ እናገራለሁ"],["I do not speak English","englizigna alenagerim","","እንግሊዝኛ አልናገርም"],["I like it","ewedewalehu","","እወደዋለሁ"],["I do not like it","alewedewim","","አልወደውም"],["she is here","izih nat","","እዚህ ናት"],["she is not here","izih aydelechim","","እዚህ አይደለችም"],["I have a car","mekina alegn","","መኪና አለኝ"],["I do not have a car","mekina yelegnim","","መኪና የለኝም"],["I understand","gebtognal","","ገብቶኛል"],["I do not understand","algebagnim","","አልገባኝም"],["we are tired","dekimonal","","ደክሞናል"],["we are not tired","aldekemenim","","አልደከመንም"],["he works on Sundays","ihud yiseral","","እሁድ ይሰራል"],["he does not work on Sundays","ihud ayiserram","","እሁድ አይሰራም"],["he is a student","temari new","","ተማሪ ነው"],["he is not a student","temari aydelem","","ተማሪ አይደለም"],["I know","awuqalehu","","አውቃለሁ"],["I do not know","alawuqim","","አላውቅም"]]},{"id":"asking-questions","title":"Asking questions","text":["Yes / no questions have the same word order as a statement. Only the rising tone shows it is a question. Answer with awo (yes) or ay (no)."],"rows":[["statement → question","shay tiwedaleh. → shay tiwedaleh?","ሻይ ትወዳለህ። → ሻይ ትወዳለህ?"]],"ex":[["is this your book?","yih yante mets'haf new?","","ይህ የአንተ መጽሐፍ ነው?"],["are they here?","izih nachew?","","እዚህ ናቸው?"],["do you like tea?","shay tiwedaleh?","","ሻይ ትወዳለህ?"],["do you speak English?","englizigna tinageraleh?","","እንግሊዝኛ ትናገራለህ?"],["is there a bank near here?","izih qirib bank ale?","","እዚህ ቅርብ ባንክ አለ?"],["can I come in?","ligba?","","ልግባ?"],["are you a student?","temari neh?","","ተማሪ ነህ?"],["is the shop open?","suqu kifit new?","","ሱቁ ክፍት ነው?"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["who","man","ማን"],["what","min","ምን"],["where","yet","የት"],["when","meche","መቼ"],["why","lemin","ለምን"],["how","endet","እንዴት"],["which","yetegnaw","የትኛው"],["how many","sint","ስንት"],["whose","yeman","የማን"]],"ex":[["who is that?","ya man new?","","ያ ማን ነው?"],["what is this?","yih min new?","","ይህ ምን ነው?"],["where do you live?","yet tinoraleh?","","የት ትኖራለህ?"],["when is the exam?","fetenaw meche new?","","ፈተናው መቼ ነው?"],["why are you late?","lemin zegayeh?","","ለምን ዘገየህ?"],["how do you say it?","endet yibalal?","","እንዴት ይባላል?"],["which book?","yetegnaw mets'haf?","","የትኛው መጽሐፍ?"],["how many students are there?","sint temariwoch alu?","","ስንት ተማሪዎች አሉ?"],["whose book is this?","yih yeman mets'haf new?","","ይህ የማን መጽሐፍ ነው?"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["Possessives are endings on the noun: -e (my), -h (your, man), -sh (your, woman), -wo (your, formal), -u (his), -wa (her), -achin (our), -achihu (your, plural), -achew (their). To like: mewdid (to love / like)."],"rows":[["my","-e","-ዬ / -ዬ"],["your (man)","-h","-ህ"],["your (woman)","-sh","-ሽ"],["your (formal)","-wo","-ዎ"],["his","-u","-ው"],["her","-wa","-ዋ"],["our","-achin","-ችን"],["their","-achew","-ቸው"]],"ex":[["my phone","silke","","ስልኬ"],["your book (formal)","mets'hafwo","","መጽሐፍዎ"],["their house","betachew","","ቤታቸው"],["I like tea","shay ewedalehu","","ሻይ እወዳለሁ"],["she likes music","muziqa tiwedalech","","ሙዚቃ ትወዳለች"],["our teacher","astemariyachin","","አስተማሪያችን"],["his car","mekinaw","","መኪናው"],["I do not like coffee","buna alewedim","","ቡና አልወድም"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Use the formal \"irswo\" for elders and strangers, with the verb in the plural. The ending changes for a man (-h) and a woman (-sh). The command changes too."],"rows":[],"ex":[["you (informal) are my friend","ante gwadegnaye neh","","አንተ ጓደኛዬ ነህ"],["you (formal) are a teacher","irswo astemari newot","","እርስዎ አስተማሪ ነዎት"],["how are you? (to a man)","endet neh?","","እንዴት ነህ?"],["how are you? (formal)","endet newot?","","እንዴት ነዎት?"],["come here (to a man)","na","","ና"],["come here (formal)","yimt'u","","ይምጡ"],["sit down (to a man)","teqemet'","","ተቀመጥ"],["please sit down (formal)","ebakwo yiqemet'u","","እባክዎ ይቀመጡ"],["what is your name? (to a man)","simih man new?","","ስምህ ማን ነው?"],["what is your name? (formal)","simwo man new?","","ስምዎ ማን ነው?"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: the stem + the personal ending -ehu (I): berahu. Future: use the present form. \"Was\" is neber: dekimogn neber (I was tired)."],"rows":[["I did","-ehu","-ሁ"],["I will","i- ... -alehu","እ- ... -ለሁ"]],"ex":[["yesterday I was tired","tinant dekimogn neber","","ትናንት ደክሞኝ ነበር"],["I will study tomorrow","nege imaralehu","","ነገ እማራለሁ"],["we went to the park","wede menafesha hedin","","ወደ መናፈሻ ሄድን"],["I ate","belahu","","በላሁ"],["she will come","timet'alech","","ትመጣለች"],["they bought it","gezut","","ገዙት"],["he called me","dewelelign","","ደወለልኝ"],["next week we will travel","bemiqet'ilew samint ingwazalen","","በሚቀጥለው ሳምንት እንጓዛለን"]]},{"id":"commands","title":"Commands","text":["The command to one man is the bare stem: na (come). To a woman it ends in -i: ni. To several people: -u. Negative: at- or at- ... -i: atimt'a (do not come)."],"rows":[],"ex":[["come here","izih na","","እዚህ ና"],["do not come here","izih atimt'a","","እዚህ አትምጣ"],["sit down","teqemet'","","ተቀመጥ"],["do not sit down","atiqemet'","","አትቀመጥ"],["be quiet","zim bel","","ዝም በል"],["do not be late","atizegay","","አትዘግይ"],["open the door","berun kifet","","በሩን ክፈት"],["close the window","meskotun ziga","","መስኮቱን ዝጋ"],["listen to me","simagn","","ስማኝ"],["do not worry","atich'eneq","","አትጨነቅ"],["speak slowly","bezigita tenager","","በዝግታ ተናገር"],["wait a moment","tinish t'ebiq","","ትንሽ ጠብቅ"]]},{"id":"can-must-want","title":"Can, must, want","text":["Can: tichilaleh (you can); negative: atichilim. Must: alebign (I must); must not: yelebignim. Want: efeligalehu. These take a verbal noun: mehed (to go)."],"rows":[],"ex":[["I can swim","mewanyet ichilalehu","","መዋኘት እችላለሁ"],["I cannot swim","mewanyet alichilim","","መዋኘት አልችልም"],["can you help me?","tiredagnaleh?","","ትረዳኛለህ?"],["we must go","mehed alebin","","መሄድ አለብን"],["we must not go","mehed yelebinim","","መሄድ የለብንም"],["I want to eat","mebelat efeligalehu","","መብላት እፈልጋለሁ"],["I do not want to eat","mebelat alefeligim","","መብላት አልፈልግም"],["you can come","memt'at tichilaleh","","መምጣት ትችላለህ"],["you cannot come","memt'at atichilim","","መምጣት አትችልም"],["she wants to study","memar tifeligalech","","መማር ትፈልጋለች"],["I must work today","zare mesrat alebign","","ዛሬ መስራት አለብኝ"],["you must not run","merot' yelebihim","","መሮጥ የለብህም"]]},{"id":"in-on-at","title":"In, on, at","text":["Amharic uses words after the noun (postpositions): lay (on), sir (under), wist' (in), at'egeb (next to), qirib (near). Place with \"to be\" ends the sentence."],"rows":[["on","lay","ላይ"],["under","sir","ስር"],["in","wist'","ውስጥ"],["next to","at'egeb","አጠገብ"],["near","qirib","ቅርብ"]],"ex":[["the book is on the table","mets'hafu t'erep'ezaw lay new","","መጽሐፉ ጠረጴዛው ላይ ነው"],["the cat is under the table","dimetwa t'erep'ezaw sir nat","","ድመቷ ጠረጴዛው ስር ናት"],["I am at school","timihirt bet negn","","ትምህርት ቤት ነኝ"],["I am at home","bet negn","","ቤት ነኝ"],["the shop is next to the bank","suqu banku at'egeb new","","ሱቁ ባንኩ አጠገብ ነው"],["the park is near the station","menafeshaw ket'abiyaw qirib new","","መናፈሻው ከጣቢያው ቅርብ ነው"],["we meet in the morning","t'ewat engenagnalen","","ጠዋት እንገናኛለን"],["the lesson is at nine","timihirtu zet'egn se'at lay new","","ትምህርቱ ዘጠኝ ሰዓት ላይ ነው"],["the key is in the bag","qulfu shanit'aw wist' new","","ቁልፉ ሻንጣው ውስጥ ነው"]]},{"id":"comparing-things","title":"Comparing things","text":["Use ke- (than) before the thing you compare to, and yebelt' (more): ke ya yishalal (it is better than that). \"The most\" is kehulu (than all)."],"rows":[["than","ke-","ከ-"],["more","yebelt'","የበለጠ"],["than all","kehulu","ከሁሉ"]],"ex":[["big, bigger, the biggest","tiliq, yebelt' tiliq, kehulu yemibelt' tiliq","","ትልቅ የበለጠ ትልቅ ከሁሉ የሚበልጥ ትልቅ"],["small, smaller, the smallest","tinish, yebelt' tinish, kehulu tinish","","ትንሽ የበለጠ ትንሽ ከሁሉ ትንሽ"],["this is better than that","yih keziya yishalal","","ይህ ከዚያ ይሻላል"],["this is worse than that","yih keziya yebase new","","ይህ ከዚያ የባሰ ነው"],["she is taller than me","keene tirezimalech","","ከእኔ ትረዝማለች"],["Tashkent is bigger than Samarkand","tashkent kesamarkand tibelt'alech","","ታሽከንት ከሳምርካንድ ትበልጣለች"],["it is the cheapest","kehulum rikash new","","ከሁሉም ርካሽ ነው"],["the same as","lik inde","","ልክ እንደ"]]},{"id":"moods-and-wishes","title":"Moods and wishes","text":["\"If\" is ke- ... -ä (\"kehone\" = if it is). Let us: in- + verb (inihid). Wishes: melkam (good) + noun."],"rows":[["if","kehone","ከሆነ"],["let us","in- ...","እን-"],["good (wish)","melkam","መልካም"]],"ex":[["if it rains, I will stay at home","zinab kezenebe bet iqoyalehu","","ዝናብ ከዘነበ ቤት እቆያለሁ"],["let us go","inihid","","እንሂድ"],["let me help","lirda","","ልርዳ"],["have a good trip","melkam guzo","","መልካም ጉዞ"],["I hope you get well","indishalih tesfa aderegalehu","","እንዲሻልህ ተስፋ አደርጋለሁ"],["if you want, come","kefelegih na","","ከፈለግህ ና"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":[],"rows":[],"ex":[["he is a teacher","isu astemari new","","እሱ አስተማሪ ነው"],["you (plural) are students","inante temariwoch nachihu","","እናንተ ተማሪዎች ናችሁ"],["I am happy","ene destegna negn","","እኔ ደስተኛ ነኝ"],["she is at school","iswa timihirt bet nat","","እሷ ትምህርት ቤት ናት"],["you are my friend","gwadegnaye neh","","ጓደኛዬ ነህ"],["it is cold","qezqaza new","","ቀዝቃዛ ነው"],["I study English","englizigna imaralehu","","እንግሊዝኛ እማራለሁ"],["he teaches maths","hisab yasetemral","","ሂሳብ ያስተምራል"],["they work every day","beyeqenu yiseralu","","በየቀኑ ይሰራሉ"],["is this your book?","yih yante mets'haf new?","","ይህ የአንተ መጽሐፍ ነው?"],["are they here?","izih nachew?","","እዚህ ናቸው?"],["do you like tea?","shay tiwedaleh?","","ሻይ ትወዳለህ?"],["what time is it?","se'at sint new?","","ሰዓት ስንት ነው?"],["whose book is this?","yih yeman mets'haf new?","","ይህ የማን መጽሐፍ ነው?"],["how old are you?","edmeh sint new?","","እድሜህ ስንት ነው?"],["how do you say it?","endet yibalal?","","እንዴት ይባላል?"],["your book (formal)","mets'hafwo","","መጽሐፍዎ"],["their house","betachew","","ቤታቸው"],["my phone","silke","","ስልኬ"],["excuse me, sir","yiqirta getaye","","ይቅርታ ጌታዬ"],["please sit down (formal)","ebakwo yiqemet'u","","እባክዎ ይቀመጡ"],["come here (informal)","izih na","","እዚህ ና"],["yesterday I was tired","tinant dekimogn neber","","ትናንት ደክሞኝ ነበር"],["I will study tomorrow","nege imaralehu","","ነገ እማራለሁ"],["we went to the park","wede menafesha hedin","","ወደ መናፈሻ ሄድን"]]}],"name":"Amharic","id":"am","flag":"et","script":"Ge'ez","note":""}