{"sounds":{"intro":"Ukrainian uses Cyrillic, but it differs from Russian in a few letters and sounds. Learn these first.","rows":[["і","ee, like \"see\"","ліс (lees)"],["и","\"ih\", like the \"i\" in \"bit\"","мир (mihr)"],["ї","yee","їжа (YEE-zhah)"],["є","ye, like \"yes\"","є (ye)"],["г","h, soft breathy (not \"g\")","гора (hoh-RAH)"],["ґ","g, hard, rare letter","ґанок (GAH-nok)"],["е","eh","мене (meh-NEH)"],["щ","shch","щастя (SHCHAHS-tyah)"],["ь","soft sign: softens the consonant before it","день (den')"],["'","apostrophe: hard break before я, ю, є, ї","м'ясо (MYAH-so)"],["ч","ch","час (chahs)"],["ж","zh","жінка (ZHEEN-kah)"],["в","v (at the end of a word or before a consonant it sounds close to \"w\")","вода (voh-DAH)"],["о","oh (unstressed it is still \"o\", not \"a\" as in Russian)","молоко (moh-loh-KOH)"]],"notes":[]},"numbers":[{"id":"0-to-10","title":"0 to 10","items":[["zero","нуль","nool'"],["one","один","oh-DEEN"],["two","два","dvah"],["three","три","trih"],["four","чотири","choh-TIH-rih"],["five","п'ять","pyaht'"],["six","шість","sheest'"],["seven","сім","seem"],["eight","вісім","VEE-seem"],["nine","дев'ять","DEH-vyaht'"],["ten","десять","DEH-syat'"]]},{"id":"11-to-20","title":"11 to 20","items":[["eleven","одинадцять","oh-dih-NAHD-tsyat'"],["twelve","дванадцять","dvah-NAHD-tsyat'"],["thirteen","тринадцять","trih-NAHD-tsyat'"],["fourteen","чотирнадцять","choh-tihr-NAHD-tsyat'"],["fifteen","п'ятнадцять","pyat-NAHD-tsyat'"],["sixteen","шістнадцять","sheest-NAHD-tsyat'"],["seventeen","сімнадцять","seem-NAHD-tsyat'"],["eighteen","вісімнадцять","vee-seem-NAHD-tsyat'"],["nineteen","дев'ятнадцять","deh-vyat-NAHD-tsyat'"],["twenty","двадцять","DVAHD-tsyat'"]]},{"id":"tens","title":"Tens","items":[["ten","десять","DEH-syat'"],["twenty","двадцять","DVAHD-tsyat'"],["thirty","тридцять","TRIHD-tsyat'"],["forty","сорок","SOH-rok"],["fifty","п'ятдесят","pyat-deh-SYAHT"],["sixty","шістдесят","sheest-deh-SYAHT"],["seventy","сімдесят","SEEM-deh-syat"],["eighty","вісімдесят","VEE-seem-deh-syat"],["ninety","дев'яносто","deh-vya-NOS-toh"],["twenty-one","двадцять один","DVAHD-tsyat' oh-DEEN"]]},{"id":"hundreds","title":"Hundreds","items":[["one hundred","сто","stoh"],["two hundred","двісті","DVEES-tee"],["three hundred","триста","TRIH-stah"],["four hundred","чотириста","choh-TIH-rih-stah"],["five hundred","п'ятсот","pyaht-SOT"],["six hundred","шістсот","sheest-SOT"],["seven hundred","сімсот","seem-SOT"],["eight hundred","вісімсот","VEE-seem-sot"],["nine hundred","дев'ятсот","deh-vyaht-SOT"]]},{"id":"thousands","title":"Thousands","items":[["one thousand","тисяча","TIH-syah-chah"],["two thousand","дві тисячі","dvee TIH-syah-chee"],["three thousand","три тисячі","trih TIH-syah-chee"],["four thousand","чотири тисячі","choh-TIH-rih TIH-syah-chee"],["five thousand","п'ять тисяч","pyaht' TIH-syach"],["six thousand","шість тисяч","sheest' TIH-syach"],["seven thousand","сім тисяч","seem TIH-syach"],["eight thousand","вісім тисяч","VEE-seem TIH-syach"],["nine thousand","дев'ять тисяч","DEH-vyaht' TIH-syach"]]},{"id":"big-numbers","title":"Big numbers","items":[["ten thousand","десять тисяч","DEH-syat' TIH-syach"],["one hundred thousand","сто тисяч","stoh TIH-syach"],["one million","мільйон","meel'-YON"],["one billion","мільярд","meel'-YARD"]]},{"id":"order-and-amounts","title":"Order and amounts","items":[["first","перший","PER-shihy"],["second","другий","DROO-gihy"],["third","третій","TREH-teey"],["half","половина","poh-loh-VIH-nah"],["a few","кілька","KEEL'-kah"],["many","багато","bah-HAH-toh"],["a pair","пара","PAH-rah"],["how many?","скільки?","SKEEL'-kih"]]}],"greetings":[{"id":"hello-and-goodbye","title":"Hello and goodbye","items":[["hello","привіт","prih-VEET"],["good day","добрий день","DOH-brihy den'"],["good morning","доброго ранку","DOH-broh-hoh RAHN-koo"],["good evening","добрий вечір","DOH-brihy VEH-cheer"],["good night","на добраніч","nah doh-BRAH-neech"],["goodbye","до побачення","doh poh-BAH-chen-nya"],["bye (informal)","бувай