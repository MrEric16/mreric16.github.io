head","pen","pen"],["face","wyneb","OO-in-eb"],["eye","llygad","HLUH-gad"],["ear","clust","kleest"],["nose","trwyn","troo-in"],["mouth","ceg","keg"],["tooth","dant","dant"],["hand","llaw","hlow"],["finger","bys","bees"],["arm","braich","brighkh"],["leg","coes","koys"],["foot","troed","troyd"],["heart","calon","KAL-on"],["stomach","stumog","STIM-og"],["back","cefn","kevn"],["hair","gwallt","gwahlt"]]},{"id":"home","title":"Home","items":[["house","tŷ","tee"],["room","ystafell","us-TAV-ehlh"],["door","drws","droos"],["window","ffenestr","fen-EST-r"],["table","bwrdd","boorth"],["chair","cadair","KAD-ire"],["bed","gwely","GOO-el-ee"],["kitchen","cegin","KEG-in"],["bathroom","ystafell ymolchi","us-TAV-ehlh um-OL-khee"],["garden","gardd","garth"],["roof","to","toh"],["floor","llawr","hlowr"],["wall","wal","wal"],["key","allwedd","AHLH-weth"],["lamp","lamp","lamp"],["television","teledu","tel-ED-ee"]]},{"id":"clothes","title":"Clothes","items":[["shirt","crys","krees"],["trousers","trowsus","TROW-sis"],["clothes","dillad","DIHLH-ad"],["coat","cot","kot"],["hat","het","het"],["umbrella","ymbarél","um-bar-EL"],["shoes","esgidiau","es-GID-yeye"],["socks","sanau","SAN-eye"],["jacket","siaced","SHAK-ed"],["scarf","sgarff","skarf"],["gloves","menig","MEN-ig"],["belt","gwregys","GOO-reg-is"]]},{"id":"town","title":"Town","items":[["city","dinas","DIN-as"],["street","stryd","streed"],["shop","siop","shop"],["market","marchnad","MARKH-nad"],["bank","banc","bank"],["hospital","ysbyty","us-BUT-ee"],["school","ysgol","US-gol"],["place of worship","capel","KAP-el"],["park","parc","park"],["station","gorsaf","GOR-sav"],["airport","maes awyr","mice OW-ir"],["bridge","pont","pont"],["restaurant","bwyty","BOOIT-ee"],["bus","bws","boos"],["metro","metro","MET-ro"],["square","sgwâr","skwahr"]]},{"id":"time","title":"Time","items":[["minute","munud","MIN-id"],["hour","awr","owr"],["day","diwrnod","DIU-rnod"],["week","wythnos","OOITH-nos"],["month","mis","mees"],["year","blwyddyn","BLOO-ith-in"],["morning","bore","BOR-eh"],["afternoon","prynhawn","prin-HOWN"],["evening","noson","NOS-on"],["night","nos","nohs"],["Monday","dydd Llun","deeth hleen"],["Tuesday","dydd Mawrth","deeth mowrth"],["Wednesday","dydd Mercher","deeth MER-kher"],["Thursday","dydd Iau","deeth yigh"],["Friday","dydd Gwener","deeth GWEN-er"],["Saturday","dydd Sadwrn","deeth SAD-oorn"],["Sunday","dydd Sul","deeth seel"]]},{"id":"weather-and-nature","title":"Weather and nature","items":[["sun","haul","hile"],["rain","glaw","glow"],["snow","eira","EYE-ra"],["wind","gwynt","gooint"],["cloud","cwmwl","KOO-mool"],["hot","poeth","poyth"],["cold","oer","oyr"],["tree","coeden","KOY-den"],["flower","blodyn","BLOD-in"],["mountain","mynydd","MUN-ith"],["river","afon","AV-on"],["sea","môr","mohr"],["sky","awyr","OW-ir"]]},{"id":"work-and-school","title":"Work and school","items":[["job","swydd","sooith"],["office","swyddfa","SOOITH-va"],["doctor","meddyg","METH-ig"],["engineer","peiriannydd","pay-ree-AN-ith"],["driver","gyrrwr","GUR-oor"],["worker","gweithiwr","GOOITH-yoor"],["boss","bòs","boss"],["salary","cyflog","KUV-log"],["meeting","cyfarfod","kuv-AR-vod"],["company","cwmni","KOOM-nee"],["lawyer","cyfreithiwr","kuv-RAY-thyoor"],["nurse","nyrs","neers"],["cook","cogydd","KOG-ith"],["farmer","ffermwr","FER-moor"]]},{"id":"describing","title":"Describing","items":[["big","mawr","mowr"],["small","bach","bakh"],["good","da","dah"],["bad","drwg","droog"],["new","newydd","NEW-ith"],["old","hen","hen"],["hot (temperature)","poeth","poyth"],["cold (temperature)","oer","oyr"],["fast","cyflym","KUV-lim"],["slow","araf","AR-av"],["easy","hawdd","howdh"],["difficult","anodd","AN-odh"],["beautiful","hardd","harth"],["ugly","hyll","hihlh"],["tall","tal","tal"],["short","byr","beer"],["heavy","trwm","troom"],["light (weight)","ysgafn","US-gavn"],["expensive","drud","drid"],["cheap","rhad","rhad"]]},{"id":"common-verbs","title":"Common verbs","items":[["to be","bod","bod"],["to ask","gofyn","GOV-in"],["to go","mynd","meend"],["to come","dod","dohd"],["to see","gweld","gooeld"],["to eat","bwyta","BOOIT-a"],["to drink","yfed","UV-ed"],["to sleep","cysgu","KUS-gee"],["to speak","siarad","SHAR-ad"],["to know","gwybod","GOO-ib-od"],["to want","eisiau","ICE-ya"],["to give","rhoi","rhoy"],["to take","cymryd","KUM-rid"],["to buy","prynu","PRUN-ee"],["to sell","gwerthu","GWER-thee"],["to read","darllen","DAR-hlen"],["to write","ysgrifennu","us-grif-EN-ee"],["to work","gweithio","GOOITH-yo"],["to live","byw","biw"],["to love","caru","KAR-ee"],["to like","hoffi","HOF-ee"],["to wait","aros","AR-os"],["to open","agor","AG-or"],["to close","cau","kigh"],["to say","dweud","dayd"]]},{"id":"school-subjects","title":"School subjects","items":[["maths","mathemateg","math-em-AT-eg"],["physics","ffiseg","FIS-eg"],["chemistry","cemeg","KEM-eg"],["biology","bioleg","bee-OL-eg"],["history","hanes","HAN-es"],["geography","daearyddiaeth","die-ar-UTH-yayth"],["literature","llenyddiaeth","hlen-UTH-yayth"],["English","Saesneg","SIGHS-neg"],["Welsh language","Cymraeg","kum-RIGH-g"],["Russian language","Rwsieg","ROO-see-eg"],["foreign languages","ieithoedd tramor","YAYTH-oyth TRAM-or"],["art","celf","kelv"],["music","cerddoriaeth","ker-thor-YATH"],["PE","addysg gorfforol","ADH-isg gor-FOR-ol"],["computer science","cyfrifiadureg","kuv-riv-yad-ER-eg"],["economics","economeg","ek-on-OM-eg"],["law","y gyfraith","uh GUV-righth"],["philosophy","athroniaeth","ath-RON-yayth"],["psychology","seicoleg","sike-OL-eg"],["science","gwyddoniaeth","gooith-ON-yayth"]]},{"id":"classroom","title":"Classroom","items":[["classroom","ystafell ddosbarth","us-TAV-ehlh THOS-barth"],["desk","desg","desk"],["board","bwrdd du","boorth dee"],["notebook","llyfr nodiadau","hlivr nod-YAD-eye"],["textbook","gwerslyfr","GWERS-livr"],["homework","gwaith cartref","gwith KAR-trev"],["test","prawf","prowv"],["grade","marc","mark"],["timetable","amserlen","AM-ser-len"],["break","egwyl","EG-ooil"],["bell","cloch","klokh"],["ruler","pren mesur","pren MES-ir"],["rubber","rwber","ROOB-er"],["rucksack","bag ysgol","bag US-gol"],["dictionary","geiriadur","gay-ree-AD-ir"],["question","cwestiwn","KWES-ti-oon"],["answer","ateb","AT-eb"],["mistake","camgymeriad","kam-guh-MER-yad"],["pen","beiro","BAY-ro"],["pencil","pensil","PEN-sil"]]},{"id":"university","title":"University","items":[["university","prifysgol","pree-VUS-gol"],["lecture","darlith","DAR-lith"],["professor","athro","ATH-ro"],["degree","gradd","grath"],["scholarship","ysgoloriaeth","us-gol-OR-yayth"],["library","llyfrgell","hluv-RGEHLH"],["dormitory","neuadd breswyl","NAY-ath BRES-ooil"],["campus","campws","KAM-poos"],["tuition fees","ffioedd dysgu","FYOYTH DUS-gee"],["semester","tymor","TUM-or"],["course","cwrs","koors"],["essay","traethawd","TRIGHTH-owd"],["thesis","traethawd hir","TRIGHTH-owd heer"],["diploma","tystysgrif","tus-TUS-grif"],["seminar","seminar","sem-IN-ar"],["entrance exam","arholiad mynediad","ar-HOL-yad mun-ED-yad"],["application","cais","kice"],["student card","cerdyn myfyriwr","KER-din muv-UH-ri-oor"],["faculty","cyfadran","kuv-AD-ran"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","astudio","as-TID-yo"],["to teach","dysgu","DUS-gee"],["to ask","gofyn","GOV-in"],["to answer","ateb","AT-eb"],["to repeat","ailadrodd","ile-a-DROTH"],["to understand","deall","DEH-ahlh"],["to remember","cofio","KOV-yo"],["to forget","anghofio","an-GOV-yo"],["to explain","egluro","eg-LIR-o"],["to practise","ymarfer","um-AR-ver"],["to pass an exam","pasio arholiad","PAS-yo ar-HOL-yad"],["to fail an exam","methu arholiad","METH-ee ar-HOL-yad"],["to write down","ysgrifennu i lawr","us-grif-EN-ee ee hlowr"],["to listen","gwrando","GWRAN-do"],["to read aloud","darllen yn uchel","DAR-hlen un EE-khel"],["to think","meddwl","METH-ool"],["to count","cyfrif","KUV-rif"],["to spell","sillafu","sihlh-AV-ee"],["to translate","cyfieithu","kuv-YAYTH-ee"],["to graduate","graddio","GRATH-yo"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Welsh has no he / she difference for verbs, but the pronoun does: \"e\" or \"fe\" (he) and \"hi\" (she). The little form \"ti\" is for friends, \"chi\" for strangers, elders and groups."],"rows":[["I","fi / i","vee / ee"],["you (informal)","ti","tee"],["he","e / fe","eh / veh"],["she","hi","hee"],["we","ni","nee"],["you (formal or plural)","chi","chee"],["they","nhw","nhoo"]],"ex":[["I am a student","dw i'n fyfyriwr","doo een vuh-VUH-ri-oor"],["you are tall","rwyt ti'n dal","ROO-it teen dal"],["she is my older sister","hi yw fy chwaer hŷn","hee yoo vuh chwire heen"],["we are friends","ffrindiau ydyn ni","FRIND-yeye UH-din nee"],["they are teachers","athrawon ydyn nhw","ath-ROW-on UH-din nhoo"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Many nouns add -au or -on: ci, cŵn (irregular), llyfr, llyfrau. After a number, the noun stays singular: dau lyfr (two book)."],"rows":[["book","llyfr","hluvr"],["books","llyfrau","HLUV-reye"],["house","tŷ","tee"],["houses","tai","tie"]],"ex":[["one house, houses","un tŷ, tai","een tee, tie"],["one book, books","un llyfr, llyfrau","een hluvr, HLUV-reye"],["one cat, cats","un gath, cathod","een gath, KATH-od"],["two books","dau lyfr","dai hluvr"],["the children","y plant","uh plant"]]},{"id":"to-be-bod","title":"To be: bod","text":["Welsh uses \"bod\" (to be). Present: dw i (I am), rwyt ti (you are), mae e / hi (he, she is), dyn ni (we are), dych chi (you are), maen nhw (they are). Before a noun, use \"yn\" or the word order of \"ydy\"."],"rows":[["I am","dw i","doo ee"],["you are","rwyt ti","ROO-it tee"],["he / she is","mae e / mae hi","mine eh / mine hee"],["we are","dyn ni","din nee"],["you are (formal)","dych chi","dikh chee"],["they are","maen nhw","mine nhoo"]],"ex":[["I am a student","dw i'n fyfyriwr","doo een vuh-VUH-ri-oor"],["you are tired","rwyt ti wedi blino","ROO-it tee WED-ee BLIN-oh"],["he is a doctor","meddyg yw e","METH-ig yoo eh"],["we are happy","dyn ni'n hapus","din neen HAP-is"],["they are at home","maen nhw gartref","mine nhoo GAR-trev"]]},{"id":"having-gan-gyda","title":"Having: gan, gyda","text":["Welsh says \"with me\": mae gen i (I have), mae gen ti (you have), mae ganddo fe (he has), mae ganddi hi (she has), mae gynnon ni (we have), mae gynnoch chi (you have), mae ganddyn nhw (they have)."],"rows":[["I have","mae gen i","mine gen ee"],["you have","mae gen ti","mine gen tee"],["he has","mae ganddo fe","mine GAN-tho veh"],["she has","mae ganddi hi","mine GAN-thee hee"],["I do not have","does dim ... gen i","doys dim ... gen ee"]],"ex":[["I have an older brother","mae gen i frawd hŷn","mine gen ee vrowd heen"],["I have a car","mae gen i gar","mine gen ee gar"],["I do not have time","does dim amser gen i","doys dim AM-ser gen ee"],["there is a problem","mae problem","mine PROB-lem"],["there is no water","does dim dŵr","doys dim door"]]},{"id":"present-tense","title":"Present tense","text":["Use \"bod\" + \"yn\" + the verb-noun. \"Dw i'n bwyta\" is I am eating (or I eat). The \"yn\" often joins the word before it: dw i'n, rwyt ti'n, mae e'n."],"rows":[["I eat","dw i'n bwyta","doo een BOOIT-a"],["you eat","rwyt ti'n bwyta","ROO-it teen BOOIT-a"],["he / she eats","mae e'n bwyta","mine eh'n BOOIT-a"],["we eat","dyn ni'n bwyta","din neen BOOIT-a"]],"ex":[["I am eating bread","dw i'n bwyta bara","doo een BOOIT-a BAR-ah"],["you are reading a book","rwyt ti'n darllen llyfr","ROO-it teen DAR-hlen hluvr"],["she works in a bank","mae hi'n gweithio mewn banc","mine heen GOOITH-yo mehwn bank"],["we drink tea","dyn ni'n yfed te","din neen UV-ed teh"],["they are sleeping","maen nhw'n cysgu","mine nhoon KUS-gee"]]},{"id":"basic-sentences","title":"Basic sentences","text":["The verb comes first. Welsh order is verb, subject, object. The adjective follows the noun."],"rows":[["I read a book","dw i'n darllen llyfr","doo een DAR-hlen hluvr"],["he drinks tea","mae e'n yfed te","mine eh'n UV-ed teh"],["a big house","tŷ mawr","tee mowr"],["a new car","car newydd","kar NEW-ith"]],"ex":[["I read a book","dw i'n darllen llyfr","doo een DAR-hlen hluvr"],["he drinks tea","mae e'n yfed te","mine eh'n UV-ed teh"],["we go to school","dyn ni'n mynd i'r ysgol","din neen meend eer US-gol"],["they eat bread","maen nhw'n bwyta bara","mine nhoon BOOIT-a BAR-ah"],["the teacher writes","mae'r athro'n ysgrifennu","mire ATH-ron us-grif-EN-ee"]]},{"id":"negation","title":"Negation","text":["In the present, \"dim\" follows the subject: dw i ddim yn gweld (I am not seeing). The \"dd\" is a mutation of \"dim\". In the past, use \"ches i ddim\" (I did not get)."],"rows":[["I do not go","dw i ddim yn mynd","doo ee thim un meend"],["you do not go","dwyt ti ddim yn mynd","DOO-it tee thim un meend"],["he / she does not go","dyw e ddim yn mynd","dew eh thim un meend"],["it is not good","dyw e ddim yn dda","dew eh thim un thah"]],"ex":[["I want","dw i eisiau","doo ee ICE-ya"],["I do not want","dw i ddim eisiau","doo ee thim ICE-ya"],["I speak English","dw i'n siarad Saesneg","doo een SHAR-ad SIGHS-neg"],["I do not speak English","dw i ddim yn siarad Saesneg","doo ee thim un SHAR-ad SIGHS-neg"],["I like it","dw i'n ei hoffi","doo een ay HOF-ee"],["I do not like it","dw i ddim yn ei hoffi","doo ee thim un ay HOF-ee"],["she is here","mae hi yma","mine hee UH-ma"],["she is not here","dyw hi ddim yma","dew hee thim UH-ma"],["I have a car","mae gen i gar","mine gen ee gar"],["I do not have a car","does dim car gen i","doys dim kar gen ee"],["I understand","dw i'n deall","doo een DEH-ahlh"],["I do not understand","dw i ddim yn deall","doo ee thim un DEH-ahlh"],["we are tired","dyn ni wedi blino","din nee WED-ee BLIN-oh"],["we are not tired","dyn ni ddim wedi blino","din nee thim WED-ee BLIN-oh"],["he works on Sundays","mae e'n gweithio ar ddydd Sul","mine eh'n GOOITH-yo ar theeth seel"],["he does not work on Sundays","dyw e ddim yn gweithio ar ddydd Sul","dew eh thim un GOOITH-yo ar theeth seel"]]},{"id":"asking-questions","title":"Asking questions","text":["Swap the order: put \"wyt\" or \"ydy\" first and add the subject. \"Wyt ti'n...\" = are you...? A short answer repeats the verb: \"Ydw\" (I am), \"Nac ydw\" (I am not)."],"rows":[["Do you go?","wyt ti'n mynd?","ooit teen meend"],["Is it good?","ydy e'n dda?","UH-dee eh'n thah"],["Is it right?","ydy hynny'n iawn?","UH-dee HUN-ee'n yown"]],"ex":[["is this your book?","ai dy lyfr di yw hwn?","ie duh hluvr dee yoo hoon"],["are they here?","ydyn nhw yma?","UH-din nhoo UH-ma"],["do you like tea?","wyt ti'n hoffi te?","ooit teen HOF-ee teh"],["is it cold?","ydy hi'n oer?","UH-dee hee'n oyr"],["do you speak English?","wyt ti'n siarad Saesneg?","ooit teen SHAR-ad SIGHS-neg"]]},{"id":"question-words","title":"Question words","text":["Question words come first."],"rows":[["who","pwy","pooi"],["what","beth","beth"],["where","ble","bleh"],["when","pryd","preed"],["why","pam","pam"],["how","sut","sit"],["how much","faint","vine-t"]],"ex":[["what is your name?","beth yw dy enw di?","beth yoo duh EN-oo dee"],["who is he?","pwy yw e?","pooi yoo eh"],["where do you live?","ble wyt ti'n byw?","bleh ooit teen biw"],["when is the lesson?","pryd mae'r wers?","preed mire wers"],["why are you late?","pam wyt ti'n hwyr?","pam ooit teen hooir"],["how much is it?","faint yw e?","vine-t yoo eh"],["which book?","pa lyfr?","pah hluvr"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["The possessive comes before the noun and changes its first letter: fy llyfr i (my book, with a nasal sound in speech), dy lyfr di (your book), ei lyfr e (his book), ei llyfr hi (her book)."],"rows":[["my book","fy llyfr i","vuh hluvr ee"],["your book","dy lyfr di","duh hluvr dee"],["his book","ei lyfr e","ay hluvr eh"],["her book","ei llyfr hi","ay hluvr hee"]],"ex":[["my phone","fy ffôn i","vuh fohn ee"],["your house (formal)","eich tŷ chi","ikh tee chee"],["his sister","ei chwaer e","ay chwire eh"],["I like music","dw i'n hoffi cerddoriaeth","doo een HOF-ee ker-thor-YATH"],["I love football","dw i wrth fy modd â phêl-droed","doo ee oorth vuh moth ah fayl-droyd"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["\"Ti\" is for friends and children. \"Chi\" is for strangers, older people and groups. The verb ending changes: wyt ti / ydych chi."],"rows":[["you (informal)","ti","tee"],["you (formal)","chi","chee"],["excuse me, sir","esgusodwch fi, syr","es-gis-OD-wookh vee, seer"]],"ex":[["how are you? (informal)","sut wyt ti?","sit ooit tee"],["how are you? (formal)","sut ydych chi?","sit UH-dikh chee"],["where are you going? (informal)","i ble wyt ti'n mynd?","ee bleh ooit teen meend"],["where are you going? (formal)","i ble ydych chi'n mynd?","ee bleh UH-dikh cheen meend"],["please sit down (formal)","eisteddwch, os gwelwch yn dda","ice-TETH-ookh, os GWEL-ookh un thah"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: add endings to the stem: es i (I went), est ti (you went), aeth e (he went). Future: bydda i + yn + the verb-noun: bydda i'n mynd (I will go)."],"rows":[["I went","es i","ehs ee"],["I ate","bwyteais i","BOO-it-ay-ees ee"],["I will go","bydda i'n mynd","BUH-tha een meend"],["I will go tomorrow","bydda i'n mynd yfory","BUH-tha een meend uh-VOR-ee"]],"ex":[["yesterday I was tired","ddoe, roeddwn i wedi blino","thoy, ROYTH-oon ee WED-ee BLIN-oh"],["I will study tomorrow","bydda i'n astudio yfory","BUH-tha een as-TID-yo uh-VOR-ee"],["we went to the park","aethon ni i'r parc","IGH-thon nee eer park"],["I saw him","gwelais i e","GOO-el-ice ee eh"],["she wrote a letter","ysgrifennodd hi lythyr","us-grif-EN-oth hee HLUTH-eer"]]},{"id":"commands","title":"Commands","text":["Use the stem for \"ti\": dere (come), arhosa (wait). Add -wch for \"chi\": dewch (come), arhoswch (wait). To forbid, use \"paid\" (ti) or \"peidiwch\" (chi) + \"â\" + the verb-noun."],"rows":[["come!","dere!","DEH-reh"],["come! (formal)","dewch!","DEH-ookh"],["wait!","arhosa!","ar-HOS-a"],["do not go","paid â mynd","pide ah meend"]],"ex":[["come here","dere yma","DEH-reh UH-ma"],["do not come here","paid â dod yma","pide ah dohd UH-ma"],["sit down","eistedd","ICE-teth"],["do not sit down","paid ag eistedd","pide ag ICE-teth"],["be quiet","bydd yn dawel","beeth un DAH-wel"],["do not be late","paid â bod yn hwyr","pide ah bod un hooir"],["open the door","agor y drws","AG-or uh droos"],["close the window","cau'r ffenestr","KIGH-r fen-EST-r"],["listen to me","gwranda arna i","GWRAN-da AR-na ee"],["do not worry","paid â phoeni","pide ah FOY-nee"],["speak slowly","siarada'n araf","shar-AD-an AR-av"],["wait a moment","arhosa funud","ar-HOS-a VIN-id"]]},{"id":"can-must-want","title":"Can, must, want","text":["\"Gallu\" (can): alla i (I can), alli di (you can). \"Mae'n rhaid i\" (must): mae'n rhaid i fi fynd. \"Eisiau\" (want): dw i eisiau mynd."],"rows":[["I can swim","alla i nofio","AHLH-a ee NOV-yo"],["I must go","mae'n rhaid i fi fynd","mine rhide ee vee veend"],["I want to go","dw i eisiau mynd","doo ee ICE-ya meend"],["may I?","ga i?","gah ee"]],"ex":[["I can swim","alla i nofio","AHLH-a ee NOV-yo"],["I cannot swim","alla i ddim nofio","AHLH-a ee thim NOV-yo"],["can you help me?","alli di fy helpu i?","AHLH-ee dee vuh HEL-pee ee"],["we must go","mae'n rhaid i ni fynd","mine rhide ee nee veend"],["we must not go","does dim hawl gyda ni i fynd","doys dim howl GUH-da nee ee veend"],["I want to eat","dw i eisiau bwyta","doo ee ICE-ya BOOIT-a"],["I do not want to eat","dw i ddim eisiau bwyta","doo ee thim ICE-ya BOOIT-a"],["you can come","gelli di ddod","GEHLH-ee dee thohd"],["you cannot come","allet ti ddim dod","AHLH-et tee thim dohd"],["she wants to study","mae hi eisiau astudio","mine hee ICE-ya as-TID-yo"],["I must work today","mae'n rhaid i fi weithio heddiw","mine rhide ee vee WEETH-yo HETH-yoo"],["you must not run","does dim hawl gyda ti i redeg","doys dim howl GUH-da tee ee RED-eg"]]},{"id":"in-on-at","title":"In, on, at","text":["Welsh uses short words before the place: \"yn\" (in), \"ar\" (on), \"wrth\" (at, by), \"o dan\" (under), \"wrth ymyl\" (next to), \"ger\" (near), \"i\" (to), \"o\" (from). Many make the next word change its first letter."],"rows":[["in the house","yn y tŷ","un uh tee"],["on the table","ar y bwrdd","ar uh boorth"],["under the table","o dan y bwrdd","oh dan uh boorth"],["at school","yn yr ysgol","un ur US-gol"]],"ex":[["the book is on the table","mae'r llyfr ar y bwrdd","mire hluvr ar uh boorth"],["the cat is under the table","mae'r gath o dan y bwrdd","mire gath oh dan uh boorth"],["I am at school","dw i yn yr ysgol","doo ee un ur US-gol"],["I am at home","dw i gartref","doo ee GAR-trev"],["the shop is next to the bank","mae'r siop wrth ymyl y banc","mire shop oorth UM-il uh bank"],["the park is near the station","mae'r parc ger yr orsaf","mire park ger ur OR-sav"],["we meet in the morning","dyn ni'n cwrdd yn y bore","din neen koordh un uh BOR-eh"],["the lesson is at nine","mae'r wers am naw o'r gloch","mire wers am now or glokh"],["the key is in the bag","mae'r allwedd yn y bag","mire AHLH-weth un uh bag"]]},{"id":"comparing-things","title":"Comparing things","text":["Add -ach for \"more\" and -af for \"the most\": mawr, mwy (irregular), mwyaf. Regular: cyflym, cyflymach, cyflymaf. \"Than\" is \"na\". \"As ... as\" is \"mor ... â\"."],"rows":[["big, bigger","mawr, mwy","mowr, mooee"],["good, better","da, gwell","dah, gwehlh"],["small, smaller","bach, llai","bakh, hlie"],["the biggest","y mwyaf","uh MOO-ee-av"]],"ex":[["big, bigger, the biggest","mawr, mwy, mwyaf","mowr, mooee, MOO-ee-av"],["small, smaller, the smallest","bach, llai, lleiaf","bakh, hlie, HLAY-av"],["this is better than that","mae hwn yn well na hwnna","mine hoon un wehlh nah HOON-a"],["this is worse than that","mae hwn yn waeth na hwnna","mine hoon un wighth nah HOON-a"],["she is taller than me","mae hi'n dalach na fi","mine heen DAL-akh nah vee"],["Tashkent is bigger than Samarkand","mae Tashkent yn fwy na Samarkand","mine tash-KENT un vooee nah sa-mar-KAND"],["it is the cheapest","hwn yw'r rhataf","hoon yoor RHAT-av"],["the same as","yr un fath â","ur een vath ah"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Quick sentences to copy and change."],"rows":[["I am hungry","dw i eisiau bwyd","doo ee ICE-ya booid"],["I am thirsty","dw i'n sychedig","doo een suh-KHED-ig"],["I am cold","dw i'n oer","doo een oyr"],["it is raining","mae hi'n bwrw glaw","mine heen BOO-roo glow"]],"ex":[["he is a teacher","athro yw e","ATH-ro yoo eh"],["you (plural) are students","myfyrwyr ydych chi","muv-UH-rooir UH-dikh chee"],["I am happy","dw i'n hapus","doo een HAP-is"],["she is at school","mae hi yn yr ysgol","mine hee un ur US-gol"],["you are my friend","ti yw fy ffrind","tee yoo vuh frind"],["it is cold","mae hi'n oer","mine heen oyr"],["I study English","dw i'n astudio Saesneg","doo een as-TID-yo SIGHS-neg"],["he teaches maths","mae e'n dysgu mathemateg","mine eh'n DUS-gee math-em-AT-eg"],["they work every day","maen nhw'n gweithio bob dydd","mine nhoon GOOITH-yo bohb deeth"],["is this your book?","ai dy lyfr di yw hwn?","ie duh hluvr dee yoo hoon"],["are they here?","ydyn nhw yma?","UH-din nhoo UH-ma"],["do you like tea?","wyt ti'n hoffi te?","ooit teen HOF-ee teh"],["what time is it?","faint o'r gloch yw hi?","vine-t or glokh yoo hee"],["whose book is this?","llyfr pwy yw hwn?","hluvr pooi yoo hoon"],["how old are you?","faint yw dy oed di?","vine-t yoo duh oid dee"],["how do you say it?","sut wyt ti'n ei ddweud e?","sit ooit teen ay thayd eh"],["your book (formal)","eich llyfr chi","ikh hluvr chee"],["their house","eu tŷ nhw","ay tee nhoo"],["my phone","fy ffôn i","vuh fohn ee"],["excuse me, sir","esgusodwch fi, syr","es-gis-OD-wookh vee, seer"],["please sit down (formal)","eisteddwch, os gwelwch yn dda","ice-TETH-ookh, os GWEL-ookh un thah"],["come here (informal)","dere yma","DEH-reh UH-ma"],["yesterday I was tired","ddoe, roeddwn i wedi blino","thoy, ROYTH-oon ee WED-ee BLIN-oh"],["I will study tomorrow","bydda i'n astudio yfory","BUH-tha een as-TID-yo uh-VOR-ee"],["we went to the park","aethon ni i'r parc","IGH-thon nee eer park"]]}],"name":"Welsh","id":"cy","flag":"wales","note":""}