"hah-tuhr-lah-MAHK"],["to forget","unutmak","oo-noot-MAHK"],["to explain","açıklamak","ah-chuhk-lah-MAHK"],["to practise","pratik yapmak","prah-TEEK yahp-MAHK"],["to pass an exam","sınavı geçmek","suh-nah-VUH gehch-MEHK"],["to fail an exam","sınavda kalmak","suh-nahv-DAH kahl-MAHK"],["to write down","not almak","noht ahl-MAHK"],["to listen","dinlemek","deen-leh-MEHK"],["to read aloud","yüksek sesle okumak","yewk-SEHK sehs-LEH oh-koo-MAHK"],["to think","düşünmek","dew-shewn-MEHK"],["to count","saymak","sahy-MAHK"],["to spell","hecelemek","heh-jeh-leh-MEHK"],["to translate","çevirmek","cheh-veer-MEHK"],["to graduate","mezun olmak","meh-ZOON ohl-MAHK"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Turkish drops the pronoun most of the time, because the verb ending shows who is speaking. Pronouns are for emphasis."],"rows":[["I","ben","ben"],["you (informal)","sen","sen"],["he / she / it","o","oh"],["we","biz","beez"],["you all / you (formal)","siz","seez"],["they","onlar","on-LAR"]],"ex":[["I am a student","ben öğrenciyim","ben uh-ren-jee-YEEM"],["you are tall","sen uzunsun","sen oo-zoon-SOON"],["she is my sister","o benim kız kardeşim","oh beh-NEEM kuhz kar-deh-SHEEM"],["we are friends","biz arkadaşız","beez ar-kah-dah-SUHZ"],["they are teachers","onlar öğretmen","on-LAR uh-ret-MEN"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Add -ler or -lar. Use -ler after e, i, ö, ü, and -lar after a, ı, o, u (vowel harmony). After a number, the noun stays singular: iki kitap (two book)."],"rows":[["ev (house)","evler","ev-LER"],["kitap (book)","kitaplar","kee-tahp-LAR"],["göz (eye)","gözler","gurz-LER"],["after a number: singular","iki kitap","ee-KEE kee-TAHP"]],"ex":[["one house, houses","bir ev, evler","beer ev ev-LER"],["one book, books","bir kitap, kitaplar","beer kee-TAHP kee-tahp-LAR"],["one cat, cats","bir kedi, kediler","beer keh-DEE keh-dee-LER"],["two books","iki kitap","ee-KEE kee-TAHP"],["the children","çocuklar","choh-jook-LAR"]]},{"id":"to-be-im-sin-dir","title":"To be: -im, -sin, -dir","text":["There is no separate verb \"to be\". Add an ending to the noun or adjective. After a vowel, a buffer y appears."],"rows":[["I am","-im / -ım / -um / -üm","eem"],["you are","-sin / -sın / -sun / -sün","seen"],["he / she is","(no ending) or -dir","deer"],["we are","-iz / -ız / -uz / -üz","eez"],["you all are","-siniz","see-NEEZ"],["they are","-ler / -lar","ler"]],"ex":[["I am a student","öğrenciyim","uh-ren-jee-YEEM"],["you are tired","yorgunsun","yor-goon-SOON"],["he is a doctor","o doktor","oh dok-TOR"],["we are happy","mutluyuz","moot-loo-YOOZ"],["they are at home","onlar evde","on-LAR ev-DEH"]]},{"id":"var-and-yok-have-there-is","title":"Var and yok: have, there is","text":["Turkish says \"my X exists\" (var) or \"my X does not exist\" (yok). Ending shows the owner: -im (my), -in (your), -i (his)."],"rows":[["there is","var","var"],["there is not","yok","yok"],["I have","... -im var","var"],["I do not have","... -im yok","yok"]],"ex":[["I have a brother","erkek kardeşim var","er-KEK kar-deh-SHEEM var"],["I have a car","arabam var","ah-rah-BAHM var"],["I do not have time","zamanım yok","zah-mah-NUHM yok"],["there is a problem","bir sorun var","beer soh-ROON var"],["there is no water","su yok","soo yok"]]},{"id":"present-tense-iyor","title":"Present tense: -iyor","text":["Verb stem + -iyor + person ending. Gelmek (to come): gel-iyor-um."],"rows":[["I come","geliyorum","geh-lee-yoh-ROOM"],["you come","geliyorsun","geh-lee-yor-SOON"],["he / she comes","geliyor","geh-lee-YOR"],["we come","geliyoruz","geh-lee-yoh-ROOZ"],["you all come","geliyorsunuz","geh-lee-yor-soo-NOOZ"],["they come","geliyorlar","geh-lee-yor-LAR"]],"ex":[["I am eating bread","ekmek yiyorum","ek-MEK yee-yoh-ROOM"],["you are reading a book","kitap okuyorsun","kee-TAHP oh-koo-yor-SOON"],["she works in a bank","bankada çalışıyor","bahn-kah-DAH chah-luh-shuh-YOR"],["we are going home","eve gidiyoruz","eh-VEH gee-dee-yoh-ROOZ"],["they are drinking tea","çay içiyorlar","chye ee-chee-yor-LAR"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Verb comes last. Order: subject, time, place, object, verb. Adjectives come before the noun."],"rows":[["subject + object + verb","Ben ekmek yiyorum.","ben ek-MEK yee-yoh-ROOM"],["adjective before noun","büyük ev","bew-YEWK ev"],["time and place first","Bugün okulda çalışıyorum.","boo-GEWN oh-kool-DAH chah-luh-shuh-yoh-ROOM"]],"ex":[["I eat bread","ekmek yiyorum","ek-MEK yee-yoh-ROOM"],["Ali reads a book","Ali kitap okuyor","AH-lee kee-TAHP oh-koo-YOR"],["we live in a big house","büyük bir evde yaşıyoruz","bew-YEWK beer ev-DEH yah-shuh-yoh-ROOZ"],["he works here today","bugün burada çalışıyor","boo-GEWN boo-rah-DAH chah-luh-shuh-YOR"],["the dog is black","köpek siyah","kur-PEK see-YAH"]]},{"id":"negation","title":"Negation","text":["Verbs: add -ma / -me after the stem. Nouns and adjectives: değil (is not). Var → yok.","Add -me / -ma before the tense ending: gelmiyorum (I am not coming). Var / yok: \"there is / there is not\". Değil = is not (for nouns and adjectives): ben öğrenci değilim."],"rows":[["not (verb)","-ma / -me","mah / meh"],["is not","değil","deh-EEL"],["there is not","yok","yok"],["nothing","hiçbir şey","heech-BEER shay"],["never","asla / hiç","AHS-lah / heech"],["verb + -me / -ma","gelmiyorum","gehl-mee-yoh-ROOM"],["there is not","yok","yohk"],["is not","değil","deh-EEL"],["nothing","hiçbir şey","heech-BEER shehy"],["never","asla / hiçbir zaman","AHS-lah"]],"ex":[["I want","istiyorum","ees-tee-yoh-ROOM"],["I do not want","istemiyorum","ees-teh-mee-yoh-ROOM"],["I speak English","İngilizce konuşuyorum","een-gee-leez-JEH koh-noo-shoo-yoh-ROOM"],["I do not speak English","İngilizce konuşmuyorum","een-gee-leez-JEH koh-noosh-moo-yoh-ROOM"],["I like it","beğeniyorum","beh-eh-nee-yoh-ROOM"],["I do not like it","beğenmiyorum","beh-ehn-mee-yoh-ROOM"],["she is here","o burada","oh boo-rah-DAH"],["she is not here","o burada değil","oh boo-rah-DAH deh-EEL"],["I have a car","arabam var","ah-rah-BAHM vahr"],["I do not have a car","arabam yok","ah-rah-BAHM yohk"],["I understand","anlıyorum","ahn-luh-yoh-ROOM"],["I do not understand","anlamıyorum","ahn-lah-muh-yoh-ROOM"],["we are tired","yorgunuz","yohr-goo-NOOZ"],["we are not tired","yorgun değiliz","yohr-GOON deh-ee-LEEZ"],["he works on Sundays","pazar günleri çalışıyor","pah-ZAHR gewn-leh-REE chah-luh-shuh-YOHR"],["he does not work on Sundays","pazar günleri çalışmıyor","pah-ZAHR gewn-leh-REE chah-luhsh-muh-YOHR"]]},{"id":"asking-questions","title":"Asking questions","text":["Add the little word mi / mı / mu / mü after the word you ask about. It follows vowel harmony. No change of word order."],"rows":[["statement","Türkçe konuşuyorsun.","tewrk-CHEH koh-noo-shoo-yor-SOON"],["question","Türkçe konuşuyor musun?","tewrk-CHEH koh-noo-shoo-YOR moo-SOON"],["after a noun or adjective","pahalı mı?","pah-hah-LUH muh"]],"ex":[["do you speak English?","İngilizce konuşuyor musun?","een-gee-leez-JEH koh-noo-shoo-YOR moo-SOON"],["is she a doctor?","o doktor mu?","oh dok-TOR moo"],["do you have a pen?","kalemin var mı?","kah-leh-MEEN var muh"],["are you tired?","yorgun musun?","yor-GOON moo-SOON"],["is it far?","uzak mı?","oo-ZAHK muh"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["what","ne","neh"],["who","kim","keem"],["where","nerede","neh-reh-DEH"],["when","ne zaman","neh zah-MAHN"],["why","neden","neh-DEN"],["how","nasıl","nah-SUHL"],["which","hangi","hahn-GEE"],["how much","ne kadar","neh kah-DAR"],["how many","kaç","kach"]],"ex":[["what is this?","bu nedir?","boo neh-DEER"],["who is she?","o kim?","oh keem"],["where do you live?","nerede yaşıyorsun?","neh-reh-DEH yah-shuh-yor-SOON"],["when is the exam?","sınav ne zaman?","suh-NAHV neh zah-MAHN"],["why are you late?","neden geç kaldın?","neh-DEN gech kahl-DUHN"],["how much is it?","ne kadar?","neh kah-DAR"]]},{"id":"possessives","title":"Possessives","text":["Add an ending to the noun: -im (my), -in (your), -i (his / her), -imiz (our), -iniz (your pl.), -leri (their). Vowel harmony changes the vowel."],"rows":[["my","-im / -ım / -um / -üm","eem"],["your","-in / -ın / -un / -ün","een"],["his / her","-i / -ı / -u / -ü","ee"],["our","-imiz / -ımız","ee-meez"]],"ex":[["my house","evim","eh-VEEM"],["your friends","arkadaşların","ar-kah-dahsh-lah-RUHN"],["his sister","kız kardeşi","kuhz kar-deh-SHEE"],["our teacher","öğretmenimiz","uh-ret-meh-nee-MEEZ"],["my mother","annem","AHN-nem"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["sen (and -sin, -im) for friends. siz (and -siniz) for strangers, older people, and groups. Add -ler or \"Bey\" (Mr) / \"Hanım\" (Mrs) after names for respect."],"rows":[["you, informal","sen","sen"],["you, formal","siz","seez"],["Mr","Bey (after the name)","bay"],["Mrs / Ms","Hanım (after the name)","hah-NUHM"]],"ex":[["you speak (informal)","konuşuyorsun","koh-noo-shoo-yor-SOON"],["you speak (formal)","konuşuyorsunuz","koh-noo-shoo-yor-soo-NOOZ"],["how are you? (informal)","nasılsın?","nah-suhl-SUHN"],["how are you? (formal)","nasılsınız?","nah-suhl-suh-NUHZ"],["thank you, Mr Ali","teşekkürler Ali Bey","tesh-ek-kewr-LER ah-LEE bay"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: stem + -di + person ending (-m, -n, -, -k, -niz, -ler). Future: stem + -ecek / -acak + person ending."],"rows":[["I went","gittim","geet-TEEM"],["you went","gittin","geet-TEEN"],["he / she went","gitti","geet-TEE"],["I will go","gideceğim","gee-deh-jeh-EEM"],["we will go","gideceğiz","gee-deh-jeh-EEZ"]],"ex":[["yesterday I worked","dün çalıştım","dewn chah-luhsh-TUHM"],["she bought a book","bir kitap aldı","beer kee-TAHP ahl-DUH"],["I went home","eve gittim","eh-VEH geet-TEEM"],["I will call you tomorrow","yarın seni arayacağım","yah-RUHN seh-NEE ah-rah-yah-jah-UHM"],["we will eat at eight","saat sekizde yiyeceğiz","sah-AHT seh-keez-DEH yee-yeh-jeh-EEZ"]]},{"id":"commands","title":"Commands","text":["The informal command is the plain stem: gel! (come), otur! (sit). Polite / plural: stem + -in / -ın / -un / -ün: gelin, oturun. Negative: add -me / -ma: gelme! (do not come)."],"rows":[["come!","gel!","gehl"],["come! (polite)","gelin!","geh-LEEN"],["do not come!","gelme!","gehl-MEH"]],"ex":[["come here","buraya gel","boo-rah-YAH gehl"],["do not come here","buraya gelme","boo-rah-YAH gehl-MEH"],["sit down","otur","oh-TOOR"],["do not sit down","oturma","oh-toor-MAH"],["be quiet","sessiz ol","sehs-SEEZ ohl"],["do not be late","geç kalma","gehch kahl-MAH"],["open the door","kapıyı aç","kah-puh-YUH ahch"],["close the window","pencereyi kapat","pehn-jeh-reh-YEE kah-PAHT"],["listen to me","beni dinle","beh-NEE deen-LEH"],["do not worry","endişelenme","ehn-dee-sheh-lehn-MEH"],["speak slowly","yavaş konuş","yah-VAHSH koh-NOOSH"],["wait a moment","bir dakika bekle","beer dah-kee-KAH behk-LEH"]]},{"id":"can-must-want","title":"Can, must, want","text":["-ebilmek = can (yüzebilirim), -meli = must (gitmeliyim), istemek = want (yemek istiyorum). Cannot = -ememek (yüzemem). Must not = -memeli (gitmemeliyim)."],"rows":[["I can swim","yüzebilirim","yew-zeh-bee-lee-REEM"],["I must go","gitmeliyim","geet-meh-lee-YEEM"],["I want to eat","yemek istiyorum","yeh-MEHK ees-tee-yoh-ROOM"]],"ex":[["I can swim","yüzebilirim","yew-zeh-bee-lee-REEM"],["I cannot swim","yüzemem","yew-zeh-MEHM"],["can you help me?","bana yardım edebilir misin?","bah-NAH yahr-DUHM eh-deh-bee-LEER mee-SEEN"],["we must go","gitmeliyiz","geet-meh-lee-YEEZ"],["we must not go","gitmemeliyiz","geet-meh-meh-lee-YEEZ"],["I want to eat","yemek istiyorum","yeh-MEHK ees-tee-yoh-ROOM"],["I do not want to eat","yemek istemiyorum","yeh-MEHK ees-teh-mee-yoh-ROOM"],["you can come","gelebilirsin","geh-leh-bee-leer-SEEN"],["you cannot come","gelemezsin","geh-leh-mehz-SEEN"],["she wants to study","o ders çalışmak istiyor","oh dehrs chah-luhsh-MAHK ees-tee-YOHR"],["I must work today","bugün çalışmalıyım","boo-GEWN chah-luhsh-mah-luh-YUHM"],["you must not run","koşmamalısın","kohsh-mah-mah-luh-SUHN"]]},{"id":"in-on-at","title":"In, on, at","text":["Turkish uses endings after the noun: -de / -da = in / at / on (okulda), -e / -a = to (okula), -den / -dan = from. Words like üstünde (on top of), altında (under), yanında (next to), yakınında (near) go after the noun."],"rows":[["in / at / on","-de / -da","deh / dah"],["on top of","üstünde","ew-stewn-DEH"],["under","altında","ahl-tuhn-DAH"],["next to","yanında","yah-nuhn-DAH"]],"ex":[["the book is on the table","kitap masanın üstünde","kee-TAHP mah-sah-NUHN ew-stewn-DEH"],["the cat is under the table","kedi masanın altında","keh-DEE mah-sah-NUHN ahl-tuhn-DAH"],["I am at school","okuldayım","oh-kool-dah-YUHM"],["I am at home","evdeyim","ehv-deh-YEEM"],["the shop is next to the bank","mağaza bankanın yanında","mah-ah-ZAH bahn-kah-NUHN yah-nuhn-DAH"],["the park is near the station","park istasyonun yakınında","pahrk ees-tahs-yoh-noon yah-kuh-nuhn-DAH"],["we meet in the morning","sabah buluşuyoruz","sah-BAHH boo-loo-shoo-yoh-ROOZ"],["the lesson is at nine","ders dokuzda","dehrs doh-kooz-DAH"],["the key is in the bag","anahtar çantada","ah-nah-TAHR chahn-tah-DAH"]]},{"id":"comparing-things","title":"Comparing things","text":["daha + adjective = more (daha büyük). en + adjective = the most (en büyük). \"than\" is shown by -den / -dan on the second thing: benden uzun (taller than me)."],"rows":[["bigger","daha büyük","dah-HAH bew-YEWK"],["the biggest","en büyük","ehn bew-YEWK"],["than me","benden","behn-DEHN"]],"ex":[["big, bigger, the biggest","büyük, daha büyük, en büyük","bew-YEWK dah-HAH bew-YEWK ehn bew-YEWK"],["small, smaller, the smallest","küçük, daha küçük, en küçük","kew-CHEWK dah-HAH kew-CHEWK ehn kew-CHEWK"],["this is better than that","bu şundan daha iyi","boo shoon-DAHN dah-HAH ee-YEE"],["this is worse than that","bu şundan daha kötü","boo shoon-DAHN dah-HAH kuh-TEW"],["she is taller than me","o benden daha uzun","oh behn-DEHN dah-HAH oo-ZOON"],["Tashkent is bigger than Samarkand","Taşkent Semerkant'tan daha büyük","tahsh-KEHNT seh-mehr-KAHN-tahn dah-HAH bew-YEWK"],["it is the cheapest","en ucuzu bu","ehn oo-joo-ZOO boo"],["the same as","... ile aynı","eeh-LEH ahy-NUH"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Extra practice with the most useful patterns."],"rows":[],"ex":[["he is a teacher","o öğretmen","oh uh-reht-MEHN"],["you (plural) are students","siz öğrencisiniz","seez uh-rehn-jee-see-NEEZ"],["I am happy","mutluyum","moot-loo-YOOM"],["she is at school","o okulda","oh oh-kool-DAH"],["you are my friend","sen benim arkadaşımsın","sehn beh-NEEM ahr-kah-dah-shuhm-SUHN"],["it is cold","hava soğuk","hah-VAH soh-OOK"],["I study English","İngilizce çalışıyorum","een-gee-leez-JEH chah-luh-shuh-yoh-ROOM"],["he teaches maths","o matematik öğretiyor","oh mah-teh-mah-TEEK uh-reh-tee-YOHR"],["they work every day","onlar her gün çalışıyor","ohn-LAHR hehr gewn chah-luh-shuh-YOHR"],["is this your book?","bu senin kitabın mı?","boo seh-NEEN kee-tah-BUHN muh"],["are they here?","onlar burada mı?","ohn-LAHR boo-rah-DAH muh"],["do you like tea?","çayı sever misin?","chah-YUH seh-VEHR mee-SEEN"],["what time is it?","saat kaç?","sah-AHT kahch"],["whose book is this?","bu kimin kitabı?","boo kee-MEEN kee-tah-BUH"],["how old are you?","kaç yaşındasın?","kahch yah-shuhn-dah-SUHN"],["how do you say it?","bunu nasıl söylersin?","boo-NOO nah-SUHL suhy-lehr-SEEN"],["your book (formal)","kitabınız","kee-tah-buh-NUHZ"],["their house","onların evi","ohn-lah-RUHN eh-VEE"],["my phone","telefonum","teh-leh-foh-NOOM"],["excuse me, sir","affedersiniz, efendim","ahf-feh-DEHR-see-neez eh-fehn-DEEM"],["please sit down (formal)","lütfen oturun","lewt-FEHN oh-too-ROON"],["come here (informal)","buraya gel","boo-rah-YAH gehl"],["yesterday I was tired","dün yorgundum","dewn yohr-goon-DOOM"],["I will study tomorrow","yarın ders çalışacağım","yah-RUHN dehrs chah-luh-shah-jah-UHM"],["we went to the park","parka gittik","pahr-KAH geet-TEEK"]]}],"name":"Turkish","id":"tr","flag":"tr","note":""}