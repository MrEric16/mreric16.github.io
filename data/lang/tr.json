r","çiçek","chee-CHEK"],["sky","gökyüzü","gurk-yew-ZEW"]]},{"id":"work-and-school","title":"Work and school","items":[["teacher","öğretmen","uh-ret-MEN"],["student","öğrenci","uh-ren-JEE"],["book","kitap","kee-TAHP"],["pen","kalem","kah-LEM"],["pencil","kurşun kalem","koor-SHOON kah-LEM"],["paper","kağıt","kah-UHT"],["computer","bilgisayar","beel-gee-sah-YAR"],["phone","telefon","teh-leh-FON"],["work","iş","eesh"],["office","ofis","oh-FEES"],["doctor","doktor","dok-TOR"],["police officer","polis","poh-LEES"],["lesson","ders","ders"],["exam","sınav","suh-NAHV"]]},{"id":"describing","title":"Describing","items":[["big","büyük","bew-YEWK"],["small","küçük","kew-CHEWK"],["good","iyi","ee-YEE"],["bad","kötü","kur-TEW"],["new","yeni","yeh-NEE"],["old","eski","es-KEE"],["beautiful","güzel","gew-ZEL"],["ugly","çirkin","cheer-KEEN"],["fast","hızlı","huhz-LUH"],["slow","yavaş","yah-VAHSH"],["easy","kolay","koh-LYE"],["difficult","zor","zor"],["cheap","ucuz","oo-JOOZ"],["expensive","pahalı","pah-hah-LUH"],["clean","temiz","teh-MEEZ"],["dirty","kirli","keer-LEE"]]},{"id":"common-verbs","title":"Common verbs","items":[["to be (with suffixes)","olmak","ol-MAHK"],["to have (var = there is)","var","var"],["to go","gitmek","geet-MEK"],["to want","istemek","ees-teh-MEK"],["to eat","yemek","yeh-MEK"],["to drink","içmek","eech-MEK"],["to speak","konuşmak","koh-noosh-MAHK"],["to see","görmek","gur-MEK"],["to come","gelmek","gel-MEK"],["to give","vermek","ver-MEK"],["to know","bilmek","beel-MEK"],["to do / make","yapmak","yahp-MAHK"],["to say","demek","deh-MEK"],["to like","sevmek","sev-MEK"],["to live","yaşamak","yah-shah-MAHK"],["to work","çalışmak","chah-luhsh-MAHK"],["to buy","satın almak","sah-TUHN ahl-MAHK"],["to read","okumak","oh-koo-MAHK"],["to write","yazmak","yahz-MAHK"],["to sleep","uyumak","oo-yoo-MAHK"],["to learn","öğrenmek","uh-ren-MEK"],["to help","yardım etmek","yar-DUHM et-MEK"],["to need","ihtiyacı olmak","eeh-tee-yah-JUH ol-MAHK"],["to love","sevmek","sev-MEK"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Turkish drops the pronoun most of the time, because the verb ending shows who is speaking. Pronouns are for emphasis."],"rows":[["I","ben","ben"],["you (informal)","sen","sen"],["he / she / it","o","oh"],["we","biz","beez"],["you all / you (formal)","siz","seez"],["they","onlar","on-LAR"]],"ex":[["I am a student","ben öğrenciyim","ben uh-ren-jee-YEEM"],["you are tall","sen uzunsun","sen oo-zoon-SOON"],["she is my sister","o benim kız kardeşim","oh beh-NEEM kuhz kar-deh-SHEEM"],["we are friends","biz arkadaşız","beez ar-kah-dah-SUHZ"],["they are teachers","onlar öğretmen","on-LAR uh-ret-MEN"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Add -ler or -lar. Use -ler after e, i, ö, ü, and -lar after a, ı, o, u (vowel harmony). After a number, the noun stays singular: iki kitap (two book)."],"rows":[["ev (house)","evler","ev-LER"],["kitap (book)","kitaplar","kee-tahp-LAR"],["göz (eye)","gözler","gurz-LER"],["after a number: singular","iki kitap","ee-KEE kee-TAHP"]],"ex":[["one house, houses","bir ev, evler","beer ev ev-LER"],["one book, books","bir kitap, kitaplar","beer kee-TAHP kee-tahp-LAR"],["one cat, cats","bir kedi, kediler","beer keh-DEE keh-dee-LER"],["two books","iki kitap","ee-KEE kee-TAHP"],["the children","çocuklar","choh-jook-LAR"]]},{"id":"to-be-im-sin-dir","title":"To be: -im, -sin, -dir","text":["There is no separate verb \"to be\". Add an ending to the noun or adjective. After a vowel, a buffer y appears."],"rows":[["I am","-im / -ım / -um / -üm","eem"],["you are","-sin / -sın / -sun / -sün","seen"],["he / she is","(no ending) or -dir","deer"],["we are","-iz / -ız / -uz / -üz","eez"],["you all are","-siniz","see-NEEZ"],["they are","-ler / -lar","ler"]],"ex":[["I am a student","öğrenciyim","uh-ren-jee-YEEM"],["you are tired","yorgunsun","yor-goon-SOON"],["he is a doctor","o doktor","oh dok-TOR"],["we are happy","mutluyuz","moot-loo-YOOZ"],["they are at home","onlar evde","on-LAR ev-DEH"]]},{"id":"var-and-yok-have-there-is","title":"Var and yok: have, there is","text":["Turkish says \"my X exists\" (var) or \"my X does not exist\" (yok). Ending shows the owner: -im (my), -in (your), -i (his)."],"rows":[["there is","var","var"],["there is not","yok","yok"],["I have","... -im var","var"],["I do not have","... -im yok","yok"]],"ex":[["I have a brother","erkek kardeşim var","er-KEK kar-deh-SHEEM var"],["I have a car","arabam var","ah-rah-BAHM var"],["I do not have time","zamanım yok","zah-mah-NUHM yok"],["there is a problem","bir sorun var","beer soh-ROON var"],["there is no water","su yok","soo yok"]]},{"id":"present-tense-iyor","title":"Present tense: -iyor","text":["Verb stem + -iyor + person ending. Gelmek (to come): gel-iyor-um."],"rows":[["I come","geliyorum","geh-lee-yoh-ROOM"],["you come","geliyorsun","geh-lee-yor-SOON"],["he / she comes","geliyor","geh-lee-YOR"],["we come","geliyoruz","geh-lee-yoh-ROOZ"],["you all come","geliyorsunuz","geh-lee-yor-soo-NOOZ"],["they come","geliyorlar","geh-lee-yor-LAR"]],"ex":[["I am eating bread","ekmek yiyorum","ek-MEK yee-yoh-ROOM"],["you are reading a book","kitap okuyorsun","kee-TAHP oh-koo-yor-SOON"],["she works in a bank","bankada çalışıyor","bahn-kah-DAH chah-luh-shuh-YOR"],["we are going home","eve gidiyoruz","eh-VEH gee-dee-yoh-ROOZ"],["they are drinking tea","çay içiyorlar","chye ee-chee-yor-LAR"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Verb comes last. Order: subject, time, place, object, verb. Adjectives come before the noun."],"rows":[["subject + object + verb","Ben ekmek yiyorum.","ben ek-MEK yee-yoh-ROOM"],["adjective before noun","büyük ev","bew-YEWK ev"],["time and place first","Bugün okulda çalışıyorum.","boo-GEWN oh-kool-DAH chah-luh-shuh-yoh-ROOM"]],"ex":[["I eat bread","ekmek yiyorum","ek-MEK yee-yoh-ROOM"],["Ali reads a book","Ali kitap okuyor","AH-lee kee-TAHP oh-koo-YOR"],["we live in a big house","büyük bir evde yaşıyoruz","bew-YEWK beer ev-DEH yah-shuh-yoh-ROOZ"],["he works here today","bugün burada çalışıyor","boo-GEWN boo-rah-DAH chah-luh-shuh-YOR"],["the dog is black","köpek siyah","kur-PEK see-YAH"]]},{"id":"negation","title":"Negation","text":["Verbs: add -ma / -me after the stem. Nouns and adjectives: değil (is not). Var → yok."],"rows":[["not (verb)","-ma / -me","mah / meh"],["is not","değil","deh-EEL"],["there is not","yok","yok"],["nothing","hiçbir şey","heech-BEER shay"],["never","asla / hiç","AHS-lah / heech"]],"ex":[["I do not speak French","Fransızca konuşmuyorum","frahn-suhz-JAH koh-noosh-moo-yoh-ROOM"],["I am not tired","yorgun değilim","yor-GOON deh-ee-LEEM"],["she does not live here","burada yaşamıyor","boo-rah-DAH yah-shah-muh-YOR"],["I do not want anything","hiçbir şey istemiyorum","heech-BEER shay ees-teh-mee-yoh-ROOM"],["it is not expensive","pahalı değil","pah-hah-LUH deh-EEL"]]},{"id":"asking-questions","title":"Asking questions","text":["Add the little word mi / mı / mu / mü after the word you ask about. It follows vowel harmony. No change of word order."],"rows":[["statement","Türkçe konuşuyorsun.","tewrk-CHEH koh-noo-shoo-yor-SOON"],["question","Türkçe konuşuyor musun?","tewrk-CHEH koh-noo-shoo-YOR moo-SOON"],["after a noun or adjective","pahalı mı?","pah-hah-LUH muh"]],"ex":[["do you speak English?","İngilizce konuşuyor musun?","een-gee-leez-JEH koh-noo-shoo-YOR moo-SOON"],["is she a doctor?","o doktor mu?","oh dok-TOR moo"],["do you have a pen?","kalemin var mı?","kah-leh-MEEN var muh"],["are you tired?","yorgun musun?","yor-GOON moo-SOON"],["is it far?","uzak mı?","oo-ZAHK muh"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["what","ne","neh"],["who","kim","keem"],["where","nerede","neh-reh-DEH"],["when","ne zaman","neh zah-MAHN"],["why","neden","neh-DEN"],["how","nasıl","nah-SUHL"],["which","hangi","hahn-GEE"],["how much","ne kadar","neh kah-DAR"],["how many","kaç","kach"]],"ex":[["what is this?","bu nedir?","boo neh-DEER"],["who is she?","o kim?","oh keem"],["where do you live?","nerede yaşıyorsun?","neh-reh-DEH yah-shuh-yor-SOON"],["when is the exam?","sınav ne zaman?","suh-NAHV neh zah-MAHN"],["why are you late?","neden geç kaldın?","neh-DEN gech kahl-DUHN"],["how much is it?","ne kadar?","neh kah-DAR"]]},{"id":"possessives","title":"Possessives","text":["Add an ending to the noun: -im (my), -in (your), -i (his / her), -imiz (our), -iniz (your pl.), -leri (their). Vowel harmony changes the vowel."],"rows":[["my","-im / -ım / -um / -üm","eem"],["your","-in / -ın / -un / -ün","een"],["his / her","-i / -ı / -u / -ü","ee"],["our","-imiz / -ımız","ee-meez"]],"ex":[["my house","evim","eh-VEEM"],["your friends","arkadaşların","ar-kah-dahsh-lah-RUHN"],["his sister","kız kardeşi","kuhz kar-deh-SHEE"],["our teacher","öğretmenimiz","uh-ret-meh-nee-MEEZ"],["my mother","annem","AHN-nem"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["sen (and -sin, -im) for friends. siz (and -siniz) for strangers, older people, and groups. Add -ler or \"Bey\" (Mr) / \"Hanım\" (Mrs) after names for respect."],"rows":[["you, informal","sen","sen"],["you, formal","siz","seez"],["Mr","Bey (after the name)","bay"],["Mrs / Ms","Hanım (after the name)","hah-NUHM"]],"ex":[["you speak (informal)","konuşuyorsun","koh-noo-shoo-yor-SOON"],["you speak (formal)","konuşuyorsunuz","koh-noo-shoo-yor-soo-NOOZ"],["how are you? (informal)","nasılsın?","nah-suhl-SUHN"],["how are you? (formal)","nasılsınız?","nah-suhl-suh-NUHZ"],["thank you, Mr Ali","teşekkürler Ali Bey","tesh-ek-kewr-LER ah-LEE bay"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: stem + -di + person ending (-m, -n, -, -k, -niz, -ler). Future: stem + -ecek / -acak + person ending."],"rows":[["I went","gittim","geet-TEEM"],["you went","gittin","geet-TEEN"],["he / she went","gitti","geet-TEE"],["I will go","gideceğim","gee-deh-jeh-EEM"],["we will go","gideceğiz","gee-deh-jeh-EEZ"]],"ex":[["yesterday I worked","dün çalıştım","dewn chah-luhsh-TUHM"],["she bought a book","bir kitap aldı","beer kee-TAHP ahl-DUH"],["I went home","eve gittim","eh-VEH geet-TEEM"],["I will call you tomorrow","yarın seni arayacağım","yah-RUHN seh-NEE ah-rah-yah-jah-UHM"],["we will eat at eight","saat sekizde yiyeceğiz","sah-AHT seh-keez-DEH yee-yeh-jeh-EEZ"]]}],"name":"Turkish","id":"tr","badge":"Solid","note":"Starter speaking. Capitals mark the stressed syllable (usually the last)."}