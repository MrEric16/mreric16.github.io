],["elder brother","aka","","اکه"],["younger brother","ini","","اینی"],["elder sister","äčä","","اچه"],["person","kiši","","کیشی"],["friend","dost","","دوست"],["child","bala","","بالا"]]},{"id":"nature","title":"Nature","items":[["sun","kün","","کون"],["moon","ay","","آی"],["star","yultuz","","یولدوز"],["sky","kök","","کوک"],["earth","yer","","یر"],["mountain","tağ","","تاغ"],["water","su","","سو"],["fire","ot","","اوت"],["river","özän","","اوزن"],["tree","yığaç","","یغاچ"],["horse","at","","آت"]]},{"id":"body","title":"Body","items":[["head","baš","","باش"],["eye","köz","","کوز"],["ear","qulaq","","قولاق"],["hand","qol","","قول"],["heart","köngül","","کونگول"],["tongue","til","","تیل"]]},{"id":"school-and-learning","title":"School and learning","items":[["school","mäktäb","","مکتب"],["book","kitāb","","کتاب"],["pen","qäläm","","قلم"],["teacher","ustād","","استاد"],["student","šägird","","شاگرد"],["knowledge","ilm","","علم"],["word","söz","","سوز"],["poem","šiʿr","","شعر"],["paper","qağaz","","قاغذ"]]},{"id":"verbs-stem","title":"Verbs (stem)","items":[["to come","käl-","","کل"],["to go","bar-","","بار"],["to see","kör-","","کور"],["to know","bil-","","بیل"],["to give","bär-","","بیر"],["to take","al-","","آل"],["to write","yaz-","","یاز"],["to read","oqu-","","اوقو"],["to say","ayt-","","آیت"]]},{"id":"describing","title":"Describing","items":[["good","yaxšı","","یاخشی"],["bad","yamān","","یامان"],["great","uluğ","","اولوغ"],["small","kičik","","کیچیک"],["new","yangı","","یانگی"],["old","eski","","اسکی"],["beautiful","güzäl","","گزل"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Chagatai has no gender. \"Ol\" means he, she and it. \"Siz\" is polite."],"rows":[["I","män","من"],["you (informal)","sän","سن"],["you (formal)","siz","سز"],["he / she / it","ol","اول"],["we","biz","بز"],["you (plural)","siz","سز"],["they","alar","آلار"]],"ex":[["I","män","","من"],["you","sän","","سن"],["he","ol","","اول"],["we","biz","","بز"],["they","alar","","آلار"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["The plural is -lar or -lär by vowel harmony. After a number the noun stays singular."],"rows":[["-lar (back vowels)","kitāb → kitāblar","کتاب → کتابلر"],["-lär (front vowels)","kiši → kišilär","کیشی → کیشیلر"]],"ex":[["the book","kitāb","","کتاب"],["the books","kitāblar","","کتابلر"],["the person","kiši","","کیشی"],["the people","kišilär","","کیشیلر"],["two books","ikki kitāb","","ایکی کتاب"]]},{"id":"negation","title":"Negation","text":["\"Yoq\" means \"there is not\". On a verb, -ma- or -mä- is put after the stem: käldi (he came), kälmädi (he did not come). Always compare with the positive form."],"rows":[["there is not","yoq","یوق"],["-ma- / -mä-","käl → kälmä","کل → کلمه"]],"ex":[["there is a book","kitāb bar","","کتاب بار"],["there is no book","kitāb yoq","","کتاب یوق"],["he came","käldi","","کلدی"],["he did not come","kälmädi","","کلمدی"],["I came","käldim","","کلدیم"],["I did not come","kälmädim","","کلمدیم"]]},{"id":"questions","title":"Questions","text":["A question word is placed where the answer would stand, with the same word order as a statement."],"rows":[["who","kim","کیم"],["what","nä","نه"],["where","qayda","قایدا"],["how many","nečä","نیچه"]],"ex":[["who is he?","ol kim","","اول کیم"],["what is this?","bu nä","","بو نه"],["where is the book?","kitāb qayda","","کتاب قایدا"],["how many?","nečä","","نیچه"]]},{"id":"past-tense","title":"Past tense","text":["The past ending is -dı / -di by vowel harmony, then a personal ending: -m (I), -ng (you), none (he), -k (we)."],"rows":[["I came","käldim","کلدیم"],["you came","käldıng","کلدینگ"],["he came","käldi","کلدی"],["we came","käldik","کلدیک"]],"ex":[["I saw","kördüm","","کوردوم"],["he saw","kördi","","کوردی"],["I wrote","yazdım","","یازدیم"],["I gave","bärdim","","بیردیم"]]},{"id":"commands","title":"Commands","text":["The command is the bare stem. Add -ma- / -mä- to forbid."],"rows":[["come","käl","کل"],["do not come","kälmä","کلمه"],["go","bar","بار"],["do not go","barma","بارمه"]],"ex":[["come","käl","","کل"],["do not come","kälmä","","کلمه"],["go","bar","","بار"],["do not go","barma","","بارمه"]]},{"id":"possession-and-cases","title":"Possession and cases","text":["Suffixes go on the noun: -im (my), -ing (your), -i (his / her). The locative is -da, the ablative -dan."],"rows":[["my book","kitābım","کتابیم"],["your book","kitābıng","کتابینگ"],["his book","kitābı","کتابی"],["in the house","üydä","ایده"]],"ex":[["my book","kitābım","","کتابیم"],["your book","kitābıng","","کتابینگ"],["his book","kitābı","","کتابی"]]}],"name":"Chagatai","id":"chg","flag":"chg","script":"Perso-Arabic","note":""}