["to be (state, place)","estar","ehs-TAR"],["to have","tener","teh-NEHR"],["to go","ir","eer"],["to want","querer","keh-REHR"],["to eat","comer","koh-MEHR"],["to drink","beber","beh-BEHR"],["to speak","hablar","ah-BLAR"],["to see","ver","behr"],["to come","venir","beh-NEER"],["to give","dar","dahr"],["to know (a fact)","saber","sah-BEHR"],["to do / make","hacer","ah-SEHR"],["to say","decir","deh-SEER"],["to like","gustar","goos-TAR"],["to live","vivir","bee-BEER"],["to work","trabajar","trah-bah-HAR"],["to buy","comprar","kohm-PRAR"],["to read","leer","leh-EHR"],["to write","escribir","ehs-kree-BEER"],["to sleep","dormir","dor-MEER"],["to learn","aprender","ah-prehn-DEHR"],["to help","ayudar","ah-yoo-DAR"],["to need","necesitar","neh-seh-see-TAR"],["to love","amar","ah-MAR"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Spanish often drops the pronoun, because the verb ending already shows who is speaking."],"rows":[["I","yo","YOH"],["you (informal)","tú","too"],["he / she / you (formal)","él / ella / usted","ehl / EH-yah / oos-TEHD"],["we","nosotros","noh-SOH-trohs"],["you all (Spain)","vosotros","boh-SOH-trohs"],["they / you all","ellos / ustedes","EH-yohs / oos-TEH-dehs"]],"ex":[["I am a student","yo soy estudiante","yoh soy ehs-too-dee-AHN-teh"],["you are tall","tú eres alto","too EH-rehs AHL-toh"],["she is my sister","ella es mi hermana","EH-yah ehs mee ehr-MAH-nah"],["we are friends","nosotros somos amigos","noh-SOH-trohs SOH-mohs ah-MEE-gohs"],["they are teachers","ellos son profesores","EH-yohs sohn proh-feh-SOH-rehs"]]},{"id":"ser-to-be-who-or-what","title":"Ser: to be (who or what)","text":["Use ser for identity, origin, jobs, descriptions and time. It is irregular."],"rows":[["I am","soy","soy"],["you are","eres","EH-rehs"],["he / she is","es","ehs"],["we are","somos","SOH-mohs"],["you all are (Spain)","sois","soys"],["they are","son","sohn"]],"ex":[["I am English","soy inglés","soy een-GLEHS"],["he is a doctor","él es médico","ehl ehs MEH-dee-koh"],["it is Monday","es lunes","ehs LOO-nehs"],["we are from Uzbekistan","somos de Uzbekistán","SOH-mohs deh ooz-beh-krees-TAHN"],["they are tall","son altos","sohn AHL-tohs"]]},{"id":"estar-to-be-where-or-how","title":"Estar: to be (where or how)","text":["Use estar for places and for feelings or conditions that change."],"rows":[["I am","estoy","ehs-TOY"],["you are","estás","ehs-TAHS"],["he / she is","está","ehs-TAH"],["we are","estamos","ehs-TAH-mohs"],["you all are (Spain)","estáis","ehs-TAYS"],["they are","están","ehs-TAHN"]],"ex":[["I am at home","estoy en casa","ehs-TOY ehn KAH-sah"],["she is tired","ella está cansada","EH-yah ehs-TAH kahn-SAH-dah"],["where are you?","¿dónde estás?","DOHN-deh ehs-TAHS"],["we are well","estamos bien","ehs-TAH-mohs bee-EHN"],["the soup is cold","la sopa está fría","lah SOH-pah ehs-TAH FREE-ah"]]},{"id":"tener-to-have","title":"Tener: to have","text":["Tener is also used for age (tengo 16 años) and for hunger, thirst and tiredness (tengo hambre, tengo sed, tengo sueño)."],"rows":[["I have","tengo","TEHN-goh"],["you have","tienes","tee-EH-nehs"],["he / she has","tiene","tee-EH-neh"],["we have","tenemos","teh-NEH-mohs"],["they have","tienen","tee-EH-nehn"]],"ex":[["I have a brother","tengo un hermano","TEHN-goh oon ehr-MAH-noh"],["she has two cats","ella tiene dos gatos","EH-yah tee-EH-neh dohs GAH-tohs"],["we have time","tenemos tiempo","teh-NEH-mohs tee-EHM-poh"],["I am hungry","tengo hambre","TEHN-goh AHM-breh"],["they have a car","tienen un coche","tee-EH-nehn oon KOH-cheh"]]},{"id":"regular-verbs-present-tense","title":"Regular verbs (present tense)","text":["Take the ending off the infinitive, then add the new ending. Three families: -ar, -er, -ir."],"rows":[["hablar (to speak): yo","hablo","AH-bloh"],["tú","hablas","AH-blahs"],["él / ella","habla","AH-blah"],["nosotros","hablamos","ah-BLAH-mohs"],["ellos","hablan","AH-blahn"],["comer: yo, tú, él, nosotros, ellos","como, comes, come, comemos, comen","KOH-moh..."],["vivir: yo, tú, él, nosotros, ellos","vivo, vives, vive, vivimos, viven","BEE-boh..."]],"ex":[["I speak English","hablo inglés","AH-bloh een-GLEHS"],["you eat a lot","comes mucho","KOH-mehs MOO-choh"],["she lives in Madrid","ella vive en Madrid","EH-yah BEE-beh ehn mah-DREED"],["we work every day","trabajamos todos los días","trah-bah-HAH-mohs TOH-dohs lohs DEE-ahs"],["they drink water","beben agua","BEH-behn AH-gwah"]]},{"id":"ir-to-go","title":"Ir: to go","text":["To say you are going to do something: ir + a + infinitive. Voy a comer = I am going to eat."],"rows":[["I go","voy","boy"],["you go","vas","bahs"],["he / she goes","va","bah"],["we go","vamos","BAH-mohs"],["they go","van","bahn"]],"ex":[["I am going to school","voy al colegio","boy ahl koh-LEH-hee-oh"],["where are you going?","¿adónde vas?","ah-DOHN-deh bahs"],["we are going to eat","vamos a comer","BAH-mohs ah koh-MEHR"],["she is going to travel","ella va a viajar","EH-yah bah ah bee-ah-HAR"],["let's go!","¡vamos!","BAH-mohs"]]},{"id":"gender-and-plurals","title":"Gender and plurals","text":["Nouns are masculine or feminine. Most ending in -o are masculine, most ending in -a feminine. Learn the word with its article.","Plural: add -s after a vowel, -es after a consonant. Adjectives agree with the noun."],"rows":[["the (m / f)","el / la","ehl / lah"],["the (plural m / f)","los / las","lohs / lahs"],["a (m / f)","un / una","oon / OO-nah"]],"ex":[["the boy","el niño","ehl NEE-nyoh"],["the girl","la niña","lah NEE-nyah"],["the books","los libros","lohs LEE-brohs"],["a red house","una casa roja","OO-nah KAH-sah RROH-hah"],["the cities","las ciudades","lahs see-oo-DAH-dehs"]]},{"id":"questions-and-negatives","title":"Questions and negatives","text":["Negative: put no before the verb. Question: raise your voice, or use a question word. Remember ¿ at the start."],"rows":[["no","no + verb","noh"],["what","qué","keh"],["where","dónde","DOHN-deh"],["who","quién","kee-EHN"],["how many","cuánto / cuántos","KWAHN-toh"]],"ex":[["I do not speak French","no hablo francés","noh AH-bloh frahn-SEHS"],["she does not live here","ella no vive aquí","EH-yah noh BEE-beh ah-KEE"],["what is your name?","¿cómo te llamas?","KOH-moh teh YAH-mahs"],["where do you live?","¿dónde vives?","DOHN-deh BEE-behs"],["who is he?","¿quién es él?","kee-EHN ehs ehl"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["To say you like something, use gustar: me gusta (one thing), me gustan (several things)."],"rows":[["my","mi / mis","mee / mees"],["your","tu / tus","too / toos"],["his / her","su / sus","soo / soos"],["our","nuestro","NWEHS-troh"]],"ex":[["my house","mi casa","mee KAH-sah"],["your friends","tus amigos","toos ah-MEE-gohs"],["I like coffee","me gusta el café","meh GOOS-tah ehl kah-FEH"],["I like dogs","me gustan los perros","meh GOOS-tahn lohs PEH-rrohs"],["she likes music","le gusta la música","leh GOOS-tah lah MOO-see-kah"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past (preterite) of -ar verbs: -é, -aste, -ó, -amos, -aron. Future: infinitive + -é, -ás, -á, -emos, -án."],"rows":[["I spoke","hablé","ah-BLEH"],["you spoke","hablaste","ah-BLAHS-teh"],["he / she spoke","habló","ah-BLOH"],["I will speak","hablaré","ah-blah-REH"],["we will speak","hablaremos","ah-blah-REH-mohs"]],"ex":[["yesterday I worked","ayer trabajé","ah-YEHR trah-bah-HEH"],["she bought a book","ella compró un libro","EH-yah kohm-PROH oon LEE-broh"],["I will call you tomorrow","te llamaré mañana","teh yah-mah-REH mah-NYAH-nah"],["we will eat at eight","comeremos a las ocho","koh-meh-REH-mohs ah lahs OH-choh"],["they travelled to Spain","viajaron a España","bee-ah-HAH-rohn ah ehs-PAH-nyah"]]}],"name":"Spanish","id":"es","badge":"Solid","note":"Starter speaking. Capitals mark the stressed syllable."}