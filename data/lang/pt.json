,"GRAHN-d"],["small","pequeno","peh-KEH-noo"],["good","bom","bohm"],["bad","mau","mow"],["new","novo","NOH-voo"],["old","velho","VEHL-yoo"],["beautiful","bonito","boo-NEE-too"],["ugly","feio","FAY-oo"],["fast","rápido","RAH-pee-doo"],["slow","lento","LEHN-too"],["easy","fácil","FAH-seel"],["difficult","difícil","dee-FEE-seel"],["cheap","barato","bah-RAH-too"],["expensive","caro","KAH-roo"],["clean","limpo","LEEM-poo"],["dirty","sujo","SOO-zhoo"]]},{"id":"common-verbs","title":"Common verbs","items":[["to be (permanent)","ser","sehr"],["to be (state, place)","estar","shTAR"],["to have","ter","tehr"],["to go","ir","eer"],["to want","querer","keh-REHR"],["to eat","comer","koo-MEHR"],["to drink","beber","beh-BEHR"],["to speak","falar","fah-LAR"],["to see","ver","vehr"],["to come","vir","veer"],["to give","dar","dahr"],["to know (a fact)","saber","sah-BEHR"],["to do / make","fazer","fah-ZEHR"],["to say","dizer","dee-ZEHR"],["to like","gostar","goosh-TAR"],["to live","viver","vee-VEHR"],["to work","trabalhar","trah-bahl-YAR"],["to buy","comprar","kohm-PRAR"],["to read","ler","lehr"],["to write","escrever","shkreh-VEHR"],["to sleep","dormir","door-MEER"],["to learn","aprender","ah-prayn-DEHR"],["to help","ajudar","ah-zhoo-DAR"],["to need","precisar","preh-see-ZAR"],["to love","amar","ah-MAR"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["The pronoun is often dropped, because the verb ending shows who is speaking. For formal \"you\", use o senhor / a senhora."],"rows":[["I","eu","EH-oo"],["you (informal)","tu","too"],["he / she","ele / ela","EH-l / EH-lah"],["we","nós","nohsh"],["you all (informal)","vocês","voh-SAYSH"],["they","eles / elas","EH-lsh / EH-lahsh"],["you (formal)","o senhor / a senhora","oo seh-NYOR / ah seh-NYOH-rah"]],"ex":[["I am a student","eu sou estudante","EH-oo soh shtoo-DAHN-t"],["you are tall","tu és alto","too ehsh AHL-too"],["she is my sister","ela é minha irmã","EH-lah eh MEEN-yah eer-MAHN"],["we are friends","nós somos amigos","nohsh SOH-moosh ah-MEE-goosh"],["they are teachers","eles são professores","EH-lsh sown proo-feh-SOH-rsh"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Most plurals add -s: casa → casas. Words ending in a consonant add -es. Words in -ão change: pão → pães, mão → mãos, limão → limões. Words in -l change: animal → animais. Articles change: o → os, a → as, um → uns, uma → umas."],"rows":[["the (m / f)","o / a","oo / ah"],["the (plural)","os / as","oosh / ahsh"],["a (m / f)","um / uma","oom / OO-mah"],["add -s","casa → casas","KAH-zahsh"],["add -es (consonant)","flor → flores","FLOH-rsh"],["-ão changes","pão → pães","paynsh"]],"ex":[["one cat, two cats","um gato, dois gatos","oom GAH-too doysh GAH-toosh"],["the book, the books","o livro, os livros","oo LEE-vroo oosh LEE-vroosh"],["a girl, girls","uma rapariga, raparigas","OO-mah rah-pah-REE-gah rah-pah-REE-gahsh"],["the flower, the flowers","a flor, as flores","ah flor ahsh FLOH-rsh"],["the bread, the loaves","o pão, os pães","oo pown oosh paynsh"]]},{"id":"ser-to-be-who-or-what","title":"Ser: to be (who or what)","text":["Ser: identity, origin, jobs, descriptions, time."],"rows":[["I am","eu sou","soh"],["you are","tu és","ehsh"],["he / she is","ele / ela é","eh"],["we are","nós somos","SOH-moosh"],["you all are","vocês são","sown"],["they are","eles / elas são","sown"]],"ex":[["I am English","sou inglês","soh een-GLAYSH"],["he is a doctor","ele é médico","EH-l eh MEH-dee-koo"],["it is Monday","é segunda-feira","eh seh-GOON-dah FAY-rah"],["we are from Uzbekistan","somos do Uzbequistão","SOH-moosh doo ooz-beh-keesh-TOWN"],["they are tall","eles são altos","EH-lsh sown AHL-toosh"]]},{"id":"estar-to-be-where-or-how","title":"Estar: to be (where or how)","text":["Estar: places and temporary states."],"rows":[["I am","eu estou","shTOH"],["you are","tu estás","shTAHSH"],["he / she is","ele / ela está","shTAH"],["we are","nós estamos","shTAH-moosh"],["they are","eles / elas estão","shTOWN"]],"ex":[["I am at home","estou em casa","shTOH ayn KAH-zah"],["she is tired","ela está cansada","EH-lah shTAH kahn-SAH-dah"],["where are you?","onde estás?","OHN-d shTAHSH"],["we are well","estamos bem","shTAH-moosh bayn"],["the soup is cold","a sopa está fria","ah SOH-pah shTAH FREE-ah"]]},{"id":"ter-to-have","title":"Ter: to have","text":["Ter is also used for age and feelings: tenho dezasseis anos, tenho fome, tenho sede."],"rows":[["I have","eu tenho","TAYN-yoo"],["you have","tu tens","taynsh"],["he / she has","ele / ela tem","tayn"],["we have","nós temos","TEH-moosh"],["they have","eles / elas têm","tayn"]],"ex":[["I have a brother","tenho um irmão","TAYN-yoo oom eer-MOWN"],["she has two cats","ela tem dois gatos","EH-lah tayn doysh GAH-toosh"],["we have time","temos tempo","TEH-moosh TAYM-poo"],["I am hungry","tenho fome","TAYN-yoo FOH-m"],["they have a car","eles têm um carro","EH-lsh tayn oom KAH-roo"]]},{"id":"regular-verbs-present-tense","title":"Regular verbs (present tense)","text":["Three families: -ar, -er, -ir. Drop the ending, add the new one. Falar (to speak):"],"rows":[["eu","falo","FAH-loo"],["tu","falas","FAH-lahsh"],["ele / ela","fala","FAH-lah"],["nós","falamos","fah-LAH-moosh"],["eles / elas","falam","FAH-lown"]],"ex":[["I speak English","falo inglês","FAH-loo een-GLAYSH"],["you eat a lot","comes muito","KOH-mehsh MWEEN-too"],["she lives in Lisbon","ela vive em Lisboa","EH-lah VEE-v ayn leezh-BOH-ah"],["we work every day","trabalhamos todos os dias","trah-bahl-YAH-moosh TOH-doosh oosh DEE-ahsh"],["they drink water","bebem água","BEH-bayn AH-gwah"]]},{"id":"ir-to-go","title":"Ir: to go","text":["Going to do something soon: ir + infinitive. Vou comer = I am going to eat."],"rows":[["I go","eu vou","voh"],["you go","tu vais","vysh"],["he / she goes","ele / ela vai","vy"],["we go","nós vamos","VAH-moosh"],["they go","eles / elas vão","vown"]],"ex":[["I am going to school","vou para a escola","voh PAH-rah ah shKOH-lah"],["where are you going?","para onde vais?","PAH-rah OHN-d vysh"],["we are going to eat","vamos comer","VAH-moosh koo-MEHR"],["she is going to travel","ela vai viajar","EH-lah vy vee-ah-ZHAR"],["let's go!","vamos!","VAH-moosh"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Order: subject, verb, rest. The adjective usually comes after the noun and agrees with it. You can drop the pronoun."],"rows":[["subject + verb + rest","Como pão.","KOH-moo pown"],["adjective after noun","uma casa grande","OO-mah KAH-zah GRAHN-d"],["add time or place at the end","Trabalho aqui hoje.","trah-BAHL-yoo ah-KEE OH-zh"]],"ex":[["I eat bread","como pão","KOH-moo pown"],["Maria reads a book","a Maria lê um livro","ah mah-REE-ah leh oom LEE-vroo"],["we live in a big house","vivemos numa casa grande","vee-VEH-moosh NOO-mah KAH-zah GRAHN-d"],["he works here today","ele trabalha aqui hoje","EH-l trah-BAHL-yah ah-KEE OH-zh"],["the dog is black","o cão é preto","oo cown eh PREH-too"]]},{"id":"negation","title":"Negation","text":["Put não before the verb. Double negatives are normal: não tenho nada."],"rows":[["not","não + verb","nown"],["nothing","nada","NAH-dah"],["nobody","ninguém","neen-GAYN"],["never","nunca","NOON-kah"]],"ex":[["I do not speak French","não falo francês","nown FAH-loo frahn-SAYSH"],["she does not live here","ela não vive aqui","EH-lah nown VEE-v ah-KEE"],["I do not want anything","não quero nada","nown KEH-roo NAH-dah"],["nobody is here","não está ninguém aqui","nown shTAH neen-GAYN ah-KEE"],["I never eat meat","nunca como carne","NOON-kah KOH-moo KAR-n"]]},{"id":"asking-questions","title":"Asking questions","text":["Yes or no question: same words as a statement, with a rising voice. Or add \"não é?\" (isn't it?)."],"rows":[["statement","Falas inglês.","FAH-lahsh een-GLAYSH"],["question","Falas inglês?","FAH-lahsh een-GLAYSH"],["add \"right?\"","não é?","nown eh"]],"ex":[["do you speak English?","falas inglês?","FAH-lahsh een-GLAYSH"],["is she a doctor?","ela é médica?","EH-lah eh MEH-dee-kah"],["do you have a pen?","tens uma caneta?","taynsh OO-mah kah-NEH-tah"],["are you tired?","estás cansado?","shTAHSH kahn-SAH-doo"],["is it far?","é longe?","eh LOHN-zh"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["what","o que","oo k"],["who","quem","kayn"],["where","onde","OHN-d"],["when","quando","KWAHN-doo"],["why","porquê","poor-KEH"],["how","como","KOH-moo"],["which","qual","kwahl"],["how much / how many","quanto / quantos","KWAHN-too / KWAHN-toosh"]],"ex":[["what is this?","o que é isto?","oo k eh EESH-too"],["who is she?","quem é ela?","kayn eh EH-lah"],["where do you live?","onde moras?","OHN-d MOH-rahsh"],["when is the exam?","quando é o exame?","KWAHN-doo eh oo ee-ZAH-m"],["why are you late?","porque chegas tarde?","poor-K SHEH-gahsh TAR-d"],["how much is it?","quanto custa?","KWAHN-too KOOSH-tah"]]},{"id":"possessives","title":"Possessives","text":[],"rows":[["my","o meu / a minha","oo MEH-oo / ah MEEN-yah"],["your (informal)","o teu / a tua","oo TEH-oo / ah TOO-ah"],["his / her","o seu / a sua","oo SEH-oo / ah SOO-ah"],["our","o nosso / a nossa","oo NOH-soo / ah NOH-sah"],["their","o seu / a sua","oo SEH-oo / ah SOO-ah"]],"ex":[["my house","a minha casa","ah MEEN-yah KAH-zah"],["your friends","os teus amigos","oosh TEH-oosh ah-MEE-goosh"],["his sister","a irmã dele","ah eer-MAHN DEH-l"],["our teacher","o nosso professor","oo NOH-soo proo-feh-SOR"],["my mother","a minha mãe","ah MEEN-yah mayn"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["tu / teu for friends and family. o senhor / a senhora, with the he / she verb form, for strangers and work."],"rows":[["you, informal","tu","too"],["you, formal (m / f)","o senhor / a senhora","oo seh-NYOR / ah seh-NYOH-rah"],["your, informal","teu / tua","TEH-oo / TOO-ah"],["your, formal","seu / sua","SEH-oo / SOO-ah"]],"ex":[["you speak (informal)","tu falas","too FAH-lahsh"],["you speak (formal, to a man)","o senhor fala","oo seh-NYOR FAH-lah"],["how are you? (informal)","como estás?","KOH-moo shTAHSH"],["how are you? (formal)","como está?","KOH-moo shTAH"],["thank you, sir","obrigado, senhor","oh-bree-GAH-doo seh-NYOR"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past (simple): -ei, -aste, -ou, -ámos, -aram for -ar verbs. Future: ir + infinitive, or infinitive + -ei, -ás, -á, -emos, -ão."],"rows":[["I spoke","falei","fah-LAY"],["you spoke","falaste","fah-LAHSH-t"],["he / she spoke","falou","fah-LOH"],["I will speak","falarei","fah-lah-RAY"]],"ex":[["yesterday I worked","ontem trabalhei","OHN-tayn trah-bahl-YAY"],["she bought a book","ela comprou um livro","EH-lah kohm-PROH oom LEE-vroo"],["I went home","fui para casa","fwee PAH-rah KAH-zah"],["I will call you tomorrow","vou ligar-te amanhã","voh lee-GAR-t ah-mahn-YAHN"],["we will eat at eight","vamos comer às oito","VAH-moosh koo-MEHR ahsh OY-too"]]}],"name":"Portuguese","id":"pt","badge":"Solid","note":"Starter speaking. Capitals mark the stressed syllable."}