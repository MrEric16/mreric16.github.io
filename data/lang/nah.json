Mexico City","Mexihco","meh-SHEE-koh"],["Tenochtitlan","Tenochtitlan","teh-nohch-TEET-lahn"],["temple","teocalli","teh-oh-KAH-lee"],["market","tianquiztli","tee-ahn-KEES-tlee"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Nahuatl has independent pronouns, but the verb already shows the person with a prefix: ni- (I), ti- (you), no prefix (he or she). The pronouns are used for emphasis."],"rows":[["I","nehuatl","neh-WAHTL"],["you","tehuatl","teh-WAHTL"],["he / she","yehuatl","yeh-WAHTL"],["we","tehuantin","teh-WAHN-teen"],["you (many)","amehuantin","ah-meh-WAHN-teen"],["they","yehuantin","yeh-WAHN-teen"]],"ex":[["I want it","nicnequi","neek-NEH-kee"],["you want it","ticnequi","teek-NEH-kee"],["he wants it","quinequi","kee-NEH-kee"]]},{"id":"i-am-a","title":"I am a...","text":["There is no word for \"to be\" with a noun. Put the person prefix on the noun: ni- (I am), ti- (you are), nothing (he or she is)."],"rows":[["I am a person","nitlacatl","nee-TLAH-kahtl"],["you are a person","titlacatl","tee-TLAH-kahtl"],["he / she is a person","tlacatl","TLAH-kahtl"],["I am a woman","nicihuatl","nee-SEE-wahtl"],["I am a man","nioquichtli","nee-oh-KEECH-tlee"]],"ex":[["I am a woman","nicihuatl","nee-SEE-wahtl"],["you are a man","tioquichtli","tee-oh-KEECH-tlee"],["I am a wise man","nitlamatini","nee-tlah-mah-TEE-nee"]]},{"id":"negation","title":"Negation","text":["Put \"ahmo\" before the verb to say \"not\"."],"rows":[["I want it","nicnequi","neek-NEH-kee"],["I do not want it","ahmo nicnequi","AH-moh neek-NEH-kee"],["I know it","nicmati","neek-MAH-tee"],["I do not know it","ahmo nicmati","AH-moh neek-MAH-tee"]],"ex":[["I do not see it","ahmo niquitta","AH-moh nee-KEET-tah"],["I do not go","ahmo niyauh","AH-moh nee-YAHW"]]},{"id":"possession","title":"My, your, his","text":["Nouns take a prefix: no- (my), mo- (your), i- (his or her). The ending -tl or -tli drops off: calli (house) becomes nocal (my house)."],"rows":[["my house","nocal","NOH-kahl"],["your house","mocal","MOH-kahl"],["his / her house","ical","EE-kahl"],["my mother","nonan","NOH-nahn"],["my father","notah","NOH-tah"]],"ex":[["my house","nocal","NOH-kahl"],["my mother","nonan","NOH-nahn"],["my father","notah","NOH-tah"]]},{"id":"commands","title":"Commands","text":["Start the verb with xi- to give an order."],"rows":[["look!","xitlachia","shee-tlah-CHEE-ah"],["do it!","xicchihua","sheek-CHEE-wah"]],"ex":[["look","xitlachia","shee-tlah-CHEE-ah"]]},{"id":"questions","title":"Questions","text":["Question words: tlein (what), aquin (who), canin (where), quenin (how). The word \"cuix\" at the start turns a sentence into a yes or no question."],"rows":[["what?","tlein?","tleh-EEN"],["who?","aquin?","ah-KEEN"],["where?","canin?","kah-NEEN"],["how?","quenin?","keh-NEEN"]],"ex":[["do you want it?","cuix ticnequi?","kweesh teek-NEH-kee"],["who is he?","aquin yehuatl?","ah-KEEN yeh-WAHTL"]]}],"name":"Classical Nahuatl (Aztec)","id":"nah","flag":"nah","note":""}