eh"],["to ask","fiafraí","FEE-uh-free"],["to go","dul","dul"],["to come","teacht","tyakht"],["to see","feiceáil","feh-KAWL"],["to eat","ithe","IH-heh"],["to drink","ól","ohl"],["to sleep","codladh","KUD-luh"],["to speak","labhairt","LOW-irt"],["to know","fios","fiss"],["to want","ag iarraidh","ug EE-ar-ig"],["to give","tabhairt","TOW-irt"],["to take","tógáil","TOH-gawl"],["to buy","ceannach","KYAN-akh"],["to sell","díol","DEEL"],["to read","léamh","layv"],["to write","scríobh","shkreev"],["to work","obair","UB-ir"],["to live","cónaí","KOH-nee"],["to love","grá a thabhairt do","graw uh HOW-irt duh"],["to like","maith le","mah leh"],["to wait","fanacht","FAN-akht"],["to open","oscailt","UST-kul-t"],["to close","dúnadh","DOO-nuh"],["to say","rá","raw"]]},{"id":"school-subjects","title":"School subjects","items":[["maths","matamaitic","MAT-uh-mat-ik"],["physics","fisic","FIS-ik"],["chemistry","ceimic","KEM-ik"],["biology","bitheolaíocht","BIH-oh-lee-okht"],["history","stair","stawr"],["geography","tíreolaíocht","TEER-oh-lee-okht"],["literature","litríocht","LIT-ree-okht"],["English","Béarla","BAYR-luh"],["Irish language","Gaeilge","GWAYL-geh"],["Russian language","Rúisis","ROO-ish-ish"],["foreign languages","teangacha iasachta","TYANG-akh-uh EE-us-akht-uh"],["art","ealaín","AL-een"],["music","ceol","kyohl"],["PE","corpoideachas","KOR-pid-ak-us"],["computer science","ríomheolaíocht","REE-oh-lee-okht"],["economics","eacnamaíocht","AK-nuh-mee-okht"],["law","dlí","dlee"],["philosophy","fealsúnacht","FAL-soon-akht"],["psychology","síceolaíocht","SHEE-kyoh-lee-okht"],["science","eolaíocht","OH-lee-okht"]]},{"id":"classroom","title":"Classroom","items":[["classroom","seomra ranga","SHOH-mruh RANG-uh"],["desk","deasc","dask"],["board","clár dubh","klawr duv"],["notebook","cóipleabhar","KOH-pee-lyow-ur"],["textbook","téacsleabhar","TAYKS-lyow-ur"],["homework","obair bhaile","UB-ir WAL-eh"],["test","scrúdú","SKROO-doo"],["grade","marc","mark"],["timetable","clár ama","klawr AM-uh"],["break","sos","sus"],["bell","clog","klug"],["ruler","rialóir","REE-uh-loh-ir"],["rubber","scriosán","SKRIS-awn"],["rucksack","mála scoile","MAW-luh SKUL-eh"],["dictionary","foclóir","FUK-loh-ir"],["question","ceist","kesht"],["answer","freagra","FRAG-ruh"],["mistake","earráid","AR-awj"],["pen","peann","pyoun"],["pencil","peann luaidhe","pyoun LOO-ig"]]},{"id":"university","title":"University","items":[["university","ollscoil","UL-skul"],["lecture","léacht","layakht"],["professor","ollamh","UL-uv"],["degree","céim","kaym"],["scholarship","scoláireacht","SKUL-awr-akht"],["library","leabharlann","LYOW-ur-lun"],["dormitory","teach cónaithe","tyakh KOH-nuh-heh"],["campus","campas","KAM-pus"],["tuition fees","táillí","TAWL-ee"],["semester","seimeastar","SEM-es-tar"],["course","cúrsa","KOOR-suh"],["essay","aiste","ASH-teh"],["thesis","tráchtas","TRAWKH-tus"],["diploma","dioplóma","dih-OH-ploh-muh"],["seminar","seimineár","SEM-in-ar"],["entrance exam","scrúdú iontrála","SKROO-doo IN-trawl-uh"],["application","iarratas","EE-ar-uh-tus"],["student card","cárta mic léinn","KAWR-tuh mik layn"],["faculty","dámh","dawv"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","staidéar a dhéanamh","STAH-der uh YAY-nuv"],["to teach","múineadh","MOO-nuh"],["to ask","ceist a chur","kesht uh khur"],["to answer","freagairt","FRAG-irt"],["to repeat","a rá arís","uh raw uh-REESH"],["to understand","tuiscint","TISH-kint"],["to remember","cuimhneamh","KIV-nuv"],["to forget","dearmad a dhéanamh","DAR-ud uh YAY-nuv"],["to explain","míniú","MEEN-yoo"],["to practise","cleachtadh","KLAKH-tuh"],["to pass an exam","scrúdú a ritheadh","SKROO-doo uh RIH-uh"],["to fail an exam","teip i scrúdú","tep ih SKROO-doo"],["to write down","nótaí a ghlacadh","NOH-tee uh GHLAK-uh"],["to listen","éisteacht","AYSHT-akht"],["to read aloud","léamh os ard","layv us ard"],["to think","smaoineamh","SMEEN-uv"],["to count","comhaireamh","KOH-ir-uv"],["to spell","litriú","LIT-ree-oo"],["to translate","aistriú","ASH-tree-oo"],["to graduate","céim a bhaint amach","kaym uh BWAINT uh-MAKH"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Irish has no he / she difference for verbs, but the pronoun does: \"sé\" (he) and \"sí\" (she). \"Muid\" or \"sinn\" is we. \"Sibh\" is you (plural or formal)."],"rows":[["I","mé","may"],["you (singular)","tú","too"],["he","sé","shay"],["she","sí","shee"],["we","muid / sinn","mwid / shin"],["you (formal or plural)","sibh","shiv"],["they","siad","SHEE-ud"]],"ex":[["I am a student","is mac léinn mé","iss mak LAYN may"],["you are tall","tá tú ard","taw too ard"],["she is my older sister","is í mo dheirfiúr níos sine í","iss ee muh YER-ih-fyoor nees SHIN-eh ee"],["we are friends","is cairde muid","iss KAR-jeh mwid"],["they are teachers","is múinteoirí iad","iss MOON-chor-ee EE-ud"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Plurals are not regular. Learn the pair: leabhar, leabhair; teach, tithe; cat, cait; páiste, páistí. After a number, the noun stays singular: dhá leabhar (two book)."],"rows":[["book","leabhar","LYOW-ur"],["books","leabhair","LYOW-ir"],["house","teach","tyakh"],["houses","tithe","TIH-heh"]],"ex":[["one house, houses","teach amháin, tithe","tyakh uh-WAWN, TIH-heh"],["one book, books","leabhar amháin, leabhair","LYOW-ur uh-WAWN, LYOW-ir"],["one cat, cats","cat amháin, cait","kat uh-WAWN, kat"],["two books","dhá leabhar","gaw LYOW-ur"],["the children","na páistí","nuh PAWSH-tee"]]},{"id":"to-be-t-and-is","title":"To be: tá and is","text":["Irish has two verbs \"to be\". \"Tá\" is for states and places: tá mé tuirseach (I am tired). \"Is\" is the copula for names, jobs and identities: is múinteoir mé (I am a teacher)."],"rows":[["I am","tá mé","taw may"],["you are","tá tú","taw too"],["he / she is","tá sé / tá sí","taw shay / taw shee"],["we are","tá muid","taw mwid"],["you are (plural)","tá sibh","taw shiv"],["they are","tá siad","taw SHEE-ud"]],"ex":[["I am a student","is mac léinn mé","iss mak LAYN may"],["you are tired","tá tú tuirseach","taw too TIR-shakh"],["he is a doctor","is dochtúir é","iss DUKH-toor ay"],["we are happy","tá muid sásta","taw mwid SAWS-tuh"],["they are at home","tá siad sa bhaile","taw SHEE-ud suh WAL-eh"]]},{"id":"having-ag","title":"Having: ag","text":["Irish says \"at me\": tá ... agam (I have). Learn the endings: agam (I), agat (you), aige (he), aici (she), againn (we), agaibh (you plural), acu (they)."],"rows":[["I have","tá ... agam","taw ... AG-um"],["you have","tá ... agat","taw ... AG-ut"],["he has","tá ... aige","taw ... EG-eh"],["she has","tá ... aici","taw ... EK-ih"],["I do not have","níl ... agam","neel ... AG-um"]],"ex":[["I have an older brother","tá deartháir níos sine agam","taw DYAR-hawr nees SHIN-eh AG-um"],["I have a car","tá carr agam","taw kar AG-um"],["I do not have time","níl am agam","neel am AG-um"],["there is a problem","tá fadhb ann","taw FIE-b un"],["there is no water","níl uisce ann","neel ISH-keh un"]]},{"id":"present-tense","title":"Present tense","text":["Use \"tá\" + \"ag\" + the verbal noun for an action now: tá mé ag ithe (I am eating). For habits, the verb itself changes: ithim (I eat), itheann tú (you eat), itheann sé (he eats)."],"rows":[["I am eating","tá mé ag ithe","taw may ug IH-heh"],["you are eating","tá tú ag ithe","taw too ug IH-heh"],["I eat (habit)","ithim","IH-him"],["he / she eats (habit)","itheann sé / sí","IH-hun shay / shee"]],"ex":[["I am eating bread","tá mé ag ithe aráin","taw may ug IH-heh uh-RAWN"],["you are reading a book","tá tú ag léamh leabhair","taw too ug layv LYOW-ir"],["she works in a bank","oibríonn sí i mbanc","UB-ree-un shee ih mangk"],["we drink tea","ólann muid tae","OHL-un mwid tay"],["they are sleeping","tá siad ina gcodladh","taw SHEE-ud in-uh GUD-luh"]]},{"id":"basic-sentences","title":"Basic sentences","text":["The order is verb, subject, object. In Irish the verb comes first."],"rows":[["I read a book","léim leabhar","LAY-im LYOW-ur"],["he drinks tea","ólann sé tae","OHL-un shay tay"],["a big house","teach mór","tyakh more"],["a new car","carr nua","kar NOO-uh"]],"ex":[["I read a book","léim leabhar","LAY-im LYOW-ur"],["he drinks tea","ólann sé tae","OHL-un shay tay"],["we go to school","téimid ar scoil","TAY-mid er skul"],["they eat bread","itheann siad arán","IH-hun SHEE-ud uh-RAWN"],["the teacher writes","scríobhann an múinteoir","SHKREE-vun un MOON-chor"]]},{"id":"negation","title":"Negation","text":["Put \"ní\" before the verb: ní ithim (I do not eat). For \"tá\", use \"níl\": níl mé tuirseach (I am not tired). The word after \"ní\" changes its first letter."],"rows":[["I do not go","ní théim","nee HAY-im"],["you do not go","ní théann tú","nee HAYN too"],["he / she does not go","ní théann sé / sí","nee HAYN shay / shee"],["it is not good","níl sé go maith","neel shay guh mah"]],"ex":[["I want","ba mhaith liom","bah wah lum"],["I do not want","níor mhaith liom","neer wah lum"],["I speak English","labhraím Béarla","LOW-ruh-eem BAYR-luh"],["I do not speak English","ní labhraím Béarla","nee LOW-ruh-eem BAYR-luh"],["I like it","is maith liom é","iss mah lum ay"],["I do not like it","ní maith liom é","nee mah lum ay"],["she is here","tá sí anseo","taw shee un-SHUH"],["she is not here","níl sí anseo","neel shee un-SHUH"],["I have a car","tá carr agam","taw kar AG-um"],["I do not have a car","níl carr agam","neel kar AG-um"],["I understand","tuigim","TIG-im"],["I do not understand","ní thuigim","nee HIG-im"],["we are tired","tá muid tuirseach","taw mwid TIR-shakh"],["we are not tired","níl muid tuirseach","neel mwid TIR-shakh"],["he works on Sundays","oibríonn sé Dé Domhnaigh","UB-ree-un shay jay DOW-nee"],["he does not work on Sundays","ní oibríonn sé Dé Domhnaigh","nee UB-ree-un shay jay DOW-nee"]]},{"id":"asking-questions","title":"Asking questions","text":["Put \"an\" before the verb: an bhfuil tú...? (are you...?), an ólann tú...? (do you drink...?). Reply with the verb: \"Tá\" or \"Níl\". \"An\" makes the next word change its first letter."],"rows":[["Do you go?","an dtéann tú?","un jayn too"],["Is it good?","an bhfuil sé go maith?","un will shay guh mah"],["Is it right?","an bhfuil sé ceart?","un will shay kyart"]],"ex":[["is this your book?","an é seo do leabhar?","un ay shuh duh LYOW-ur"],["are they here?","an bhfuil siad anseo?","un will SHEE-ud un-SHUH"],["do you like tea?","an maith leat tae?","un mah lat tay"],["is it cold?","an bhfuil sé fuar?","un will shay FOO-ur"],["do you speak English?","an labhraíonn tú Béarla?","un LOW-ree-un too BAYR-luh"]]},{"id":"question-words","title":"Question words","text":["Question words come first."],"rows":[["who","cé","kay"],["what","céard / cad","kayrd / kod"],["where","cá","kaw"],["when","cathain","KAH-hin"],["why","cén fáth","kayn faw"],["how","conas","KUN-us"],["how much","cé mhéad","kay vayd"]],"ex":[["what is your name?","cad is ainm duit?","kod iss AN-im gwitch"],["who is he?","cé hé?","kay hay"],["where do you live?","cá bhfuil tú i do chónaí?","kaw will too ih duh KHOH-nee"],["when is the lesson?","cathain a bhíonn an ceacht ann?","KAH-hin uh VEE-un un kyakht un"],["why are you late?","cén fáth go bhfuil tú déanach?","kayn faw guh will too DAY-nakh"],["how much is it?","cé mhéad atá air?","kay vayd uh-TAW er"],["which book?","cén leabhar?","kayn LYOW-ur"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["The possessive comes before the noun: mo (my), do (your), a (his, her), ár (our), bhur (your plural), a (their). \"Mo\" and \"do\" lenite the next word: mo cheann (my head). \"A\" (his) lenites; \"a\" (her) does not."],"rows":[["my book","mo leabhar","muh LYOW-ur"],["your book","do leabhar","duh LYOW-ur"],["his book","a leabhar","uh LYOW-ur"],["her book","a leabhar","uh LYOW-ur"]],"ex":[["my phone","mo ghuthán","muh GHOO-hawn"],["your house (formal)","bhur dteach","vur dyakh"],["his sister","a dheirfiúr","uh YER-ih-fyoor"],["I like music","is maith liom ceol","iss mah lum kyohl"],["I love football","is breá liom peil","iss BRAW lum pel"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Irish has \"tú\" (one person) and \"sibh\" (more than one, or very formal). There is little extra formal talk. Use \"a dhuine uasail\" for sir and \"a bhean uasal\" for madam."],"rows":[["sir","a dhuine uasail","uh GWIN-eh OO-ush-il"],["madam","a bhean uasal","uh van OO-sul"]],"ex":[["how are you? (informal)","conas atá tú?","KUN-us uh-TAW too"],["how are you? (formal)","conas atá sibh?","KUN-us uh-TAW shiv"],["where are you going? (informal)","cá bhfuil tú ag dul?","kaw will too ug dul"],["where are you going? (formal)","cá bhfuil sibh ag dul?","kaw will shiv ug dul"],["please sit down (formal)","suígí síos, le do thoil","SEE-gee sheess, leh duh HUL"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: add \"d'\" or a lenition: d'ith mé (I ate), chuaigh mé (I went, irregular). Future: add -faidh: íosfaidh mé (I will eat), rachaidh mé (I will go)."],"rows":[["I ate","d'ith mé","dih may"],["I went","chuaigh mé","KHOO-ig may"],["I will eat","íosfaidh mé","EESS-hih may"],["I will go tomorrow","rachaidh mé amárach","RAKH-ih may uh-MAW-rakh"]],"ex":[["yesterday I was tired","inné, bhí mé tuirseach","in-AY, vee may TIR-shakh"],["I will study tomorrow","déanfaidh mé staidéar amárach","DAYN-hih may STAH-der uh-MAW-rakh"],["we went to the park","chuamar go dtí an pháirc","KHOO-ah-mur guh jee un FAWRK"],["I saw him","chonaic mé é","KHUN-ik may ay"],["she wrote a letter","scríobh sí litir","shkreev shee LIT-ir"]]},{"id":"commands","title":"Commands","text":["One person: the bare stem (tar, suigh). Many: add -aigí or -ígí (tagaigí, suígí). To forbid, put \"ná\" in front: ná téigh."],"rows":[["come!","tar!","tar"],["come! (formal or plural)","tagaigí!","TAG-ig-ee"],["wait!","fan!","fan"],["do not go","ná téigh","naw tay"]],"ex":[["come here","tar anseo","tar un-SHUH"],["do not come here","ná tar anseo","naw tar un-SHUH"],["sit down","suigh síos","sig sheess"],["do not sit down","ná suigh síos","naw sig sheess"],["be quiet","bí ciúin","bee kyoon"],["do not be late","ná bí déanach","naw bee DAY-nakh"],["open the door","oscail an doras","UST-kal un DUR-us"],["close the window","dún an fhuinneog","doon un IN-ohg"],["listen to me","éist liom","aysht lum"],["do not worry","ná bí buartha","naw bee BOOR-huh"],["speak slowly","labhair go mall","LOW-ir guh mawl"],["wait a moment","fan nóiméad","fan NOH-mayd"]]},{"id":"can-must-want","title":"Can, must, want","text":["\"Is féidir liom\" (I can) or \"tá mé in ann\" (I am able). \"Caithfidh mé\" (I must). \"Ba mhaith liom\" (I would like), \"ag iarraidh\" (wanting): tá mé ag iarraidh."],"rows":[["I can swim","is féidir liom snámh","iss FAY-dir lum snawv"],["I must go","caithfidh mé dul","KAH-hih may dul"],["I want to go","ba mhaith liom dul","bah wah lum dul"],["may I?","an bhfuil cead agam?","un will kyad AG-um"]],"ex":[["I can swim","is féidir liom snámh","iss FAY-dir lum snawv"],["I cannot swim","ní féidir liom snámh","nee FAY-dir lum snawv"],["can you help me?","an féidir leat cabhrú liom?","un FAY-dir lat KOW-roo lum"],["we must go","caithfimid dul","KAH-hih-mid dul"],["we must not go","níor cheart dúinn dul","neer kyart DOO-in dul"],["I want to eat","ba mhaith liom ithe","bah wah lum IH-heh"],["I do not want to eat","níor mhaith liom ithe","neer wah lum IH-heh"],["you can come","is féidir leat teacht","iss FAY-dir lat tyakht"],["you cannot come","ní féidir leat teacht","nee FAY-dir lat tyakht"],["she wants to study","tá sí ag iarraidh staidéar a dhéanamh","taw shee ug EE-ar-ig STAH-der uh YAY-nuv"],["I must work today","caithfidh mé obair inniu","KAH-hih may UB-ir in-YOO"],["you must not run","níor cheart duit rith","neer kyart gwitch rih"]]},{"id":"in-on-at","title":"In, on, at","text":["Irish has small words that join with pronouns: \"i\" (in), \"ar\" (on), \"ag\" (at), \"faoi\" (under), \"in aice le\" (next to), \"gar do\" (near). \"I\" becomes \"sa\" before \"an\": sa teach (in the house)."],"rows":[["in the house","sa teach","suh tyakh"],["on the table","ar an mbord","er un mord"],["under the table","faoi bhun an bhoird","fwee vun un vwird"],["at school","ar scoil","er skul"]],"ex":[["the book is on the table","tá an leabhar ar an mbord","taw un LYOW-ur er un mord"],["the cat is under the table","tá an cat faoin mbord","taw un kat fween mord"],["I am at school","tá mé ar scoil","taw may er skul"],["I am at home","tá mé sa bhaile","taw may suh WAL-eh"],["the shop is next to the bank","tá an siopa in aice leis an mbanc","taw un SHUP-uh in AK-eh lesh un mangk"],["the park is near the station","tá an pháirc gar don stáisiún","taw un FAWRK gar dun STAW-shoon"],["we meet in the morning","buaileann muid le chéile ar maidin","BOO-il-un mwid leh KHAY-leh er MAH-jin"],["the lesson is at nine","tá an ceacht ar a naoi a chlog","taw un kyakht er uh NEE uh khlug"],["the key is in the bag","tá an eochair sa mhála","taw un OKH-ir suh WAW-luh"]]},{"id":"comparing-things","title":"Comparing things","text":["Put \"níos\" before the adjective for \"more\": níos mó (bigger), níos fearr (better). For \"the most\", use \"is\": is mó (the biggest). \"Than\" is \"ná\"."],"rows":[["big, bigger","mór, níos mó","more, nees moh"],["good, better","maith, níos fearr","mah, nees fyar"],["small, smaller","beag, níos lú","byug, nees loo"],["the biggest","is mó","iss moh"]],"ex":[["big, bigger, the biggest","mór, níos mó, is mó","more, nees moh, iss moh"],["small, smaller, the smallest","beag, níos lú, is lú","byug, nees loo, iss loo"],["this is better than that","tá seo níos fearr ná sin","taw shuh nees fyar naw shin"],["this is worse than that","tá seo níos measa ná sin","taw shuh nees MAS-uh naw shin"],["she is taller than me","tá sí níos airde ná mise","taw shee nees AR-jeh naw MISH-uh"],["Tashkent is bigger than Samarkand","tá Tashkent níos mó ná Samarkand","taw tash-KENT nees moh naw sa-mar-KAND"],["it is the cheapest","is é an ceann is saoire é","iss ay un kyoun iss SEER-eh ay"],["the same as","mar an gcéanna le","mar un GAY-nuh leh"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Quick sentences to copy and change."],"rows":[["I am hungry","tá ocras orm","taw UK-rus UR-um"],["I am thirsty","tá tart orm","taw tart UR-um"],["I am cold","tá fuacht orm","taw FOO-akht UR-um"],["it is raining","tá sé ag cur báistí","taw shay ug kur BAWSH-tee"]],"ex":[["he is a teacher","is múinteoir é","iss MOON-chor ay"],["you (plural) are students","is mic léinn sibh","iss mik layn shiv"],["I am happy","tá mé sásta","taw may SAWS-tuh"],["she is at school","tá sí ar scoil","taw shee er skul"],["you are my friend","is tú mo chara","iss too muh KHAR-uh"],["it is cold","tá sé fuar","taw shay FOO-ur"],["I study English","déanaim staidéar ar an mBéarla","DAY-nim STAH-der er un MAYR-luh"],["he teaches maths","múineann sé matamaitic","MOO-nun shay MAT-uh-mat-ik"],["they work every day","oibríonn siad gach lá","UB-ree-un SHEE-ud gakh law"],["is this your book?","an é seo do leabhar?","un ay shuh duh LYOW-ur"],["are they here?","an bhfuil siad anseo?","un will SHEE-ud un-SHUH"],["do you like tea?","an maith leat tae?","un mah lat tay"],["what time is it?","cén t-am é?","kayn tam ay"],["whose book is this?","cé leis an leabhar seo?","kay lesh un LYOW-ur shuh"],["how old are you?","cén aois thú?","kayn eesh hoo"],["how do you say it?","conas a deir tú é?","KUN-us uh der too ay"],["your book (formal)","bhur leabhar","vur LYOW-ur"],["their house","a dteach","uh dyakh"],["my phone","mo ghuthán","muh GHOO-hawn"],["excuse me, sir","gabh mo leithscéal, a dhuine uasail","gow muh LESH-kayl, uh GWIN-eh OO-ush-il"],["please sit down (formal)","suígí síos, le do thoil","SEE-gee sheess, leh duh HUL"],["come here (informal)","tar anseo","tar un-SHUH"],["yesterday I was tired","inné, bhí mé tuirseach","in-AY, vee may TIR-shakh"],["I will study tomorrow","déanfaidh mé staidéar amárach","DAYN-hih may STAH-der uh-MAW-rakh"],["we went to the park","chuamar go dtí an pháirc","KHOO-ah-mur guh jee un FAWRK"]]}],"name":"Irish (Gaeilge)","id":"ga","flag":"ie","note":""}