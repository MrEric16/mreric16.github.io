,"ic ġiefe"]]},{"id":"nature-and-world","title":"Nature and world","items":[["sun","sunne","SUN-neh","sunne"],["moon","mōna","MOH-nah","mōna"],["star","steorra","STEH-or-rah","steorra"],["sky","heofon","HEH-oh-von","heofon"],["earth","eorðe","EH-or-theh","eorðe"],["sea","sǣ","sah","sǣ"],["river","ēa","ay-ah","ēa"],["mountain","beorg","beh-ORG","beorg"],["tree","trēow","TRAY-ow","trēow"],["flower","blōstma","BLOHST-mah","blōstma"],["fire","fȳr","fewr","fȳr"],["water","wæter","WAT-er","wæter"],["wind","wind","wind","wind"],["rain","regn","rayn","regn"],["snow","snāw","snahw","snāw"],["night","niht","nikht","niht"],["day","dæġ","day","dæġ"],["year","ġēar","yay-ar","ġēar"],["winter","winter","WIN-ter","winter"],["summer","sumor","SUM-or","sumor"],["field","feld","feld","feld"],["forest","wudu","WOO-doo","wudu"],["stone","stān","stahn","stān"],["road","weġ","way","weġ"],["town","burg","boorg","burg"]]},{"id":"animals","title":"Animals","items":[["horse","hors","hors","hors"],["dog","hund","hoond","hund"],["cow","cū","koo","cū"],["sheep","scēap","shay-ap","scēap"],["pig","swīn","sween","swīn"],["wolf","wulf","woolf","wulf"],["bird","fugol","FOO-gol","fugol"],["fish","fisc","fish","fisc"],["bear","bera","BEH-rah","bera"]]},{"id":"body","title":"Body","items":[["head","hēafod","HAY-ah-vod","hēafod"],["eye","ēage","AY-ah-yeh","ēage"],["ear","ēare","AY-ah-reh","ēare"],["mouth","mūþ","mooth","mūþ"],["hand","hand","hand","hand"],["foot","fōt","foht","fōt"],["heart","heorte","HEH-or-teh","heorte"],["blood","blōd","blohd","blōd"],["bone","bān","bahn","bān"]]},{"id":"people","title":"People","items":[["man (male)","wer","wehr","wer"],["woman","wīf","weef","wīf"],["child","ċild","child","ċild"],["son","sunu","SOO-noo","sunu"],["daughter","dohtor","DOKH-tor","dohtor"],["brother","brōþor","BROH-thor","brōþor"],["sister","sweostor","SWEH-os-tor","sweostor"],["mother","mōdor","MOH-dor","mōdor"],["friend","frēond","FRAY-ond","frēond"],["king","cyning","KEW-ning","cyning"],["lord","hlāford","HLAH-ford","hlāford"],["warrior","cempa","KEM-pah","cempa"],["priest","prēost","PRAY-ost","prēost"]]},{"id":"things","title":"Things","items":[["book","bōc","bohk","bōc"],["word","word","word","word"],["name","nama","NAH-mah","nama"],["hall","heall","HEH-al","heall"],["sword","swurd","swoord","swurd"],["ship","scip","ship","scip"],["bread","hlāf","hlahf","hlāf"],["ale","ealu","EH-ah-loo","ealu"],["meat","flǣsc","flash","flǣsc"],["gold","gold","gold","gold"],["war","wīġ","weey","wīġ"],["peace","frið","frith","frið"],["life","līf","leef","līf"],["death","dēaþ","day-ath","dēaþ"]]},{"id":"verbs-more","title":"Verbs (more)","items":[["I go","ic gā","ik gah","ic gā"],["I come","ic cume","ik KOO-meh","ic cume"],["I eat","ic ete","ik EH-teh","ic ete"],["I drink","ic drince","ik DRIN-cheh","ic drince"],["I speak","ic sprece","ik SPREH-cheh","ic sprece"],["I say","ic secge","ik SEH-jeh","ic secge"],["I give","ic ġiefe","ik YEE-eh-veh","ic ġiefe"],["I know","ic wāt","ik waht","ic wāt"],["I sleep","ic slǣpe","ik SLAH-peh","ic slǣpe"],["I fight","ic feohte","ik FEH-okh-teh","ic feohte"],["I love","ic luf(i)ge","ik LOO-vi-yeh","ic lufie"],["I live","ic līfe","ik LEE-veh","ic līfie"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Old English has \"ic\" (I), \"þū\" (you, one person), \"hē\" (he), \"hēo\" (she), \"hit\" (it), \"wē\" (we), \"ġē\" (you, plural), \"hīe\" (they). There is also a dual \"wit\" (we two) and \"ġit\" (you two)."],"rows":[["I","ic","ik"],["you (one)","þū","thoo"],["he","hē","hay"],["she","hēo","HAY-oh"],["it","hit","hit"],["we","wē","way"],["you (plural)","ġē","yay"],["they","hīe","HEE-eh"]],"ex":[["I am a man","ic eom mann","ik ay-om mahn"],["you are strong","þū eart strang","thoo ehrt strahng"],["he is a king","hē is cyning","hay is KUN-ing"],["she is a woman","hēo is wīf","HAY-oh is weef"],["we are friends","wē sind frēond","way sind FRAY-ond"]]},{"id":"to-be-b-on","title":"To be: bēon","text":["The present of \"to be\": eom, eart, is, sind (or sindon). Learn all of them: ic eom, þū eart, hē is, wē sind, ġē sind, hīe sind."],"rows":[["I am","eom","ay-om"],["you are","eart","ehrt"],["he / she is","is","is"],["we are","sind","sind"],["you are (plural)","sind","sind"],["they are","sind","sind"]],"ex":[["I am here","ic eom hēr","ik ay-om hair"],["the king is good","se cyning is gōd","seh KUN-ing is gohd"],["they are brothers","hīe sind brōþor","HEE-eh sind BROH-thor"]]},{"id":"negation","title":"Negation","text":["Put \"ne\" before the verb: ic ne wāt (I know not). Some verbs join with \"ne\": nis (is not), næs (was not), nolde (would not)."],"rows":[["not","ne","neh"]],"ex":[["I know","ic wāt","ik waht"],["I do not know","ic ne wāt","ik neh waht"],["he is good","hē is gōd","hay is gohd"],["he is not good","hē nis gōd","hay nis gohd"]]},{"id":"commands","title":"Commands","text":["The command is the bare stem: cum (come), far (go), wes (be). Plural adds -aþ: cumaþ."],"rows":[["come!","cum","koom"],["go!","far","fahr"],["be!","wes","wes"]],"ex":[["come here","cum hider","koom HI-der"],["be well","wes hāl","wes hahl"],["go","far","fahr"]]}],"name":"Old English","id":"ang","flag":"en","note":""}