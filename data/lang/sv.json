chool","title":"Work and school","items":[["job","jobb","yob"],["office","kontor","kon-TOOR"],["doctor","läkare","LEH-kah-reh"],["engineer","ingenjör","in-sheh-NYUR"],["driver","förare","FUR-rah-reh"],["worker","arbetare","AR-beh-tah-reh"],["boss","chef","shef"],["salary","lön","lun"],["meeting","möte","MUR-teh"],["company","företag","FUR-eh-tahg"],["lawyer","advokat","ad-voo-KAHT"],["nurse","sjuksköterska","SHEWK-shur-ter-skah"],["cook","kock","kok"],["farmer","bonde","BON-deh"]]},{"id":"describing","title":"Describing","items":[["big","stor","stoor"],["small","liten","LEE-ten"],["good","bra","brah"],["bad","dålig","DOH-lig"],["new","ny","new"],["old","gammal","GAM-mal"],["hot (temperature)","varm","varm"],["cold (temperature)","kall","kal"],["fast","snabb","snab"],["slow","långsam","LONG-sam"],["easy","enkel","EN-kel"],["difficult","svår","svohr"],["beautiful","vacker","VAK-ker"],["ugly","ful","fewl"],["tall","lång","long"],["short","kort","kort"],["heavy","tung","tung"],["light (weight)","lätt","let"],["expensive","dyr","dewr"],["cheap","billig","BIL-lig"]]},{"id":"common-verbs","title":"Common verbs","items":[["to be","vara","VAH-rah"],["to ask","fråga","FROH-gah"],["to go","gå","goh"],["to come","komma","KOM-mah"],["to see","se","seh"],["to eat","äta","EH-tah"],["to drink","dricka","DRIK-kah"],["to sleep","sova","SOO-vah"],["to speak","tala","TAH-lah"],["to know","veta","VEH-tah"],["to want","vilja","VIL-yah"],["to give","ge","yeh"],["to take","ta","tah"],["to buy","köpa","CHUR-pah"],["to sell","sälja","SEL-yah"],["to read","läsa","LEH-sah"],["to write","skriva","SKREE-vah"],["to work","arbeta","AR-beh-tah"],["to live","bo","boo"],["to love","älska","EL-skah"],["to like","gilla","YIL-lah"],["to wait","vänta","VEN-tah"],["to open","öppna","UP-nah"],["to close","stänga","STENG-ah"],["to say","säga","SEH-yah"]]},{"id":"school-subjects","title":"School subjects","items":[["maths","matematik","ma-teh-ma-TEEK"],["physics","fysik","few-SEEK"],["chemistry","kemi","cheh-MEE"],["biology","biologi","bee-oo-loo-GEE"],["history","historia","his-TOO-ree-ah"],["geography","geografi","yeh-oo-gra-FEE"],["literature","litteratur","lit-teh-ra-TEWR"],["English","engelska","ENG-el-skah"],["Swedish language","svenska","SVEN-skah"],["Russian language","ryska","REWS-kah"],["foreign languages","främmande språk","FREM-man-deh sprohk"],["art","konst","konst"],["music","musik","mew-SEEK"],["PE","gymnastik","yewm-na-STEEK"],["computer science","datakunskap","DAH-ta-kun-skap"],["economics","ekonomi","eh-koo-noo-MEE"],["law","juridik","yew-ree-DEEK"],["philosophy","filosofi","fee-loo-soo-FEE"],["psychology","psykologi","sew-koo-loo-GEE"],["science","vetenskap","VEH-ten-skap"]]},{"id":"classroom","title":"Classroom","items":[["classroom","klassrum","KLAS-rum"],["desk","skrivbord","SKREEV-boord"],["board","tavla","TAV-lah"],["notebook","anteckningsbok","an-TEK-nings-book"],["textbook","lärobok","LEH-roo-book"],["homework","läxa","LEK-sah"],["test","prov","proov"],["grade","betyg","beh-TEWG"],["timetable","schema","SHEH-mah"],["break","rast","rast"],["bell","klocka","KLOK-kah"],["ruler","linjal","lin-YAHL"],["rubber","suddgummi","SUD-gum-mee"],["rucksack","ryggsäck","REWG-sek"],["dictionary","ordbok","OORD-book"],["question","fråga","FROH-gah"],["answer","svar","svahr"],["mistake","fel","fehl"],["pen","penna","PEN-nah"],["pencil","blyertspenna","BLEW-erts-pen-nah"]]},{"id":"university","title":"University","items":[["university","universitet","ew-ni-ver-si-TEHT"],["lecture","föreläsning","FUR-eh-leh-sning"],["professor","professor","proo-FES-soor"],["degree","examen","ek-SAH-men"],["scholarship","stipendium","sti-PEN-di-um"],["library","bibliotek","bib-lee-oo-TEHK"],["dormitory","studentbostad","stew-DENT-boo-stad"],["campus","campus","KAM-pus"],["tuition fees","terminsavgift","TAIR-mins-ahv-yift"],["semester","termin","tair-MEEN"],["course","kurs","kurs"],["essay","uppsats","UP-sats"],["thesis","avhandling","AHV-hand-ling"],["diploma","diplom","dee-PLOOM"],["seminar","seminarium","seh-mi-NAH-ri-um"],["entrance exam","antagningsprov","AN-tahg-nings-proov"],["application","ansökan","AN-suh-kan"],["student card","studentkort","stew-DENT-kort"],["faculty","fakultet","fa-kul-TEHT"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","studera","stew-DEH-rah"],["to teach","undervisa","UN-der-vee-sah"],["to ask","fråga","FROH-gah"],["to answer","svara","SVAH-rah"],["to repeat","upprepa","UP-pray-pah"],["to understand","förstå","fur-SHTOH"],["to remember","komma ihåg","KOM-mah ee-HOHG"],["to forget","glömma","GLUM-mah"],["to explain","förklara","fur-KLAH-rah"],["to practise","öva","UR-vah"],["to pass an exam","klara ett prov","KLAH-rah et proov"],["to fail an exam","misslyckas på ett prov","MIS-lew-kas poh et proov"],["to write down","skriva ner","SKREE-vah nair"],["to listen","lyssna","LEWS-nah"],["to read aloud","läsa högt","LEH-sah hurgt"],["to think","tänka","TEN-kah"],["to count","räkna","REK-nah"],["to spell","stava","STAH-vah"],["to translate","översätta","UR-ver-set-tah"],["to graduate","ta examen","tah ek-SAH-men"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Swedish always uses the pronoun. \"Du\" is you, \"ni\" is the polite or plural you. \"Han\" is he, \"hon\" is she, \"det\" or \"den\" is it."],"rows":[["I","jag","yah"],["you (informal)","du","dew"],["he / she / it","han / hon / det","han / hoon / deh"],["we","vi","vee"],["you (formal or plural)","ni","nee"],["they","de","dom"]],"ex":[["I am a student","jag är student","yah air stew-DENT"],["you are tall","du är lång","dew air long"],["she is my older sister","hon är min storasyster","hoon air min STOO-rah-sews-ter"],["we are friends","vi är vänner","vee air VEN-ner"],["they are teachers","de är lärare","dom air LEH-rah-reh"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Nouns are \"en\" words or \"ett\" words. There are five plural endings: -ar, -or, -er, -n, or no ending. Learn the plural with each noun."],"rows":[["en bil (car)","bilar","BEE-lar"],["en flicka (girl)","flickor","FLIK-kor"],["en bok (book)","böcker","BUK-er"],["ett hus (house)","hus","hews"]],"ex":[["one house, houses","ett hus, flera hus","et hews FLEH-rah hews"],["one book, books","en bok, böcker","en book BUK-er"],["one cat, cats","en katt, katter","en kat KAT-ter"],["two books","två böcker","tvoh BUK-er"],["the children","barnen","BAR-nen"]]},{"id":"to-be-vara","title":"To be: vara","text":["\"Vara\" (to be) has one form for everyone in the present: är."],"rows":[["I am","jag är","yah air"],["you are","du är","dew air"],["he / she is","han är","han air"],["we are","vi är","vee air"],["you are (formal)","ni är","nee air"],["they are","de är","dom air"]],"ex":[["I am a student","jag är student","yah air stew-DENT"],["you are tired","du är trött","dew air trut"],["he is a doctor","han är läkare","han air LEH-kah-reh"],["we are happy","vi är glada","vee air GLAH-dah"],["they are at home","de är hemma","dom air HEM-mah"]]},{"id":"ha-have","title":"Ha: have","text":["\"Att ha\" (to have) is \"har\" in the present for everyone. \"Det finns\" means \"there is\"."],"rows":[["I have","jag har","yah hahr"],["you have","du har","dew hahr"],["he / she has","han har","han hahr"],["we have","vi har","vee hahr"],["you have (formal)","ni har","nee hahr"],["they have","de har","dom hahr"]],"ex":[["I have an older brother","jag har en storebror","yah hahr en STOO-reh-broor"],["I have a car","jag har en bil","yah hahr en beel"],["I do not have time","jag har inte tid","yah hahr IN-teh teed"],["there is a problem","det finns ett problem","deh fins et proo-BLEHM"],["there is no water","det finns inget vatten","deh fins ING-et VAT-ten"]]},{"id":"present-tense","title":"Present tense","text":["Take the stem and add -ar, -er or -r. Arbeta (to work): jag arbetar. The ending is the same for every person."],"rows":[["I work","jag arbetar","yah AR-beh-tar"],["you work","du arbetar","dew AR-beh-tar"],["he / she works","han arbetar","han AR-beh-tar"],["we work","vi arbetar","vee AR-beh-tar"],["you work (formal)","ni arbetar","nee AR-beh-tar"],["they work","de arbetar","dom AR-beh-tar"]],"ex":[["I am eating bread","jag äter bröd","yah EH-ter brud"],["you are reading a book","du läser en bok","dew LEH-ser en book"],["she works in a bank","hon arbetar på en bank","hoon AR-beh-tar poh en bank"],["we drink tea","vi dricker te","vee DRIK-er teh"],["they are sleeping","de sover","dom SOO-ver"]]},{"id":"basic-sentences","title":"Basic sentences","text":["The verb is always the second item: Jag läser en bok. If another word comes first, the verb still stays second: Idag läser jag en bok."],"rows":[["I read a book","jag läser en bok","yah LEH-ser en book"],["she drinks tea","hon dricker te","hoon DRIK-er teh"],["we go to school","vi går till skolan","vee gohr til SKOO-lan"]],"ex":[["I read a book","jag läser en bok","yah LEH-ser en book"],["he drinks tea","han dricker te","han DRIK-er teh"],["we go to school","vi går till skolan","vee gohr til SKOO-lan"],["they eat bread","de äter bröd","dom EH-ter brud"],["the teacher writes","läraren skriver","LEH-rah-ren SKREE-ver"]]},{"id":"negation","title":"Negation","text":["Put \"inte\" after the verb: Jag går inte. In questions and with a second verb, \"inte\" comes after the subject."],"rows":[["I go","jag går","yah gohr"],["I do not go","jag går inte","yah gohr IN-teh"],["is","är","air"],["is not","är inte","air IN-teh"]],"ex":[["I want","jag vill","yah vil"],["I do not want","jag vill inte","yah vil IN-teh"],["I speak English","jag talar engelska","yah TAH-lar ENG-el-skah"],["I do not speak English","jag talar inte engelska","yah TAH-lar IN-teh ENG-el-skah"],["I like it","jag gillar det","yah YIL-lar deh"],["I do not like it","jag gillar inte det","yah YIL-lar IN-teh deh"],["she is here","hon är här","hoon air hair"],["she is not here","hon är inte här","hoon air IN-teh hair"],["I have a car","jag har en bil","yah hahr en beel"],["I do not have a car","jag har ingen bil","yah hahr ING-en beel"],["I understand","jag förstår","yah fur-SHTOHR"],["I do not understand","jag förstår inte","yah fur-SHTOHR IN-teh"],["we are tired","vi är trötta","vee air TRUT-tah"],["we are not tired","vi är inte trötta","vee air IN-teh TRUT-tah"],["he works on Sundays","han arbetar på söndagar","han AR-beh-tar poh SUN-dah-gar"],["he does not work on Sundays","han arbetar inte på söndagar","han AR-beh-tar IN-teh poh SUN-dah-gar"]]},{"id":"asking-questions","title":"Asking questions","text":["Put the verb first: Är du student? A question word goes before the verb: Var bor du?"],"rows":[["you are a student","du är student","dew air stew-DENT"],["are you a student?","är du student?","air dew stew-DENT"],["he is here","han är här","han air hair"],["is he here?","är han här?","air han hair"]],"ex":[["is this your book?","är det här din bok?","air deh hair din book"],["are they here?","är de här?","air dom hair"],["do you like tea?","gillar du te?","YIL-lar dew teh"],["is it cold?","är det kallt?","air deh kalt"],["do you speak English?","talar du engelska?","TAH-lar dew ENG-el-skah"]]},{"id":"question-words","title":"Question words","text":["A question word comes first, then the verb."],"rows":[["what","vad","vahd"],["who","vem","vem"],["where","var","vahr"],["when","när","nair"],["why","varför","VAR-fur"],["how","hur","hewr"],["how much","hur mycket","hewr MEW-keh"],["which","vilken","VIL-ken"]],"ex":[["what is your name?","vad heter du?","vahd HAY-ter dew"],["who is he?","vem är han?","vem air han"],["where do you live?","var bor du?","vahr boor dew"],["when is the lesson?","när är lektionen?","nair air lek-SHOO-nen"],["why are you late?","varför är du sen?","VAR-fur air dew sayn"],["how much is it?","hur mycket kostar det?","hewr MEW-keh KOS-tar deh"],["which book?","vilken bok?","VIL-ken book"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["The word agrees with the noun: min / mitt / mina (my), din / ditt / dina (your), hans, hennes, vår / vårt / våra (our), er / ert / era (your, formal), deras (their). To like something, use \"gilla\"."],"rows":[["my book","min bok","min book"],["your book","din bok","din book"],["his / her book","hans bok / hennes bok","hans book / HEN-nes book"],["our book","vår bok","vohr book"],["your book (formal)","er bok","air book"]],"ex":[["my phone","min telefon","min teh-leh-FOON"],["your house (formal)","ert hus","airt hews"],["his sister","hans syster","hans SEWS-ter"],["I like music","jag gillar musik","yah YIL-lar mew-SEEK"],["I love football","jag älskar fotboll","yah EL-skar FOOT-bol"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Swedish almost always uses \"du\", even with strangers and older people. \"Ni\" is rare and can sound stiff. Use \"du\" unless you are sure."],"rows":[["how are you?","hur mår du? / hur mår ni?","hewr MOHR dew / hewr MOHR nee"],["you speak","du talar / ni talar","dew TAH-lar / nee TAH-lar"],["your name","ditt namn / ert namn","dit namn / airt namn"]],"ex":[["how are you? (informal)","hur mår du?","hewr MOHR dew"],["how are you? (formal)","hur mår ni?","hewr MOHR nee"],["where are you going? (informal)","vart går du?","vart gohr dew"],["where are you going? (formal)","vart går ni?","vart gohr nee"],["please sit down (formal)","sätt er, tack","set air, tak"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: add -ade, -de, -te, or a changed stem. Jag arbetade (I worked), jag gick (I went). Future: \"ska\" or \"kommer att\" + verb."],"rows":[["I went","jag gick","yah yik"],["you went","du gick","dew yik"],["he went","han gick","han yik"],["we went","vi gick","vee yik"]],"ex":[["yesterday I was tired","igår var jag trött","ee-GOHR vahr yah trut"],["I will study tomorrow","jag ska studera imorgon","yah skah stew-DEH-rah ee-MOR-ron"],["we went to the park","vi gick till parken","vee yik til PAR-ken"],["I saw him","jag såg honom","yah sohg HOO-nom"],["she wrote a letter","hon skrev ett brev","hoon skrehv et brehv"]]},{"id":"commands","title":"Commands","text":["Informal: the bare stem (kom). Formal: the same, with \"tack\" to be polite. To forbid, use \"inte\" or \"ingen\"."],"rows":[["come (informal)","kom","kom"],["come (formal)","kom, tack","kom, tak"],["do not come","kom inte","kom IN-teh"],["sit down","sätt dig","set day"]],"ex":[["come here","kom hit","kom heet"],["do not come here","kom inte hit","kom IN-teh heet"],["sit down","sätt dig","set day"],["do not sit down","sätt dig inte","set day IN-teh"],["be quiet","var tyst","vahr tewst"],["do not be late","kom inte för sent","kom IN-teh fur sehnt"],["open the door","öppna dörren","UP-nah DUR-ren"],["close the window","stäng fönstret","steng FUN-stret"],["listen to me","lyssna på mig","LEWS-nah poh may"],["do not worry","oroa dig inte","OO-roo-ah day IN-teh"],["speak slowly","tala långsamt","TAH-lah LONG-samt"],["wait a moment","vänta ett ögonblick","VEN-tah et UR-gon-blik"]]},{"id":"can-must-want","title":"Can, must, want","text":["Kunna (can): jag kan. Måste (must): jag måste. Vilja (want): jag vill. The second verb stays in its basic form."],"rows":[["I can swim","jag kan simma","yah kan SIM-mah"],["I cannot swim","jag kan inte simma","yah kan IN-teh SIM-mah"],["I must go","jag måste gå","yah MOS-teh goh"],["I want to go","jag vill gå","yah vil goh"]],"ex":[["I can swim","jag kan simma","yah kan SIM-mah"],["I cannot swim","jag kan inte simma","yah kan IN-teh SIM-mah"],["can you help me?","kan du hjälpa mig?","kan dew YEL-pah may"],["we must go","vi måste gå","vee MOS-teh goh"],["we must not go","vi får inte gå","vee fohr IN-teh goh"],["I want to eat","jag vill äta","yah vil EH-tah"],["I do not want to eat","jag vill inte äta","yah vil IN-teh EH-tah"],["you can come","du kan komma","dew kan KOM-mah"],["you cannot come","du kan inte komma","dew kan IN-teh KOM-mah"],["she wants to study","hon vill studera","hoon vil stew-DEH-rah"],["I must work today","jag måste arbeta idag","yah MOS-teh AR-beh-tah ee-DAHG"],["you must not run","du får inte springa","dew fohr IN-teh SPRING-ah"]]},{"id":"in-on-at","title":"In, on, at","text":["Common words: i (in), på (on, at), vid (at, by), till (to), från (from), med (with), under (under)."],"rows":[["in","i","ee"],["on / at","på","poh"],["to","till","til"],["from","från","frohn"]],"ex":[["the book is on the table","boken ligger på bordet","BOO-ken LIG-ger poh BOO-ret"],["the cat is under the table","katten är under bordet","KAT-ten air UN-der BOO-ret"],["I am at school","jag är i skolan","yah air ee SKOO-lan"],["I am at home","jag är hemma","yah air HEM-mah"],["the shop is next to the bank","butiken ligger bredvid banken","bew-TEE-ken LIG-ger bred-VEED BANG-ken"],["the park is near the station","parken ligger nära stationen","PAR-ken LIG-ger NAIR-ah sta-SHOO-nen"],["we meet in the morning","vi ses på morgonen","vee sehs poh MOR-ron-en"],["the lesson is at nine","lektionen är klockan nio","lek-SHOO-nen air KLOK-kan NEE-oh"],["the key is in the bag","nyckeln är i väskan","NEW-keln air ee VES-kan"]]},{"id":"comparing-things","title":"Comparing things","text":["Add -are for \"more\", -ast for \"the most\": stor, större, störst (irregular). Many adjectives: snabb, snabbare, snabbast. \"Than\" is \"än\"."],"rows":[["big, bigger, the biggest","stor, större, störst","stoor, STUR-rer, sturst"],["small, smaller, the smallest","liten, mindre, minst","LEE-ten, MIN-dreh, minst"]],"ex":[["big, bigger, the biggest","stor, större, störst","stoor STUR-rer sturst"],["small, smaller, the smallest","liten, mindre, minst","LEE-ten MIN-dreh minst"],["this is better than that","det här är bättre än det där","deh hair air BET-treh en deh dair"],["this is worse than that","det här är sämre än det där","deh hair air SEM-reh en deh dair"],["she is taller than me","hon är längre än jag","hoon air LENG-reh en yah"],["Tashkent is bigger than Samarkand","Tasjkent är större än Samarkand","tash-KENT air STUR-rer en sa-mar-KAND"],["it is the cheapest","det är billigast","deh air BIL-lig-ast"],["the same as","samma som","SAM-mah som"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Quick sentences to copy and change."],"rows":[],"ex":[["he is a teacher","han är lärare","han air LEH-rah-reh"],["you (plural) are students","ni är studenter","nee air stew-DEN-ter"],["I am happy","jag är glad","yah air glahd"],["she is at school","hon är i skolan","hoon air ee SKOO-lan"],["you are my friend","du är min vän","dew air min ven"],["it is cold","det är kallt","deh air kalt"],["I study English","jag läser engelska","yah LEH-ser ENG-el-skah"],["he teaches maths","han undervisar i matematik","han UN-der-vee-sar ee ma-teh-ma-TEEK"],["they work every day","de arbetar varje dag","dom AR-beh-tar VAR-yeh dahg"],["is this your book?","är det här er bok?","air deh hair air book"],["are they here?","är de här?","air dom hair"],["do you like tea?","gillar du te?","YIL-lar dew teh"],["what time is it?","vad är klockan?","vahd air KLOK-kan"],["whose book is this?","vems bok är det här?","vems book air deh hair"],["how old are you?","hur gammal är du?","hewr GAM-mal air dew"],["how do you say it?","hur säger man det?","hewr SEH-ger man deh"],["your book (formal)","er bok","air book"],["their house","deras hus","DEH-ras hews"],["my phone","min telefon","min teh-leh-FOON"],["excuse me, sir","ursäkta, herrn","EWR-shek-tah, hairn"],["please sit down (formal)","sätt er, tack","set air, tak"],["come here (informal)","kom hit","kom heet"],["yesterday I was tired","igår var jag trött","ee-GOHR vahr yah trut"],["I will study tomorrow","jag ska studera imorgon","yah skah stew-DEH-rah ee-MOR-ron"],["we went to the park","vi gick till parken","vee yik til PAR-ken"]]}],"name":"Swedish","id":"sv","flag":"se","note":""}