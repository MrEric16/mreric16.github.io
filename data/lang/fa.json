d","sard","sard"],["sea","daryaa","dar-YAA"],["river","roodkhaane","rood-khaa-NEH"],["mountain","kooh","kooh"],["tree","derakht","de-RAKHT"],["flower","gol","gol"],["sky","aasemaan","aa-se-MAAN"]]},{"id":"work-and-school","title":"Work and school","items":[["teacher","mo'alem","mo-al-LEM"],["student","daaneshjoo","daa-nesh-JOO"],["book","ketaab","ke-TAAB"],["pen","khodkaar","khod-KAAR"],["pencil","medaad","me-DAAD"],["paper","kaaghaz","kaa-GHAZ"],["computer","kampiyuter","kam-pyoo-TER"],["phone","telefon","te-le-FON"],["work","kaar","kaar"],["office","daftar","daf-TAR"],["doctor","doktor","dok-TOR"],["police officer","polis","po-LEES"],["lesson","dars","dars"],["exam","emtehaan","em-te-HAAN"]]},{"id":"describing","title":"Describing","items":[["big","bozorg","bo-ZORG"],["small","koochak","koo-CHAK"],["good","khub","khoob"],["bad","bad","bad"],["new","jadid","ja-DEED"],["old","ghadimi","gha-dee-MEE"],["beautiful","ghashang","gha-SHANG"],["ugly","zesht","zesht"],["fast","sari'","sa-REE"],["slow","aahesteh","aa-hes-TEH"],["easy","aasaan","aa-SAAN"],["difficult","sakht","sakht"],["cheap","arzaan","ar-ZAAN"],["expensive","geron","ge-RON"],["clean","tamiz","ta-MEEZ"],["dirty","kasif","ka-SEEF"]]},{"id":"common-verbs","title":"Common verbs","items":[["to be","budan","boo-DAN"],["to have","daashtan","daash-TAN"],["to go","raftan","raf-TAN"],["to want","khaastan","khaas-TAN"],["to eat","khordan","khor-DAN"],["to drink","nooshidan","noo-shee-DAN"],["to speak","sohbat kardan","soh-BAT kar-DAN"],["to see","didan","dee-DAN"],["to come","aamadan","aa-ma-DAN"],["to give","daadan","daa-DAN"],["to know","daanestan","daa-nes-TAN"],["to do / make","kardan","kar-DAN"],["to say","goftan","gof-TAN"],["to like","dust daashtan","doost daash-TAN"],["to live","zendegi kardan","zen-de-GEE kar-DAN"],["to work","kaar kardan","kaar kar-DAN"],["to buy","kharidan","kha-ree-DAN"],["to read","khaandan","khaan-DAN"],["to write","neveshtan","ne-vesh-TAN"],["to sleep","khaabidan","khaa-bee-DAN"],["to learn","yaad gereftan","yaad ge-ref-TAN"],["to help","komak kardan","ko-MAK kar-DAN"],["to need","niaz daashtan","nee-AAZ daash-TAN"],["to love","doost daashtan","doost daash-TAN"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Farsi has no gender: \"u\" means he, she or it. shomaa is polite \"you\" and plural \"you\"."],"rows":[["I","man","man"],["you (informal)","to","to"],["he / she","u","oo"],["we","maa","maa"],["you (formal / plural)","shomaa","sho-MAA"],["they","aanhaa","aan-HAA"]],"ex":[["I am a student","man daaneshjoo hastam","man daa-nesh-JOO has-TAM"],["you are tall","to ghad-bolandi","to ghad-bo-lan-DEE"],["she is my sister","u khaahar-e man-e","oo khaa-HAR-e man-EH"],["we are friends","maa doost hastim","maa doost has-TEEM"],["they are teachers","aanhaa mo'alem hastand","aan-HAA mo-al-LEM has-TAND"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Add -haa to most nouns (ketaab → ketaabhaa). For people, -aan is used too (daaneshjoo → daaneshjooyaan). After a number the noun stays singular: se ketaab."],"rows":[["book","ketaab → ketaabhaa","ke-TAAB-haa"],["friend","doost → doostaan","doo-STAAN"],["tree","derakht → derakht-haa","de-RAKHT-haa"],["after numbers","se ketaab","seh ke-TAAB"],["person","adam → adam-haa","a-DAM-haa"]],"ex":[["one book, books","yek ketaab, ketaabhaa","yek ke-TAAB ke-TAAB-haa"],["one friend, friends","yek doost, doostaan","yek doost doo-STAAN"],["three books","se ketaab","seh ke-TAAB"],["one house, houses","khaane, khaanehaa","khaa-NEH khaa-neh-HAA"],["one student, students","daaneshjoo, daaneshjooyaan","daa-nesh-JOO daa-nesh-joo-YAAN"]]},{"id":"budan-to-be","title":"Budan: to be","text":[],"rows":[["I am","hastam","has-TAM"],["you are","hasti","has-TEE"],["he / she is","hast / -e","hast"],["we are","hastim","has-TEEM"],["you are (formal)","hastid","has-TEED"],["they are","hastand","has-TAND"]],"ex":[["I am English","man engelisi hastam","man en-ge-lee-SEE has-TAM"],["he is a doctor","u doktor-e","oo dok-TOR-eh"],["we are tired","maa khaste hastim","maa khas-TEH has-TEEM"],["are you from Tehran?","shomaa az tehran hastid?","sho-MAA az teh-RAAN has-TEED"],["they are at home","aanhaa dar khaane hastand","aan-HAA dar khaa-NEH has-TAND"]]},{"id":"daashtan-to-have","title":"Daashtan: to have","text":[],"rows":[["I have","daaram","daa-RAM"],["you have","daari","daa-REE"],["he / she has","daarad / daare","daa-RAD"],["we have","daarim","daa-REEM"],["you have (formal)","daarid","daa-REED"],["they have","daarand","daa-RAND"]],"ex":[["I have a brother","man yek baraadar daaram","man yek ba-raa-DAR daa-RAM"],["she has two cats","u do gorbe daare","oo doh gor-BEH daa-REH"],["we have time","maa vaght daarim","maa vaght daa-REEM"],["do you have a pen?","khodkaar daarid?","khod-KAAR daa-REED"],["they have a car","aanhaa machin daarand","aan-HAA ma-SHEEN daa-RAND"]]},{"id":"regular-verbs-present-tense","title":"Regular verbs (present tense)","text":["mi- + stem + personal ending. Endings: -am, -i, -ad (-e), -im, -id, -and. Khordan (to eat), stem khor:"],"rows":[["man","mikhoram","mee-kho-RAM"],["to","mikhori","mee-kho-REE"],["u","mikhorad / mikhore","mee-kho-RAD"],["maa","mikhorim","mee-kho-REEM"],["shomaa","mikhorid","mee-kho-REED"],["aanhaa","mikhorand","mee-kho-RAND"]],"ex":[["I work in a bank","man dar baank kaar mikonam","man dar baank kaar mee-ko-NAM"],["you live in Tehran","to dar tehran zendegi mikoni","to dar teh-RAAN zen-de-GEE mee-ko-NEE"],["she reads a book","u ketaab mikhaand","oo ke-TAAB mee-khaa-NAD"],["we learn Farsi","maa farsi yaad migirim","maa far-SEE yaad mee-gee-REEM"],["they buy bread","aanhaa naan mikharand","aan-HAA naan mee-kha-RAND"]]},{"id":"raftan-to-go","title":"Raftan: to go","text":[],"rows":[["I go","miram","mee-RAM"],["you go","miri","mee-REE"],["he / she goes","mire","mee-REH"],["we go","mirim","mee-REEM"],["you go (formal)","mirid","mee-REED"],["they go","miran","mee-RAN"]],"ex":[["I am going to school","man be madrese miram","man be mad-re-SEH mee-RAM"],["where are you going?","koja miri?","ko-JAA mee-REE"],["we are going home","maa be khaane mirim","maa be khaa-NEH mee-REEM"],["she is going shopping","u baraaye kharid mire","oo ba-RAA-ye kha-REED mee-REH"],["let's go!","bargerim!","bar-ge-REEM"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Word order is subject, object, verb (verb last). Adjectives come after the noun with -e: khaane-ye bozorg."],"rows":[["subject + object + verb","Man naan mikhoram.","man naan mee-kho-RAM"],["noun + -e + adjective","khaane-ye bozorg","khaa-neh-YE bo-ZORG"],["add time or place","Man emrooz inja kaar mikonam.","man em-ROOZ een-JAA kaar mee-ko-NAM"]],"ex":[["I eat bread","man naan mikhoram","man naan mee-kho-RAM"],["Anna reads a book","Anna ketaab mikhaand","AN-na ke-TAAB mee-khaa-NAD"],["we live in a big house","maa dar khaane-ye bozorg zendegi mikonim","maa dar khaa-neh-YE bo-ZORG zen-de-GEE mee-ko-NEEM"],["he works here today","u emrooz inja kaar mikone","oo em-ROOZ een-JAA kaar mee-ko-NEH"],["the dog is black","sag siyaah-e","sag see-yaa-HEH"]]},{"id":"negation","title":"Negation","text":["Put na- (or ne- before mi-) before the verb. nemikhoram = I do not eat. Negative words go with the negative verb: hichi nemikhaam."],"rows":[["not","ne- / na- + verb","ne"],["nothing","hichi","hee-CHEE"],["nobody","hichkas","heech-KAS"],["never","hargez","har-GEZ"]],"ex":[]},{"id":"asking-questions","title":"Asking questions","text":["Farsi has no question-word for yes / no. Raise your voice at the end, or begin with aayaa (formal)."],"rows":[["statement","Shomaa englisi sohbat mikonid.","sho-MAA en-ge-lee-SEE soh-BAT mee-ko-NEED"],["question","Shomaa englisi sohbat mikonid?","sho-MAA en-ge-lee-SEE soh-BAT mee-ko-NEED"],["formal question","Aayaa shomaa englisi sohbat mikonid?","aa-YAA sho-MAA en-ge-lee-SEE soh-BAT mee-ko-NEED"]],"ex":[["do you speak English?","englisi sohbat mikonid?","en-ge-lee-SEE soh-BAT mee-ko-NEED"],["is she a doctor?","u doktor-e?","oo dok-TOR-eh"],["do you have a pen?","khodkaar daari?","khod-KAAR daa-REE"],["are you tired?","khaste-i?","khas-teh-YEE"],["is it far?","door-e?","door-EH"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["what","che / chi","che / chee"],["who","ki","kee"],["where","koja","ko-JAA"],["when","key","key"],["why","chera","che-RAA"],["how","chetor","che-TOR"],["which","kodaam","ko-DAAM"],["how much / how many","chand / chand ta","chand"]],"ex":[["what is this?","in chiye?","een chee-YEH"],["who is she?","u ki-ye?","oo kee-YEH"],["where do you live?","koja zendegi mikoni?","ko-JAA zen-de-GEE mee-ko-NEE"],["when is the exam?","emtehaan key-e?","em-te-HAAN key-EH"],["why are you late?","chera dir kardi?","che-RAA deer kar-DEE"],["how much is it?","in chand-e?","een chand-EH"]]},{"id":"possessives","title":"Possessives","text":["Add the ending to the noun: ketaab-am (my book). Endings: -am, -at, -esh, -emoon, -etoon, -eshoon."],"rows":[["my","-am","am"],["your (informal)","-at","at"],["his / her","-esh","esh"],["our","-emoon","e-MOON"],["your (formal)","-etoon","e-TOON"],["their","-eshoon","e-SHOON"]],"ex":[["my house","khaane-am","khaa-neh-AM"],["your friends","doostaan-at","doos-taan-AT"],["his sister","khaahar-esh","khaa-har-ESH"],["our teacher","mo'alem-emoon","mo-al-lem-e-MOON"],["my mother","maadar-am","maa-dar-AM"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["to / -i with friends, family. shomaa / -id with strangers and elders. Add aagha (Mr) or khaanom (Ms) before a name, or \"jaan\" (dear) after a close friend's name."],"rows":[["you, informal","to","to"],["you, formal","shomaa","sho-MAA"],["Mr","aagha","aa-GHAA"],["Ms","khaanom","khaa-NOM"],["dear (after name)","jaan","jaan"]],"ex":[["how are you? (informal)","chetori?","che-TOH-ree"],["how are you? (formal)","haal-e shomaa chetore?","haal-e sho-MAA che-TOH-reh"],["you speak (informal)","to sohbat mikoni","to soh-BAT mee-ko-NEE"],["you speak (formal)","shomaa sohbat mikonid","sho-MAA soh-BAT mee-ko-NEED"],["thank you, Mr Karimi","mersi, aagha-ye karimi","mer-SEE aa-GHAA-ye ka-ree-MEE"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: stem + -d / -t + ending (-am, -i, -, -im, -id, -and), no mi-. Future: khaahad + short infinitive; in speech the present is often used."],"rows":[["I went","raftam","raf-TAM"],["you went","rafti","raf-TEE"],["he / she went","raft","raft"],["we went","raftim","raf-TEEM"]],"ex":[["yesterday I worked","dirooz kaar kardam","dee-ROOZ kaar kar-DAM"],["she bought a book","u yek ketaab kharid","oo yek ke-TAAB kha-REED"],["I went home","man be khaane raftam","man be khaa-NEH raf-TAM"],["I will call you tomorrow","fardaa bahet zang mizanam","far-DAA ba-HET zang mee-za-NAM"],["we will eat at eight","saat-e hasht ghazaa mikhorim","saat-e hasht gha-ZAA mee-kho-REEM"]]}],"name":"Farsi","id":"fa","flag":"ir","script":"Persian","note":""}