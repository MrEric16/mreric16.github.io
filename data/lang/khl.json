ome","items":[["house","bayt"],["room","ghurfa"],["kitchen","matbakh"],["bathroom","hammaam"],["living room","majlis"],["door","baab"],["window","shubbaak"],["table","tawla"],["chair","kursi"],["bed","sireer"],["key","miftaah"],["garden","hadiiga"],["floor","ardh"],["wall","haa'it"],["air conditioner","mukayyif"]]},{"id":"clothes","title":"Clothes","items":[["long white robe (men)","kandoora"],["black cloak (women)","'abaaya"],["men's headdress","ghutra"],["women's headscarf","shayla"],["shirt","gamiis"],["trousers","bantaloon"],["dress","fustaan"],["shoes","hidhaa"],["sandals","na'aal"],["hat","burniita"],["glasses","nadhdhaara"],["bag","shanta"],["pocket","jeeb"]]},{"id":"town","title":"Town","items":[["street","shaari'"],["shop","dukkaan"],["market","sooq"],["mall","mool"],["bank","bank"],["hospital","mustashfa"],["school","madrasa"],["university","jaam'a"],["airport","matar"],["station","mahatta"],["bus","baas"],["car","sayyaara"],["taxi","taksi"],["restaurant","mat'am"],["mosque","masjid"],["bridge","jisr"],["beach","shaati'"],["desert","sahraa'"],["tower","burj"]]},{"id":"time","title":"Time","items":[["day","yoom"],["night","layl"],["morning","sabaah"],["evening","masaa'"],["week","usboo'"],["month","shahr"],["year","sana"],["Sunday","il-ahad"],["Monday","il-ithnain"],["Tuesday","ith-thalaatha"],["Wednesday","il-arbi'aa"],["Thursday","il-khamiis"],["Friday","ij-jum'a"],["Saturday","is-sabt"],["summer","is-sayf"],["winter","ish-shita"],["hour","saa'a"],["minute","digiiga"]]},{"id":"weather-and-nature","title":"Weather and nature","items":[["sun","shams"],["moon","gamar"],["rain","matar"],["wind","hawa"],["cloud","ghaym"],["hot","harr"],["cold","bard"],["humid","ratib"],["sea","bahr"],["mountain","jabal"],["sand","raml"],["tree","shajara"],["flower","warda"],["sky","sama"]]},{"id":"work-and-school","title":"Work and school","items":[["teacher (m)","mudarris"],["student (m)","taalib"],["book","kitaab"],["pen","galam"],["paper","waraga"],["computer","kombyootar"],["phone","telefoon"],["work","shughul"],["office","maktab"],["doctor","doktor"],["police","shurta"],["lesson","dars"],["exam","imtihaan"],["money","fuloos"],["boss","mudiir"]]},{"id":"describing","title":"Describing","items":[["big","kabiir"],["small","sagiir"],["good","zayn"],["bad","mu zayn"],["new","jadiid"],["old","gadiim"],["beautiful","jamiil"],["fast","sarii'"],["slow","batii'"],["easy","sahl"],["difficult","sa'b"],["clean","nadhiif"],["dirty","wisikh"],["happy","farhaan"],["sad","hazeen"],["tired","ta'baan"],["hungry","jaw'aan"],["thirsty","'atshaan"],["ill","mariidh"]]},{"id":"common-verbs-i","title":"Common verbs (I...)","items":[["I go","arooh"],["I come","aji"],["I eat","aakul"],["I drink","ashrab"],["I speak","ahki"],["I see","ashoof"],["I know","a'rif"],["I want","abgha"],["I do","asawwi"],["I say","agool"],["I live","askun"],["I work","ashtaghil"],["I buy","ashtari"],["I read","agra"],["I write","aktib"],["I sleep","anaam"],["I learn","at'allam"],["I help","asaa'id"],["I like","ahibb"],["I need","ahtaaj"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Gulf Arabic has separate words for you (m) and you (f). There is no word for \"am / is / are\" in the present: just put the pronoun and the word together."],"rows":[["I","ana"],["you (m)","inta"],["you (f)","inti"],["he","huwa"],["she","hiya"],["we","ihna"],["you all","intu"],["they","hum"]],"ex":[["I am a student","ana taalib"],["you are tall (m)","inta tawiil"],["she is my sister","hiya ukhti"],["we are friends","ihna asdigaa'"],["they are teachers","hum mudarrisiin"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Arabic has singular, dual (two) and plural. Many plurals are irregular, so learn them with the word. People often end in -iin, things in -aat."],"rows":[["two of something","add -ain (kitaab, kitaabain)"],["people (m)","add -iin (mudarris, mudarrisiin)"],["things (f)","add -aat (sayyaara, sayyaaraat)"]],"ex":[["book, books","kitaab, kutub"],["house, houses","bayt, buyoot"],["boy, boys","walad, awlaad"],["girl, girls","bint, banaat"],["friend, friends","sadiig, asdigaa'"],["car, cars","sayyaara, sayyaaraat"],["teachers (m)","mudarrisiin"],["two books","kitaabain"]]},{"id":"possessives-my-your","title":"Possessives: my, your...","text":["Add a short ending to the noun. The noun after it has no \"the\"."],"rows":[["my","-i (bayti = my house)"],["your (m)","-ak (baytak)"],["your (f)","-ich (baytich)"],["his","-ah (baytah)"],["her","-ha (baytha)"],["our","-na (baytna)"],["their","-hum (baythum)"]],"ex":[["my house","bayti"],["your name (m)","ismak"],["your car (f)","sayyaartich"],["his father","abuuh"],["our school","madrastna"]]},{"id":"there-is-i-have","title":"There is, I have","text":["Use \"fii\" for there is, and \"'ind\" + ending for have. Say it with \"ma\" to make it negative."],"rows":[["there is","fii"],["there is not","ma fii"],["I have","'indi"],["you have (m)","'indak"],["you have (f)","'indich"],["he has","'indah"],["we have","'indna"]],"ex":[["there is a problem","fii mushkila"],["there is no water","ma fii maay"],["I have a car","'indi sayyaara"],["I do not have time","ma 'indi wagt"],["she has two brothers","'indha akhwaan"]]},{"id":"the-verb-present-tense","title":"The verb: present tense","text":["The beginning of the verb shows the person. Pattern with the verb \"to go\" (rooh):"],"rows":[["I go","arooh"],["you go (m)","tirooh"],["you go (f)","tirooh-iin"],["he goes","yirooh"],["she goes","tirooh"],["we go","nirooh"],["they go","yiroohoon"]],"ex":[["I go to school","arooh il-madrasa"],["he eats rice","yaakul rizz"],["we drink coffee","nishrab gahwa"],["she works in a bank","tishtaghil fi bank"],["where do you go? (m)","wayn tirooh"]]},{"id":"past-and-future","title":"Past and future","text":["Past: the verb ends with -t for \"I\". Future: put \"ba-\" or \"bi-\" before the present verb (Gulf), or use \"raH\"."],"rows":[["I went","ruht"],["I ate","akalt"],["I saw","shift"],["I will go","barooh"],["I will see","bashoof"]],"ex":[["I went yesterday","ruht imbaarih"],["I ate rice","akalt rizz"],["I saw him","shiftah"],["I will go tomorrow","barooh bukra"],["I will call you","batisil bik"]]},{"id":"please-can-want","title":"Please, can, want","text":["Useful starters: abgha (I want), agdar (I can), laazim (I must)."],"rows":[["I want","abgha"],["I can","agdar"],["I must","laazim"],["do you want...?","tabgha"]],"ex":[["I want water","abgha maay"],["can I sit?","agdar ag'ud"],["I must go","laazim arooh"],["do you want tea?","tabgha chaay"],["I cannot","ma agdar"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Word order is flexible. There is no \"is / am / are\": say the two words together. The adjective comes after the noun and agrees with it."],"rows":[["noun + adjective","bayt kabiir (a big house)"],["pronoun + noun","ana taalib (I student = I am a student)"],["verb first is also fine","aakul rizz (I eat rice)"]],"ex":[["I am a student","ana taalib"],["the house is big","il-bayt kabiir"],["she is a teacher","hiya mudarrisa"],["I eat rice","aakul rizz"],["this is my car","hadhi sayyaarti"]]},{"id":"negation","title":"Negation","text":["Use \"ma\" before a verb. Use \"mu\" before an adjective or noun."],"rows":[["not (verb)","ma + verb"],["not (adjective)","mu + word"]],"ex":[]},{"id":"asking-questions","title":"Asking questions","text":["Yes or no question: say a normal sentence with a rising voice. You can also start with \"hal\" (more formal)."],"rows":[["statement","inta taalib"],["question","inta taalib?"],["more formal","hal inta taalib?"]],"ex":[["are you a student? (m)","inta taalib"],["do you speak English?","tihki inglizi"],["do you have time? (m)","'indak wagt"],["is it far?","ba'iid"],["do you want tea? (m)","tabgha chaay"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["what","shu"],["where","wayn"],["when","mita"],["why","layish"],["how","shlon"],["who","min"],["how much","kam / bikam"]],"ex":[["what is this?","shu hadha"],["where is the hotel?","wayn il-funduq"],["when does it open?","mita yiftah"],["why are you late?","layish mit'akhkhir"],["how are you? (m)","shlonak"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Show respect with titles and polite forms. Friends use short, warm words. Always use the right gender."],"rows":[["casual hello","hala"],["formal hello","as-salaamu 'alaykum"],["casual \"you\"","inta / inti"],["very formal \"you\"","hadritak"],["casual \"please\"","min fadlak"],["polite \"please, go ahead\"","tafaddal"]],"ex":[["hello (casual)","hala"],["peace be upon you (formal)","as-salaamu 'alaykum"],["how are you? (polite)","kayf haalak"],["please, come in","tafaddal"],["thank you very much","shukran jaziilan"]]}],"name":"Khaleeji Arabic","id":"khl","flag":"ae","script":"Arabic","note":""}