{"sounds":{"intro":"Say it the way it is written here. Double vowels are long. A man and a woman are addressed differently (m / f).","rows":[["aa, ee, oo","long vowels, hold them","baab, shaay, yoom"],["a, i, u","short vowels","kataba"],["kh","like \"ch\" in Scottish \"loch\"","khubz (bread)"],["gh","like a French \"r\", gargled in the throat","ghaali (expensive)"],["'","a squeezed throat sound; say it from the back of the throat","'ayn (eye)"],["h","a strong, breathy \"h\", like fogging glass","habibi"],["g","hard \"g\" as in \"go\" (Gulf for the letter qaaf)","gahwa (coffee)"],["j / y","many Gulf speakers say \"y\" instead of \"j\"","jamiil / yamiil"],["ch","Gulf speakers often say \"ch\" for k in feminine endings","shlonich"],["dh","like \"th\" in \"this\"","hadha"],["th","like \"th\" in \"think\"","thalatha"],["sh","like \"sh\" in \"shop\"","shukran"]],"notes":[]},"numbers":[{"id":"0-to-10","title":"0 to 10","items":[["zero","sifr"],["one","waahid"],["two","ithnain"],["three","thalaatha"],["four","arba'a"],["five","khamsa"],["six","sitta"],["seven","sab'a"],["eight","thamaaniya"],["nine","tis'a"],["ten","'ashra"]]},{"id":"11-to-20","title":"11 to 20","items":[["eleven","ihda'ash"],["twelve","ithna'ash"],["thirteen","thalaatha'ash"],["fourteen","arba'ta'ash"],["fifteen","khamsta'ash"],["sixteen","sitta'ash"],["seventeen","saba'ta'ash"],["eighteen","thamanta'ash"],["nineteen","tisa'ta'ash"],["twenty","'ishriin"]]},{"id":"tens-and-big-numbers","title":"Tens and big numbers","items":[["thirty","thalaathiin"],["forty","arba'iin"],["fifty","khamsiin"],["sixty","sittiin"],["seventy","sab'iin"],["eighty","thamaaniin"],["ninety","tis'iin"],["one hundred","miya"],["two hundred","miyatain"],["three hundred","thalaath miya"],["one thousand","alf"],["two thousand","alfain"],["one million","milyoon"]]},{"id":"order-and-amounts","title":"Order and amounts","items":[["first","awwal"],["second","thaani"],["third","thaalith"],["half","nuss"],["a little","shwayya"],["a lot","wayid"],["how much / how many?","kam"],["all","kull"],["nothing","wala shay"]]}],"greetings":[{"id":"hello-and-goodbye","title":"Hello and goodbye","items":[["peace be upon you","as-salaamu 'alaykum"],["and upon you peace","wa 'alaykum as-salaam"],["hello","marhaba"],["hello (warm, Gulf)","hala"],["welcome","ahlan wa sahlan"],["welcome (reply)","ahlan bik"],["good morning","sabaah il-khayr"],["good morning (reply)","sabaah in-noor"],["good evening","masaa il-khayr"],["good evening (reply)","masaa in-noor"],["goodnight","tisbah 'ala khayr"],["goodnight (reply)","wa inta min ahlo"],["goodbye","ma' as-salaama"],["see you later","ashoofak ba'dain"],["see you tomorrow","ashoofak bukra"]]},{"id":"meeting-people","title":"Meeting people","items":[["how are you? (m)","shlonak"],["how are you? (f)","shlonich"],["what is your news? (m)","shakhbaarak"],["what is your news? (f)","shakhbaarich"],["I am fine, thank God","zayn, il-hamdulillah"],["very good","tamaam"],["and you? (m)","w inta"],["and you? (f)","w inti"],["what is your name? (m)","shismak"],["what is your name? (f)","shismich"],["my name is...","ismi..."],["nice to meet you","tsharrafna"],["where are you from? (m)","inta min wayn"],["where are you from? (f)","inti min wayn"],["I am from Uzbekistan","ana min uzbakistaan"],["I am from the UAE","ana min il-imaaraat"]]},{"id":"politeness","title":"Politeness","items":[["thank you","shukran"],["thank you very much","shukran jaziilan"],["thank you (to a man, Gulf)","mashkoor"],["thank you (to a woman, Gulf)","mashkoora"],["you are welcome","'afwan"],["please (to a man)","min fadlak"],["please (to a woman)","min fadlich"],["excuse me (to a man)","law samaht"],["excuse me (to a woman)","law samahti"],["sorry (m)","aasif"],["sorry (f)","aasifa"],["yes","aywa"],["no","la"],["God willing","in shaa' allaah"],["God has willed it","maa shaa' allaah"],["thank God","il-hamdulillah"],["congratulations","mabrook"],["happy birthday","kul 'aam wa inta bikhayr"],["may God give you health","al