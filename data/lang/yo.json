"],["textbook","ìwé ẹ̀kọ́","ee-WEH eh-KAW"],["homework","iṣẹ́ àṣetiléwá","ee-SHEH ah-sheh-tee-leh-WAH"],["test","ìdánwò","ee-dahn-WAW"],["grade","máàkì","MAH-ah-kee"],["timetable","àkókò ẹ̀kọ́","ah-KAW-kaw eh-KAW"],["break","ìsinmi","ee-seen-MEE"],["bell","agogo","ah-goh-GOH"],["ruler","rula","ROO-lah"],["rubber","rọ́bà","raw-BAH"],["rucksack","àpò ìwé","ah-PAW ee-WEH"],["dictionary","atúmọ̀ èdè","ah-too-MAW eh-DEH"],["question","ìbéèrè","ee-BEH-eh-REH"],["answer","ìdáhùn","ee-dah-HOON"],["mistake","àṣìṣe","ah-shee-SHEH"],["pen","pẹ́ǹ","PEHN"],["pencil","ohun ìkọ̀wé","oh-HOON ee-kaw-WEH"]]},{"id":"university","title":"University","items":[["university","yunifásítì","yoo-nee-fah-SEE-tee"],["lecture","ẹ̀kọ́ àsọyé","eh-KAW ah-saw-YEH"],["professor","ọ̀jọ̀gbọ́n","aw-jaw-GBAWN"],["degree","oyè","oh-YEH"],["scholarship","ìrànwọ́ owó ẹ̀kọ́","ee-rahn-WAW oh-WOH eh-KAW"],["library","ilé ìkàwé","ee-LEH ee-kah-WEH"],["dormitory","ilé àwọn akẹ́kọ̀ọ́","ee-LEH ah-WAWN ah-keh-KAW-aw"],["campus","ọgbà yunifásítì","aw-GBAH yoo-nee-fah-SEE-tee"],["tuition fees","owó ilé ẹ̀kọ́","oh-WOH ee-LEH eh-KAW"],["semester","àsìkò ẹ̀kọ́","ah-see-KAW eh-KAW"],["course","ẹ̀kọ́","eh-KAW"],["essay","àròkọ","ah-raw-KAW"],["thesis","àyẹ̀wò gíga","ah-yeh-WAW GEE-gah"],["diploma","ìwé ẹ̀rí","ee-WEH eh-REE"],["seminar","ìpàdé àtúnyẹ̀wò","ee-pah-DEH ah-toon-yeh-WAW"],["entrance exam","ìdánwò ìwọlé","ee-dahn-WAW ee-waw-LEH"],["application","ìwé ìbéèrè","ee-WEH ee-beh-eh-REH"],["student card","káàdì akẹ́kọ̀ọ́","KAH-ah-dee ah-keh-KAW-aw"],["faculty","ẹ̀ka","EH-kah"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","kẹ́kọ̀ọ́","keh-KAW-aw"],["to teach","kọ́","KAW"],["to ask","béèrè","beh-eh-REH"],["to answer","dáhùn","dah-HOON"],["to repeat","tún sọ","TOON SAW"],["to understand","yé","YEH"],["to remember","rántí","rahn-TEE"],["to forget","gbàgbé","gbah-GBEH"],["to explain","ṣàlàyé","shah-lah-YEH"],["to practise","ṣe ìdánrawò","sheh ee-dahn-rah-WAW"],["to pass an exam","yege nínú ìdánwò","yeh-GEH nee-NOO ee-dahn-WAW"],["to fail an exam","kùnà nínú ìdánwò","koo-NAH nee-NOO ee-dahn-WAW"],["to write down","kọ sílẹ̀","KAW see-LEH"],["to listen","gbọ́","GBAW"],["to read aloud","kà sókè","KAH saw-KEH"],["to think","ronú","raw-NOO"],["to count","ka","KAH"],["to spell","sọ lẹ́tà","SAW leh-TAH"],["to translate","túmọ̀","TOO-maw"],["to graduate","parí ẹ̀kọ́","pah-REE eh-KAW"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["There is no he / she difference: \"ó\" means both. The short forms come before a verb: mo (I), o (you), ó (he, she), a (we), ẹ (you plural or polite), wọ́n (they). The long forms stand alone: èmi, ìwọ, òun, àwa, ẹ̀yin, àwọn."],"rows":[["I","mo / èmi","moh / EH-mee"],["you","o / ìwọ","oh / ee-WAW"],["he / she","ó / òun","oh / AW-oon"],["we","a / àwa","ah / AH-wah"],["you (plural or polite)","ẹ / ẹ̀yin","eh / EH-yeen"],["they","wọ́n / àwọn","WAWN / ah-WAWN"]],"ex":[["I am a student","akẹ́kọ̀ọ́ ni mí","ah-keh-KAW-aw nee MEE"],["you are tall","o ga","oh GAH"],["she is my older sister","ẹ̀gbọ́n mi obìnrin ni","eh-GBAWN mee oh-bee-REEN nee"],["we are friends","ọ̀rẹ́ ni wá","AW-reh nee WAH"],["they are teachers","olùkọ́ ni wọ́n","oh-loo-KAW nee WAWN"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Nouns do not change. Put \"àwọn\" (the) before the noun for a plural: àwọn ọmọ (the children). With a number, the noun stays the same."],"rows":[["child","ọmọ","aw-MAW"],["children","àwọn ọmọ","ah-WAWN aw-MAW"],["book","ìwé","ee-WEH"],["two books","ìwé méjì","ee-WEH MEH-jee"]],"ex":[["one house, houses","ilé kan, àwọn ilé","ee-LEH KAHN, ah-WAWN ee-LEH"],["one book, books","ìwé kan, àwọn ìwé","ee-WEH KAHN, ah-WAWN ee-WEH"],["one cat, cats","ológbò kan, àwọn ológbò","oh-LAW-gbaw KAHN, ah-WAWN oh-LAW-gbaw"],["two books","ìwé méjì","ee-WEH MEH-jee"],["the children","àwọn ọmọ","ah-WAWN aw-MAW"]]},{"id":"to-be-j-ni-w","title":"To be: jẹ́, ni, wà","text":["\"Ni\" links a person or noun: mo jẹ́ akẹ́kọ̀ọ́ or akẹ́kọ̀ọ́ ni mí. \"Wà\" is used for places: mo wà nílé (I am at home). Adjectives are verbs: ó ga (he is tall)."],"rows":[["I am a teacher","olùkọ́ ni mí","oh-loo-KAW nee MEE"],["this is a book","ìwé ni èyí","ee-WEH nee EH-yee"],["I am at home","mo wà nílé","moh WAH nee-LEH"],["I am tall","mo ga","moh GAH"]],"ex":[["I am a student","akẹ́kọ̀ọ́ ni mí","ah-keh-KAW-aw nee MEE"],["you are tired","àárẹ̀ mú ọ","AH-ah-REH moo AW"],["he is a doctor","dókítà ni ó","doh-kee-TAH nee OH"],["we are happy","inú wa dùn","ee-NOO wah DOON"],["they are at home","wọ́n wà nílé","WAWN WAH nee-LEH"]]},{"id":"having-n","title":"Having: ní","text":["\"Ní\" means to have. Put it after the person: mo ní (I have), o ní (you have), ó ní (he has), a ní (we have), ẹ ní (you have), wọ́n ní (they have)."],"rows":[["I have","mo ní","moh NEE"],["you have","o ní","oh NEE"],["he / she has","ó ní","oh NEE"],["I do not have","n kò ní","n kaw NEE"]],"ex":[["I have an older brother","mo ní ẹ̀gbọ́n ọkùnrin","moh NEE eh-GBAWN aw-koo-REEN"],["I have a car","mo ní ọkọ̀","moh NEE AW-kaw"],["I do not have time","n kò ní àkókò","n kaw NEE ah-KAW-kaw"],["there is a problem","ìṣòro kan wà","ee-shaw-ROH KAHN WAH"],["there is no water","kò sí omi","kaw SEE OH-mee"]]},{"id":"present-tense","title":"Present tense","text":["Verbs never change. Add \"ń\" before the verb for an action in progress: mo ń jẹun (I am eating)."],"rows":[["I eat","mo jẹun","moh jeh-OON"],["you eat","o jẹun","oh jeh-OON"],["he / she eats","ó jẹun","oh jeh-OON"],["I am eating","mo ń jẹun","moh n jeh-OON"]],"ex":[["I am eating bread","mo ń jẹ búrẹ́dì","moh n JEH boo-REH-dee"],["you are reading a book","o ń ka ìwé","oh n KAH ee-WEH"],["she works in a bank","ó ń ṣiṣẹ́ ní báńkì","oh n shee-SHEH nee BAHN-kee"],["we drink tea","a ń mu tíì","ah n MOO TEE-ee"],["they are sleeping","wọ́n ń sùn","WAWN n SOON"]]},{"id":"basic-sentences","title":"Basic sentences","text":["The order is subject, verb, object, just as in English. Adjectives come after the noun."],"rows":[["I read a book","mo ka ìwé","moh KAH ee-WEH"],["he drinks tea","ó mu tíì","oh MOO TEE-ee"],["a big house","ilé ńlá","ee-LEH n-LAH"],["a new car","ọkọ̀ tuntun","AW-kaw toon-TOON"]],"ex":[["I read a book","mo ka ìwé","moh KAH ee-WEH"],["he drinks tea","ó mu tíì","oh MOO TEE-ee"],["we go to school","a lọ sí ilé ìwé","ah LAW see ee-LEH ee-WEH"],["they eat bread","wọ́n jẹ búrẹ́dì","WAWN JEH boo-REH-dee"],["the teacher writes","olùkọ́ ń kọ̀wé","oh-loo-KAW n kaw-WEH"]]},{"id":"negation","title":"Negation","text":["Put \"kò\" (or \"ò\" after \"mi\") before the verb. After \"mo\" it becomes \"n kò\": n kò lọ (I do not go). Others: o kò, kò, a kò, ẹ kò, wọn kò."],"rows":[["I do not go","n kò lọ","n kaw LAW"],["you do not go","o kò lọ","oh kaw LAW"],["he / she does not go","kò lọ","kaw LAW"],["it is not good","kò dára","kaw dah-RAH"]],"ex":[["I want","mo fẹ́","moh FEH"],["I do not want","n kò fẹ́","n kaw FEH"],["I speak English","mo ń sọ Gẹ̀ẹ́sì","moh n SAW GEH-eh-SEE"],["I do not speak English","n kò sọ Gẹ̀ẹ́sì","n kaw SAW GEH-eh-SEE"],["I like it","mo fẹ́ràn rẹ̀","moh feh-RAHN REH"],["I do not like it","n kò fẹ́ràn rẹ̀","n kaw feh-RAHN REH"],["she is here","ó wà níbí","oh WAH nee-BEE"],["she is not here","kò sí níbí","kaw SEE nee-BEE"],["I have a car","mo ní ọkọ̀","moh NEE AW-kaw"],["I do not have a car","n kò ní ọkọ̀","n kaw NEE AW-kaw"],["I understand","ó yé mi","oh YEH mee"],["I do not understand","kò yé mi","kaw YEH mee"],["we are tired","àárẹ̀ mú wa","AH-ah-REH moo WAH"],["we are not tired","àárẹ̀ kò mú wa","AH-ah-REH kaw moo WAH"],["he works on Sundays","ó ń ṣiṣẹ́ ní Ọjọ́ Àìkú","oh n shee-SHEH nee aw-JAW ah-ee-KOO"],["he does not work on Sundays","kò ṣiṣẹ́ ní Ọjọ́ Àìkú","kaw shee-SHEH nee aw-JAW ah-ee-KOO"]]},{"id":"asking-questions","title":"Asking questions","text":["Start with \"ṣé\" (is it true that). Reply with the verb or \"bẹ́ẹ̀ ni\" (yes) or \"rárá\" (no)."],"rows":[["Do you go?","ṣé o lọ?","sheh oh LAW"],["Is it good?","ṣé ó dára?","sheh oh dah-RAH"],["Is it right?","ṣé ó tọ̀nà?","sheh oh taw-NAH"]],"ex":[["is this your book?","ṣé ìwé rẹ ni èyí?","sheh ee-WEH reh nee EH-yee"],["are they here?","ṣé wọ́n wà níbí?","sheh WAWN wah nee-BEE"],["do you like tea?","ṣé o fẹ́ràn tíì?","sheh oh feh-RAHN TEE-ee"],["is it cold?","ṣé òtútù ń mú?","sheh aw-too-TOO n MOO"],["do you speak English?","ṣé o ń sọ Gẹ̀ẹ́sì?","sheh oh n SAW GEH-eh-SEE"]]},{"id":"question-words","title":"Question words","text":["Question words usually come at the end of the sentence or in the place of the answer."],"rows":[["who","ta ni","TAH nee"],["what","kí ni","kee NEE"],["where","níbo","nee-BOH"],["when","ìgbà wo","ee-GBAH woh"],["why","kí ló dé","kee LOH deh"],["how","báwo","BAH-woh"],["how much","èló","eh-LOH"]],"ex":[["what is your name?","kí ni orúkọ rẹ?","kee nee oh-ROO-kaw REH"],["who is he?","ta ni ó?","TAH nee OH"],["where do you live?","níbo ni o ń gbé?","nee-BOH nee oh n GBEH"],["when is the lesson?","ìgbà wo ni ẹ̀kọ́?","ee-GBAH woh nee eh-KAW"],["why are you late?","kí ló dé tí o fi pẹ́?","kee LOH deh tee oh fee PEH"],["how much is it?","èló ni?","eh-LOH nee"],["which book?","ìwé wo?","ee-WEH WOH"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["Put the owner after the thing: ìwé mi (book my), ìwé rẹ (your book), ìwé rẹ̀ (his book), ìwé wa (our book), ìwé yín (your book, plural), ìwé wọn (their book)."],"rows":[["my book","ìwé mi","ee-WEH MEE"],["your book","ìwé rẹ","ee-WEH REH"],["his / her book","ìwé rẹ̀","ee-WEH REH"]],"ex":[["my phone","fóònù mi","foh-OH-noo MEE"],["your house (formal)","ilé yín","ee-LEH YEEN"],["his sister","arábìnrin rẹ̀","ah-rah-bee-REEN REH"],["I like music","mo fẹ́ràn orin","moh feh-RAHN OH-reen"],["I love football","mo nífẹ̀ẹ́ bọ́ọ̀lù","moh nee-FEH-eh baw-AW-loo"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Show respect with \"ẹ\" (plural) for one older person, and add \"ẹ kú\" (well done) greetings. \"Sir\" is \"ọ̀gá\" or \"bàbá\". \"Madam\" is \"ìyá\" or \"ma\". Use \"o\" with a friend or a child."],"rows":[["sir","sà","SAH"],["madam","ma","MAH"],["well done (greeting)","ẹ kú iṣẹ́","eh KOO ee-SHEH"]],"ex":[["how are you? (informal)","báwo ni?","BAH-woh nee"],["how are you? (formal)","báwo ni ẹ ṣe wà?","BAH-woh nee eh sheh WAH"],["where are you going? (informal)","níbo ni o ń lọ?","nee-BOH nee oh n LAW"],["where are you going? (formal)","níbo ni ẹ ń lọ?","nee-BOH nee eh n LAW"],["please sit down (formal)","ẹ jọ̀ọ́ jókòó","eh JAW-aw jaw-KAW-aw"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["There is no past tense. Context shows it. Use \"ti\" for done: mo ti jẹun (I have eaten). For the future, add \"yóò\" or \"á\": mo á jẹun (I will eat)."],"rows":[["I ate","mo ti jẹun","moh tee jeh-OON"],["I will eat","mo á jẹun","moh ah jeh-OON"],["I will go tomorrow","mo á lọ ní ọ̀la","moh ah LAW nee AW-lah"]],"ex":[["yesterday I was tired","àná, àárẹ̀ mú mi","ah-NAH, AH-ah-REH moo MEE"],["I will study tomorrow","mo á kẹ́kọ̀ọ́ ní ọ̀la","moh ah keh-KAW-aw nee AW-lah"],["we went to the park","a lọ sí ọgbà ìtura","ah LAW see aw-GBAH ee-too-RAH"],["I saw him","mo rí i","moh REE ee"],["she wrote a letter","ó kọ lẹ́tà kan","oh KAW leh-TAH KAHN"]]},{"id":"commands","title":"Commands","text":["Use the bare verb. Add \"jọ̀ọ́\" (please) before it. To forbid, put \"má\" in front: má lọ (do not go)."],"rows":[["come!","wá!","WAH"],["wait!","dúró!","doo-ROH"],["do not go","má lọ","mah LAW"],["please wait","jọ̀ọ́ dúró","JAW-aw doo-ROH"]],"ex":[["come here","wá síbí","WAH see-BEE"],["do not come here","má wá síbí","mah WAH see-BEE"],["sit down","jókòó","jaw-KAW-aw"],["do not sit down","má jókòó","mah jaw-KAW-aw"],["be quiet","dákẹ́","dah-KEH"],["do not be late","má pẹ́","mah PEH"],["open the door","ṣí ilẹ̀kùn","SHEE ee-leh-KOON"],["close the window","tì fèrèsé","TEE feh-reh-SEH"],["listen to me","gbọ́ tèmi","GBAW teh-MEE"],["do not worry","má ṣàníyàn","mah shah-nee-YAHN"],["speak slowly","sọ̀rọ̀ díẹ̀díẹ̀","SAW-raw DEE-eh DEE-eh"],["wait a moment","dúró díẹ̀","doo-ROH DEE-eh"]]},{"id":"can-must-want","title":"Can, must, want","text":["\"Lè\" (can) and \"fẹ́\" (want) go before the main verb. \"Gbọ́dọ̀\" (must) goes before the verb too. \"Kò lè\" means cannot."],"rows":[["I can swim","mo lè wẹ̀","moh LEH WEH"],["I must go","mo gbọ́dọ̀ lọ","moh gbaw-DAW LAW"],["I want to go","mo fẹ́ lọ","moh FEH LAW"],["may I?","ṣé mo lè?","sheh moh LEH"]],"ex":[["I can swim","mo lè wẹ̀","moh LEH WEH"],["I cannot swim","n kò lè wẹ̀","n kaw LEH WEH"],["can you help me?","ṣé o lè ràn mí lọ́wọ́?","sheh oh LEH rahn MEE LAW-woh"],["we must go","a gbọ́dọ̀ lọ","ah gbaw-DAW LAW"],["we must not go","a kò gbọ́dọ̀ lọ","ah kaw gbaw-DAW LAW"],["I want to eat","mo fẹ́ jẹun","moh FEH jeh-OON"],["I do not want to eat","n kò fẹ́ jẹun","n kaw FEH jeh-OON"],["you can come","o lè wá","oh LEH WAH"],["you cannot come","o kò lè wá","oh kaw LEH WAH"],["she wants to study","ó fẹ́ kẹ́kọ̀ọ́","oh FEH keh-KAW-aw"],["I must work today","mo gbọ́dọ̀ ṣiṣẹ́ lónìí","moh gbaw-DAW shee-SHEH law-NEE-ee"],["you must not run","o kò gbọ́dọ̀ sá","oh kaw gbaw-DAW SAH"]]},{"id":"in-on-at","title":"In, on, at","text":["Yoruba uses little words: \"ní\" (in, at), \"lórí\" (on), \"lábẹ́\" (under), \"lẹ́bàá\" (next to), \"nítòsí\" (near), \"sí\" (to), \"láti\" (from)."],"rows":[["in the house","nínú ilé","nee-NOO ee-LEH"],["on the table","lórí tábìlì","law-REE tah-bee-LEE"],["under the table","lábẹ́ tábìlì","lah-BEH tah-bee-LEE"],["at school","ní ilé ìwé","nee ee-LEH ee-WEH"]],"ex":[["the book is on the table","ìwé wà lórí tábìlì","ee-WEH WAH law-REE tah-bee-LEE"],["the cat is under the table","ológbò wà lábẹ́ tábìlì","oh-LAW-gbaw WAH lah-BEH tah-bee-LEE"],["I am at school","mo wà ní ilé ìwé","moh WAH nee ee-LEH ee-WEH"],["I am at home","mo wà nílé","moh WAH nee-LEH"],["the shop is next to the bank","ṣọ́ọ̀bù wà lẹ́bàá báńkì","shaw-AW-boo WAH leh-BAH-ah BAHN-kee"],["the park is near the station","ọgbà ìtura wà nítòsí ibùdó","aw-GBAH ee-too-RAH WAH nee-taw-SEE ee-boo-DOH"],["we meet in the morning","a ó pàdé ní òwúrọ̀","ah oh pah-DEH nee oh-woo-RAW"],["the lesson is at nine","ẹ̀kọ́ jẹ́ aago mẹ́sàn-án","eh-KAW JEH AH-ah-goh meh-SAHN-ahn"],["the key is in the bag","kọ́kọ́rọ́ wà nínú àpò","kaw-kaw-RAW WAH nee-NOO ah-PAW"]]},{"id":"comparing-things","title":"Comparing things","text":["Use \"ju\" (than) after the adjective: tóbi ju (bigger than). For the most, say \"ju gbogbo wọn lọ\" (more than all of them)."],"rows":[["big, bigger","tóbi, tóbi jù","taw-BEE, taw-BEE JOO"],["good, better","dára, dára jù","dah-RAH, dah-RAH JOO"],["the biggest","tóbi jù gbogbo wọn lọ","taw-BEE joo GBOH-gboh WAWN LAW"]],"ex":[["big, bigger, the biggest","tóbi, tóbi jù, tóbi jù gbogbo wọn lọ","taw-BEE, taw-BEE JOO, taw-BEE joo GBOH-gboh WAWN LAW"],["small, smaller, the smallest","kékeré, kékeré jù, kékeré jù gbogbo wọn lọ","keh-keh-REH, keh-keh-REH JOO, keh-keh-REH joo GBOH-gboh WAWN LAW"],["this is better than that","èyí dára ju ìyẹn lọ","EH-yee dah-RAH joo EE-yehn LAW"],["this is worse than that","èyí burú ju ìyẹn lọ","EH-yee boo-ROO joo EE-yehn LAW"],["she is taller than me","ó ga jù mí lọ","oh GAH joo MEE LAW"],["Tashkent is bigger than Samarkand","Tashkent tóbi ju Samarkand lọ","tahsh-KENT taw-BEE joo sah-mar-KAHND LAW"],["it is the cheapest","òun ni ó wọ́n jù","AW-oon nee oh WAWN JOO"],["the same as","bákan náà pẹ̀lú","bah-KAHN NAH-ah peh-LOO"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Quick sentences to copy and change."],"rows":[["I am hungry","ebi ń pa mí","EH-bee n PAH mee"],["I am thirsty","òǹgbẹ ń gbẹ mí","AWN-gbeh n GBEH mee"],["I am cold","òtútù ń mú mi","aw-too-TOO n MOO mee"],["it is raining","òjò ń rọ̀","aw-JAW n RAW"]],"ex":[["he is a teacher","olùkọ́ ni ó","oh-loo-KAW nee OH"],["you (plural) are students","akẹ́kọ̀ọ́ ni yín","ah-keh-KAW-aw nee YEEN"],["I am happy","inú mi dùn","ee-NOO mee DOON"],["she is at school","ó wà ní ilé ìwé","oh WAH nee ee-LEH ee-WEH"],["you are my friend","ọ̀rẹ́ mi ni ọ́","AW-reh mee nee AW"],["it is cold","òtútù ń mú","aw-too-TOO n MOO"],["I study English","mo ń kọ́ Gẹ̀ẹ́sì","moh n KAW GEH-eh-SEE"],["he teaches maths","ó ń kọ́ ìṣirò","oh n KAW ee-shee-ROH"],["they work every day","wọ́n ń ṣiṣẹ́ lójoojúmọ́","WAWN n shee-SHEH law-joh-oh-JOO-maw"],["is this your book?","ṣé ìwé rẹ ni èyí?","sheh ee-WEH reh nee EH-yee"],["are they here?","ṣé wọ́n wà níbí?","sheh WAWN wah nee-BEE"],["do you like tea?","ṣé o fẹ́ràn tíì?","sheh oh feh-RAHN TEE-ee"],["what time is it?","aago mélòó ni?","AH-ah-goh meh-loh-OH nee"],["whose book is this?","ti ta ni ìwé yìí?","tee TAH nee ee-WEH YEE"],["how old are you?","ọdún mélòó ni ọ́?","aw-DOON meh-loh-OH nee AW"],["how do you say it?","báwo ni a ṣe ń sọ ọ́?","BAH-woh nee ah sheh n SAW aw"],["your book (formal)","ìwé yín","ee-WEH YEEN"],["their house","ilé wọn","ee-LEH WAWN"],["my phone","fóònù mi","foh-OH-noo MEE"],["excuse me, sir","ẹ jọ̀ọ́, sà","eh JAW-aw, SAH"],["please sit down (formal)","ẹ jọ̀ọ́ jókòó","eh JAW-aw jaw-KAW-aw"],["come here (informal)","wá síbí","WAH see-BEE"],["yesterday I was tired","àná, àárẹ̀ mú mi","ah-NAH, AH-ah-REH moo MEE"],["I will study tomorrow","mo á kẹ́kọ̀ọ́ ní ọ̀la","moh ah keh-KAW-aw nee AW-lah"],["we went to the park","a lọ sí ọgbà ìtura","ah LAW see aw-GBAH ee-too-RAH"]]}],"name":"Yoruba","id":"yo","flag":"ng","note":""}