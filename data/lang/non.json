fe","líf","leef","líf"],["death","dauði","DOW-thi","dauði"],["fate","örlög","UR-lurg","ǫrlǫg"]]},{"id":"verbs-more","title":"Verbs (more)","items":[["I go","ek fer","ek fer","ek fer"],["I come","ek kem","ek kem","ek kem"],["I eat","ek et","ek et","ek et"],["I drink","ek drekk","ek drek","ek drekk"],["I give","ek gef","ek gev","ek gef"],["I know","ek veit","ek vayt","ek veit"],["I sleep","ek sef","ek sev","ek sef"],["I fight","ek berjumk","ek BER-yoomk","ek berjumk"],["I love","ek ann","ek ahn","ek ann"],["I see","ek sé","ek syeh","ek sé"],["I sail","ek sigli","ek SIG-li","ek sigli"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Old Norse has \"ek\" (I), \"þú\" (you), \"hann\" (he), \"hon\" (she), \"þat\" (it), \"vér\" (we), \"ér\" (you plural), \"þeir\" (they). A special dual form \"vit\" means we two."],"rows":[["I","ek","ek"],["you (one)","þú","thoo"],["he","hann","hahn"],["she","hon","hohn"],["it","þat","thaht"],["we","vér","vyayr"],["you (plural)","ér","yayr"],["they","þeir","thayr"]],"ex":[["I am a man","ek em maðr","ek em MAH-thr"],["you are strong","þú ert sterkr","thoo ert STERK-r"],["he is a king","hann er konungr","hahn er KOH-noong-r"],["she is a woman","hon er kona","hohn er KOH-nah"],["we are friends","vér erum vinir","vyayr EH-room VI-nir"]]},{"id":"to-be-vera","title":"To be: vera","text":["The present of \"vera\": em, ert, er, erum, eruð, eru."],"rows":[["I am","em","em"],["you are","ert","ert"],["he / she is","er","er"],["we are","erum","EH-room"],["you are (plural)","eruð","EH-roo-th"],["they are","eru","EH-roo"]],"ex":[["I am here","ek em hér","ek em hyayr"],["the ship is big","skip er mikit","skip er MIK-it"],["they are brothers","þeir eru bræðr","thayr EH-roo BRAI-thr"]]},{"id":"negation","title":"Negation","text":["Put \"eigi\" or \"ekki\" (not) after the verb: ek veit eigi (I know not). Poetry adds the ending -a or -at to the verb: veit-a-k (I know not)."],"rows":[["not","eigi / ekki","AY-gi / EK-ki"]],"ex":[["I know","ek veit","ek vayt"],["I do not know","ek veit eigi","ek vayt AY-gi"],["he comes","hann kemr","hahn KEM-r"],["he does not come","hann kemr eigi","hahn KEM-r AY-gi"]]},{"id":"commands","title":"Commands","text":["The command is the bare stem: far (go), kom (come), sit (sit). Add \"eigi\" or \"ekki\" to forbid."],"rows":[["go!","far","fahr"],["come!","kom","kom"],["see!","sjá","syah"]],"ex":[["come here","kom hér","kom hyayr"],["be well","ver heill","ver hayl"],["go","far","fahr"]]}],"name":"Old Norse","id":"non","flag":"is","note":""}