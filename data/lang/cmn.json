ᠰᠠᠶᠢᠬᠠᠨ"],["tall","öndür","","ᠥᠨᠳᠦᠷ"],["clean","ariγun","","ᠠᠷᠢᠭᠤᠨ"],["hot","qalaγun","","ᠬᠠᠯᠠᠭᠤᠨ"],["cold","küyiten","","ᠬᠦᠶᠢᠲᠡᠨ"]]},{"id":"common-verbs","title":"Common verbs","items":[["to go","yabuqu","","ᠶᠠᠪᠤᠬᠤ"],["to come","irekü","","ᠢᠷᠡᠬᠦ"],["to see","üjekü","","ᠦᠵᠡᠬᠦ"],["to eat","idekü","","ᠢᠳᠡᠬᠦ"],["to drink","uγuqu","","ᠤᠭᠤᠬᠤ"],["to speak","ügülekü","","ᠦᠭᠦᠯᠡᠬᠦ"],["to know","medekü","","ᠮᠡᠳᠡᠬᠦ"],["to do / make","kikü","","ᠬᠢᠬᠦ"],["to say","kemekü","","ᠬᠡᠮᠡᠬᠦ"],["to write","bičikü","","ᠪᠢᠴᠢᠬᠦ"],["to sleep","untaqu","","ᠤᠨᠲᠠᠬᠤ"],["to learn","suraqu","","ᠰᠤᠷᠠᠬᠤ"],["to teach","surγaqu","","ᠰᠤᠷᠭᠠᠬᠤ"],["to love","qairlaqu","","ᠬᠠᠢᠷᠯᠠᠬᠤ"],["to live","amiduraqu","","ᠠᠮᠢᠳᠤᠷᠠᠬᠤ"],["to want","küsekü","","ᠬᠦᠰᠡᠬᠦ"]],"note":"Dictionary form, ending in -qu or -kü."}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Mongolian has no gender. \"Tere\" means he, she and it. Use \"ta\" for one person you respect."],"rows":[["I","bi"],["you (informal)","či"],["you (formal)","ta"],["he / she / it","tere"],["we","bide"],["you (plural)","ta nar"],["they","tede"]],"ex":[["I am a student","bi surγaγči bui","","ᠪᠢ ᠰᠤᠷᠭᠠᠭᠴᠢ ᠪᠤᠢ"],["you are tall","či öndür bui","","ᠴᠢ ᠥᠨᠳᠦᠷ ᠪᠤᠢ"],["he is a teacher","tere baγši mön","","ᠲᠡᠷᠡ ᠪᠠᠭᠱᠢ ᠮᠥᠨ"],["we are friends","bide nayiji nar bui","","ᠪᠢᠳᠡ ᠨᠠᠶᠢᠵᠢ ᠨᠠᠷ ᠪᠤᠢ"],["they are teachers","tede baγši nar bui","","ᠲᠡᠳᠡ ᠪᠠᠭᠱᠢ ᠨᠠᠷ ᠪᠤᠢ"],["she is my elder sister","tere minu egeči mön","","ᠲᠡᠷᠡ ᠮᠢᠨᠤ ᠡᠭᠡᠴᠢ ᠮᠥᠨ"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["The plural is -ud / -üd by vowel harmony (nom → nom-ud, ger → ger-üd). For people \"nar\" is common: baγši nar. After a number the noun stays singular."],"rows":[["-ud (back vowels)","nom → nom-ud"],["-üd (front vowels)","ger → ger-üd"],["nar (people)","baγši → baγši nar"],["after a number","qoyar nom"]],"ex":[["the books","nom-ud","","ᠨᠣᠮ᠎ᠤᠳ"],["the houses","ger-üd","","ᠭᠡᠷ᠎ᠦᠳ"],["the teachers","baγši nar","","ᠪᠠᠭᠱᠢ ᠨᠠᠷ"],["two books","qoyar nom","","ᠬᠣᠶᠠᠷ ᠨᠣᠮ"],["many people","olan kümün","","ᠣᠯᠠᠨ ᠬᠦᠮᠦᠨ"]]},{"id":"negation","title":"Negation","text":["\"Ügei\" means \"not\" or \"there is none\". \"Biši\" means \"is not\" (for nouns). A verb in -qu takes \"ügei\": yabuqu ügei (will not go). Always compare with the positive form."],"rows":[["there is none","ügei"],["is not","biši"],["will not","-qu ügei"]],"ex":[["there is a book","nom bui","","ᠨᠣᠮ ᠪᠤᠢ"],["there is no book","nom ügei","","ᠨᠣᠮ ᠦᠭᠡᠢ"],["I have a house","minu ger bui","","ᠮᠢᠨᠤ ᠭᠡᠷ ᠪᠤᠢ"],["I do not have a house","minu ger ügei","","ᠮᠢᠨᠤ ᠭᠡᠷ ᠦᠭᠡᠢ"],["he is a teacher","tere baγši mön","","ᠲᠡᠷᠡ ᠪᠠᠭᠱᠢ ᠮᠥᠨ"],["he is not a teacher","tere baγši biši","","ᠲᠡᠷᠡ ᠪᠠᠭᠱᠢ ᠪᠢᠱᠢ"],["I will go","bi yabuqu","","ᠪᠢ ᠶᠠᠪᠤᠬᠤ"],["I will not go","bi yabuqu ügei","","ᠪᠢ ᠶᠠᠪᠤᠬᠤ ᠦᠭᠡᠢ"]]},{"id":"asking-questions","title":"Asking questions","text":["A yes / no question ends in \"uu\" (back vowel) or \"üü\" (front vowel). The word order does not change."],"rows":[["after a back vowel","uu"],["after a front vowel","üü"]],"ex":[["is it a book?","ene nom uu","","ᠡᠨᠡ ᠨᠣᠮ ᠤᠤ"],["is he a teacher?","tere baγši uu","","ᠲᠡᠷᠡ ᠪᠠᠭᠱᠢ ᠤᠤ"],["is it big?","yeke üü","","ᠶᠡᠬᠡ ᠦᠦ"],["do you have a book?","tanu nom bui uu","","ᠲᠠᠨᠤ ᠨᠣᠮ ᠪᠤᠢ ᠤᠤ"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["what","yaγun"],["who","ken"],["where","qamiγ-a"],["how many","kedü"],["which","ali"]],"ex":[["what is this?","ene yaγun bui","","ᠡᠨᠡ ᠶᠠᠭᠤᠨ ᠪᠤᠢ"],["who is he?","tere ken bui","","ᠲᠡᠷᠡ ᠬᠡᠨ ᠪᠤᠢ"],["where is the school?","surγaγuli qamiγ-a bui","","ᠰᠤᠷᠭᠠᠭᠤᠯᠢ ᠬᠠᠮᠢᠭ᠎ᠠ ᠪᠤᠢ"],["how many books?","kedü nom bui","","ᠬᠡᠳᠦ ᠨᠣᠮ ᠪᠤᠢ"],["which book?","ali nom","","ᠠᠯᠢ ᠨᠣᠮ"]]},{"id":"possessives","title":"Possessives","text":["The owner comes first, in the genitive: minu (my), činu (your, informal), tanu (your, formal), bidan-u (our)."],"rows":[["my","minu"],["your (informal)","činu"],["your (formal)","tanu"],["our","bidan-u"]],"ex":[["my book","minu nom","","ᠮᠢᠨᠤ ᠨᠣᠮ"],["your house (formal)","tanu ger","","ᠲᠠᠨᠤ ᠭᠡᠷ"],["our school","bidan-u surγaγuli","","ᠪᠢᠳᠠᠨ᠎ᠤ ᠰᠤᠷᠭᠠᠭᠤᠯᠢ"],["the teacher's book","baγši-yin nom","","ᠪᠠᠭᠱᠢ᠎ᠶᠢᠨ ᠨᠣᠮ"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":[],"rows":[],"ex":[["he is a teacher","tere baγši mön","","ᠲᠡᠷᠡ ᠪᠠᠭᠱᠢ ᠮᠥᠨ"],["you (plural) are students","ta nar surγaγči nar bui","","ᠲᠠ ᠨᠠᠷ ᠰᠤᠷᠭᠠᠭᠴᠢ ᠨᠠᠷ ᠪᠤᠢ"],["is this your book?","ene tanu nom uu","","ᠡᠨᠡ ᠲᠠᠨᠤ ᠨᠣᠮ ᠤᠤ"],["this is my book","ene minu nom mön","","ᠡᠨᠡ ᠮᠢᠨᠤ ᠨᠣᠮ ᠮᠥᠨ"]]}],"name":"Classical Mongolian","id":"cmn","flag":"mn","script":"Mongolian","note":""}