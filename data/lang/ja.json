す"],["to buy","kaimasu","","買います"],["to read","yomimasu","","読みます"],["to write","kakimasu","","書きます"],["to listen","kikimasu","","聞きます"],["to sleep","nemasu","","寝ます"],["to study","benkyou shimasu","","勉強します"],["to work","hatarakimasu","","働きます"],["to wait","machimasu","","待ちます"],["to give","agemasu","","あげます"],["to understand","wakarimasu","","わかります"],["to like","suki desu","","好きです"]]},{"id":"school-subjects","title":"School subjects","items":[["maths","suugaku","","数学"],["physics","butsuri","","物理"],["chemistry","kagaku","","化学"],["biology","seibutsu","","生物"],["history","rekishi","","歴史"],["geography","chiri","","地理"],["literature","bungaku","","文学"],["English","eigo","","英語"],["foreign languages","gaikokugo","","外国語"],["art","bijutsu","","美術"],["music","ongaku","","音楽"],["PE","taiiku","","体育"],["computer science","jouhou","","情報"],["economics","keizai","","経済"],["law","houritsu","","法律"],["philosophy","tetsugaku","","哲学"],["psychology","shinrigaku","","心理学"],["science","rika","","理科"]]},{"id":"classroom","title":"Classroom","items":[["classroom","kyoushitsu","","教室"],["desk","tsukue","","机"],["board","kokuban","","黒板"],["notebook","nooto","","ノート"],["textbook","kyoukasho","","教科書"],["homework","shukudai","","宿題"],["test","tesuto","","テスト"],["grade","seiseki","","成績"],["timetable","jikanwari","","時間割"],["break","yasumi jikan","","休み時間"],["bell","chaimu","","チャイム"],["ruler","jougi","","定規"],["rubber","keshigomu","","消しゴム"],["rucksack","rukkusakku","","リュックサック"],["dictionary","jisho","","辞書"],["question","shitsumon","","質問"],["answer","kotae","","答え"],["mistake","machigai","","間違い"]]},{"id":"university","title":"University","items":[["university","daigaku","","大学"],["lecture","kougi","","講義"],["professor","kyouju","","教授"],["degree","gakui","","学位"],["scholarship","shougakukin","","奨学金"],["library","toshokan","","図書館"],["dormitory","ryou","","寮"],["campus","kyanpasu","","キャンパス"],["tuition fees","jugyouryou","","授業料"],["semester","gakki","","学期"],["course","kamoku","","科目"],["essay","essei","","エッセイ"],["thesis","ronbun","","論文"],["diploma","sotsugyou shousho","","卒業証書"],["seminar","zemi","","ゼミ"],["entrance exam","nyuugaku shiken","","入学試験"],["application","moushikomi","","申し込み"],["student card","gakuseishou","","学生証"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","benkyou shimasu","","勉強します"],["to teach","oshiemasu","","教えます"],["to ask","shitsumon shimasu","","質問します"],["to answer","kotaemasu","","答えます"],["to repeat","kurikaeshimasu","","繰り返します"],["to understand","wakarimasu","","わかります"],["to remember","oboemasu","","覚えます"],["to forget","wasuremasu","","忘れます"],["to explain","setsumei shimasu","","説明します"],["to practise","renshuu shimasu","","練習します"],["to pass an exam","goukaku shimasu","","合格します"],["to fail an exam","fugoukaku ni narimasu","","不合格になります"],["to write down","kakimasu","","書きます"],["to listen","kikimasu","","聞きます"],["to read aloud","ondoku shimasu","","音読します"],["to think","kangaemasu","","考えます"],["to count","kazoemasu","","数えます"],["to spell","tsuzurimasu","","綴ります"],["to translate","honyaku shimasu","","翻訳します"],["to graduate","sotsugyou shimasu","","卒業します"]],"note":"Shown in the polite form (-masu)."}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Japanese often drops pronouns. Use names instead of \"you\". The word \"anata\" (you) can sound too direct."],"rows":[["I","watashi"],["you","anata"],["he","kare"],["she","kanojo"],["we","watashitachi"],["they","karera"]],"ex":[["I am Eric","watashi wa eriku desu","","私はエリクです"],["she is my friend","kanojo wa tomodachi desu","","彼女は友達です"],["we are students","watashitachi wa gakusei desu","","私たちは学生です"],["he is not here","kare wa koko ni imasen","","彼はここにいません"],["they are teachers","karera wa sensei desu","","彼らは先生です"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Japanese nouns do not change for singular or plural. \"Hon\" can mean one book or many books. Use a number and a counter to be exact."],"rows":[["a person, people","hito (same word)"],["group of people","add -tachi (tomodachitachi)"],["number + counter","san-satsu (3 books)"],["books (a)","hon"]],"ex":[["one book","hon ga ichi-satsu","","本が一冊"],["three books","hon ga san-satsu","","本が三冊"],["friends","tomodachitachi","","友達たち"],["two cats","neko ga ni-hiki","","猫が二匹"],["five students","gakusei ga go-nin","","学生が五人"]]},{"id":"desu-to-be","title":"Desu: to be","text":["Japanese puts the verb last. \"X wa Y desu\" means X is Y. Wa (written ha) marks the topic."],"rows":[["I am","watashi wa ... desu"],["is not","... ja arimasen"],["was","... deshita"],["is it...?","... desu ka"]],"ex":[["I am a student","watashi wa gakusei desu","","私は学生です"],["this is a book","kore wa hon desu","","これは本です"],["he is a teacher","kare wa sensei desu","","彼は先生です"],["I am not a doctor","watashi wa isha ja arimasen","","私は医者じゃありません"],["is she Japanese?","kanojo wa nihonjin desu ka","","彼女は日本人ですか"]]},{"id":"verbs-polite-forms","title":"Verbs: polite forms","text":["Polite verbs end in -masu. Change it to -masen (not), -mashita (did), -masen deshita (did not)."],"rows":[["eat","tabemasu"],["do not eat","tabemasen"],["ate","tabemashita"],["did not eat","tabemasen deshita"]],"ex":[["I eat bread","pan o tabemasu","","パンを食べます"],["I do not drink coffee","koohii o nomimasen","","コーヒーを飲みません"],["I went to Tokyo","toukyou ni ikimashita","","東京に行きました"],["I did not go","ikimasen deshita","","行きませんでした"],["what did you eat?","nani o tabemashita ka","","何を食べましたか"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Verb last. Order: topic (wa), place or time, object (o), verb. Say the topic first and the verb at the very end."],"rows":[["topic + object + verb","watashi wa pan o tabemasu"],["place + verb","gakkou ni ikimasu"],["time + place + verb","ashita toukyou ni ikimasu"]],"ex":[["I eat bread","watashi wa pan o tabemasu","","私はパンを食べます"],["I go to school","gakkou ni ikimasu","","学校に行きます"],["I drink water every day","mainichi mizu o nomimasu","","毎日水を飲みます"],["I read a book at home","ie de hon o yomimasu","","家で本を読みます"],["I will go to Tokyo tomorrow","ashita toukyou ni ikimasu","","明日東京に行きます"]]},{"id":"negation","title":"Negation","text":["Polite: -masen. Desu becomes ja arimasen. I-adjectives: -kunai desu. Past: -masen deshita.","Always shown with the positive form next to it."],"rows":[["eat / do not eat","tabemasu / tabemasen"],["is / is not","desu / ja arimasen"],["delicious / not delicious","oishii / oishikunai"],["did not go","ikimasen deshita"]],"ex":[["I want","hoshii desu","","欲しいです"],["I do not want","hoshiku arimasen","","欲しくありません"],["I speak English","eigo o hanashimasu","","英語を話します"],["I do not speak English","eigo o hanashimasen","","英語を話しません"],["I like it","suki desu","","好きです"],["I do not like it","suki ja arimasen","","好きじゃありません"],["she is here","kanojo wa koko ni imasu","","彼女はここにいます"],["she is not here","kanojo wa koko ni imasen","","彼女はここにいません"],["I have a car","kuruma ga arimasu","","車があります"],["I do not have a car","kuruma ga arimasen","","車がありません"],["I understand","wakarimasu","","わかります"],["I do not understand","wakarimasen","","わかりません"],["we are tired","watashitachi wa tsukarete imasu","","私たちは疲れています"],["we are not tired","watashitachi wa tsukarete imasen","","私たちは疲れていません"],["he works on Sundays","kare wa nichiyoubi ni hatarakimasu","","彼は日曜日に働きます"],["he does not work on Sundays","kare wa nichiyoubi ni hatarakimasen","","彼は日曜日に働きません"]]},{"id":"asking-questions","title":"Asking questions","text":["Add ka at the end of the sentence. No word order change, and no question mark is needed."],"rows":[["statement","gakusei desu"],["question","gakusei desu ka"],["do you...?","... masu ka"]],"ex":[["are you a student?","gakusei desu ka","","学生ですか"],["do you eat fish?","sakana o tabemasu ka","","魚を食べますか"],["is it expensive?","takai desu ka","","高いですか"],["are you going?","ikimasu ka","","行きますか"],["do you have a pen?","pen ga arimasu ka","","ペンがありますか"]]},{"id":"question-words","title":"Question words","text":[],"rows":[["what","nani / nan"],["who","dare"],["where","doko"],["when","itsu"],["why","naze / doushite"],["how","dou"],["which","dore"],["how much","ikura"],["how many","ikutsu"]],"ex":[["what is this?","kore wa nani desu ka","","これは何ですか"],["who is that?","are wa dare desu ka","","あれは誰ですか"],["where is the station?","eki wa doko desu ka","","駅はどこですか"],["when do you go?","itsu ikimasu ka","","いつ行きますか"],["how much is it?","ikura desu ka","","いくらですか"],["why?","doushite desu ka","","どうしてですか"]]},{"id":"particles","title":"Particles","text":["Small words after nouns show their job. They are the glue of Japanese."],"rows":[["wa","topic (\"as for...\")"],["ga","subject; also with suki and wakaru"],["o","object (what you do something to)"],["ni","to, at (time), in (place of being)"],["de","at / by (where or how you do it)"],["no","of, 's"],["mo","also"],["ka","question marker"]],"ex":[["I eat sushi","watashi wa sushi o tabemasu","","私は寿司を食べます"],["I go to school","gakkou ni ikimasu","","学校に行きます"],["I go by train","densha de ikimasu","","電車で行きます"],["it is my book","watashi no hon desu","","私の本です"],["me too","watashi mo","","私も"]]},{"id":"this-that-which","title":"This, that, which","text":[],"rows":[["this (near me)","kore"],["that (near you)","sore"],["that (far)","are"],["which","dore"],["this + noun","kono + noun"],["that + noun","sono + noun"]],"ex":[["what is this?","kore wa nan desu ka","","これは何ですか"],["this is a pen","kore wa pen desu","","これはペンです"],["that book is mine","sono hon wa watashi no desu","","その本は私のです"],["which is yours?","dore ga anata no desu ka","","どれがあなたのですか"],["that is a station","are wa eki desu","","あれは駅です"]]},{"id":"adjectives","title":"Adjectives","text":["There are two kinds. I-adjectives end in -i (takai). Na-adjectives need \"na\" before a noun (kirei na hana). To make an i-adjective negative, change -i to -kunai."],"rows":[["big","ookii"],["not big","ookikunai"],["was big","ookikatta"],["quiet (na-adjective)","shizuka (na)"]],"ex":[["it is expensive","takai desu","","高いです"],["it is not expensive","takakunai desu","","高くないです"],["it was delicious","oishikatta desu","","おいしかったです"],["a beautiful flower","kirei na hana","","きれいな花"],["the town is quiet","machi wa shizuka desu","","町は静かです"]]},{"id":"wanting-and-asking","title":"Wanting and asking","text":["Add -tai to the verb stem to say \"want to\". Add -te kudasai to ask politely."],"rows":[["want to eat","tabetai desu"],["want to go","ikitai desu"],["please eat","tabete kudasai"],["please wait","matte kudasai"]],"ex":[["I want to go to Japan","nihon ni ikitai desu","","日本に行きたいです"],["I want to eat sushi","sushi ga tabetai desu","","寿司が食べたいです"],["please wait here","koko de matte kudasai","","ここで待ってください"],["please speak slowly","yukkuri hanashite kudasai","","ゆっくり話してください"],["please show me","misete kudasai","","見せてください"]]},{"id":"existing-and-having","title":"Existing and having","text":["Imasu is for living things, arimasu for things. To say \"I have\", say \"[thing] ga arimasu\"."],"rows":[["there is (living)","imasu"],["there is (thing)","arimasu"],["there is not","arimasen / imasen"]],"ex":[["there is a cat","neko ga imasu","","猫がいます"],["there is a bank here","koko ni ginkou ga arimasu","","ここに銀行があります"],["I have time","jikan ga arimasu","","時間があります"],["I do not have money","okane ga arimasen","","お金がありません"],["I have a brother","otouto ga imasu","","弟がいます"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Polite: desu / masu. Casual (plain): da, and the dictionary form of verbs (taberu, iku). Casual is only for friends and family."],"rows":[["be: polite / casual","desu / da"],["eat: polite / casual","tabemasu / taberu"],["go: polite / casual","ikimasu / iku"],["not eat: polite / casual","tabemasen / tabenai"]],"ex":[["it is a book (polite)","hon desu","","本です"],["it is a book (casual)","hon da","","本だ"],["I eat (polite)","tabemasu","","食べます"],["I eat (casual)","taberu","","食べる"],["I do not go (casual)","ikanai","","行かない"]]},{"id":"commands","title":"Commands","text":["Ask politely with the te-form plus kudasai. Say \"please do not\" with -naide kudasai. Plain commands are rude."],"rows":[["please come","kite kudasai","","来てください"],["please do not come","konaide kudasai","","来ないでください"]],"ex":[["come here","koko ni kite kudasai","","ここに来てください"],["do not come here","koko ni konaide kudasai","","ここに来ないでください"],["sit down","suwatte kudasai","","座ってください"],["do not sit down","suwaranaide kudasai","","座らないでください"],["be quiet","shizuka ni shite kudasai","","静かにしてください"],["do not be late","okurenaide kudasai","","遅れないでください"],["open the door","doa o akete kudasai","","ドアを開けてください"],["close the window","mado o shimete kudasai","","窓を閉めてください"],["listen to me","watashi no hanashi o kiite kudasai","","私の話を聞いてください"],["do not worry","shinpai shinaide kudasai","","心配しないでください"],["speak slowly","yukkuri onegaishimasu","","ゆっくりお願いします"],["wait a moment","chotto matte kudasai","","ちょっと待ってください"]]},{"id":"can-must-want","title":"Can, must, want","text":["Can: verb stem + emasu, or koto ga dekimasu. Must: -nakereba narimasen. Want to: -tai desu. Must not: -te wa ikemasen."],"rows":[["I can","dekimasu","","できます"],["I must","-nakereba narimasen","","なければなりません"],["I want to","-tai desu","","たいです"]],"ex":[["I can swim","oyogemasu","","泳げます"],["I cannot swim","oyogemasen","","泳げません"],["can you help me?","tetsudatte moraemasu ka","","手伝ってもらえますか"],["we must go","ikanakereba narimasen","","行かなければなりません"],["we must not go","itte wa ikemasen","","行ってはいけません"],["I want to eat","tabetai desu","","食べたいです"],["I do not want to eat","tabetaku arimasen","","食べたくありません"],["you can come","kuru koto ga dekimasu","","来ることができます"],["you cannot come","kuru koto ga dekimasen","","来ることができません"],["she wants to study","kanojo wa benkyou shitai desu","","彼女は勉強したいです"],["I must work today","kyou hatarakanakereba narimasen","","今日働かなければなりません"],["you must not run","hashitte wa ikemasen","","走ってはいけません"]]},{"id":"in-on-at","title":"In, on, at","text":["Ni = at or in (where something is). De = where you do something. Japanese puts the place word after the noun: \"table no ue\" = on the table."],"rows":[["on","no ue","","の上"],["under","no shita","","の下"],["next to","no tonari","","の隣"],["in","no naka","","の中"]],"ex":[["the book is on the table","hon wa tsukue no ue ni arimasu","","本は机の上にあります"],["the cat is under the table","neko wa tsukue no shita ni imasu","","猫は机の下にいます"],["I am at school","gakkou ni imasu","","学校にいます"],["I am at home","ie ni imasu","","家にいます"],["the shop is next to the bank","mise wa ginkou no tonari ni arimasu","","店は銀行の隣にあります"],["the park is near the station","kouen wa eki no chikaku ni arimasu","","公園は駅の近くにあります"],["we meet in the morning","asa ni aimasu","","朝に会います"],["the lesson is at nine","jugyou wa ku-ji desu","","授業は九時です"],["the key is in the bag","kagi wa kaban no naka ni arimasu","","鍵はかばんの中にあります"]]},{"id":"comparing-things","title":"Comparing things","text":["\"A wa B yori ...\" means A is more ... than B. Use \"ichiban\" for \"the most\". Adjectives do not change for comparison."],"rows":[["more than","yori","","より"],["more","motto","","もっと"],["the most","ichiban","","一番"]],"ex":[["big, bigger, the biggest","ookii, motto ookii, ichiban ookii","","大きい、もっと大きい、一番大きい"],["small, smaller, the smallest","chiisai, motto chiisai, ichiban chiisai","","小さい、もっと小さい、一番小さい"],["this is better than that","kore wa are yori ii desu","","これはあれよりいいです"],["this is worse than that","kore wa are yori warui desu","","これはあれより悪いです"],["she is taller than me","kanojo wa watashi yori se ga takai desu","","彼女は私より背が高いです"],["Tashkent is bigger than Samarkand","tashukento wa samarukando yori ookii desu","","タシケントはサマルカンドより大きいです"],["it is the cheapest","ichiban yasui desu","","一番安いです"],["the same as","to onaji","","と同じ"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Extra practice with the most useful patterns."],"rows":[],"ex":[["he is a teacher","kare wa sensei desu","","彼は先生です"],["you (plural) are students","minasan wa gakusei desu","","皆さんは学生です"],["I am happy","ureshii desu","","嬉しいです"],["she is at school","kanojo wa gakkou ni imasu","","彼女は学校にいます"],["you are my friend","anata wa watashi no tomodachi desu","","あなたは私の友達です"],["it is cold","samui desu","","寒いです"],["I study English","eigo o benkyou shimasu","","英語を勉強します"],["he teaches maths","kare wa suugaku o oshiemasu","","彼は数学を教えます"],["they work every day","karera wa mainichi hatarakimasu","","彼らは毎日働きます"],["is this your book?","kore wa anata no hon desu ka","","これはあなたの本ですか"],["are they here?","karera wa koko ni imasu ka","","彼らはここにいますか"],["do you like tea?","ocha ga suki desu ka","","お茶が好きですか"],["what time is it?","nan-ji desu ka","","何時ですか"],["whose book is this?","kore wa dare no hon desu ka","","これは誰の本ですか"],["how old are you?","nan-sai desu ka","","何歳ですか"],["how do you say it?","douyatte iimasu ka","","どうやって言いますか"],["your book (formal)","okyaku-sama no hon","","お客様の本"],["their house","karera no ie","","彼らの家"],["my phone","watashi no keitai","","私の携帯"],["excuse me, sir","sumimasen, sensei","","すみません、先生"],["please sit down (formal)","douzo okake kudasai","","どうぞお掛けください"],["come here (informal)","koko ni kite","","ここに来て"],["yesterday I was tired","kinou wa tsukarete imashita","","昨日は疲れていました"],["I will study tomorrow","ashita benkyou shimasu","","明日勉強します"],["we went to the park","kouen ni ikimashita","","公園に行きました"]]}],"name":"Japanese","id":"ja","flag":"jp","script":"Japanese","note":""}