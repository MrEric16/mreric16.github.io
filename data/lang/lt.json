ourse","kursas","KOOR-sas"],["essay","esė","eh-SEH"],["thesis","baigiamasis darbas","bai-GEE-ah-mah-sis DAR-bas"],["diploma","diplomas","dee-PLOH-mas"],["seminar","seminaras","seh-mee-NAH-ras"],["entrance exam","stojamasis egzaminas","stoh-YAH-mah-sis eg-zah-MEE-nas"],["application","prašymas","prah-SHEE-mas"],["student card","studento pažymėjimas","stoo-DEN-toh pah-zhee-MEH-yee-mas"],["faculty","fakultetas","fah-kool-TEH-tas"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","mokytis","MOH-kee-tis"],["to teach","mokyti","MOH-kee-tee"],["to ask","klausti","KLOWS-tee"],["to answer","atsakyti","ah-tsah-KEE-tee"],["to repeat","kartoti","kar-TOH-tee"],["to understand","suprasti","soo-PRAHS-tee"],["to remember","prisiminti","pree-see-MIN-tee"],["to forget","užmiršti","oozh-MEER-shtee"],["to explain","aiškinti","AISH-kin-tee"],["to practise","praktikuotis","prak-tee-KOO-oh-tis"],["to pass an exam","išlaikyti egzaminą","ish-lai-KEE-tee eg-zah-MEE-nah"],["to fail an exam","neišlaikyti egzamino","neh-ish-lai-KEE-tee eg-zah-MEE-noh"],["to write down","užsirašyti","oozh-see-rah-SHEE-tee"],["to listen","klausytis","klow-SEE-tis"],["to read aloud","skaityti garsiai","skai-TEE-tee gar-SYAI"],["to think","galvoti","gal-VOH-tee"],["to count","skaičiuoti","skai-CHYOO-oh-tee"],["to spell","sakyti pagal raides","sah-KEE-tee PAH-gal rah-ee-DEHS"],["to translate","versti","VER-stee"],["to graduate","baigti mokyklą","BAIG-tee moh-KEEK-lah"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Lithuanian has \"tu\" (you, informal) and \"jūs\" (you, formal or plural). Verbs change for each person. \"Jis\" is he and \"ji\" is she, and the plural splits too: \"jie\" (men) and \"jos\" (women)."],"rows":[["I","aš","ash"],["you (informal)","tu","too"],["he","jis","yis"],["she","ji","yee"],["we","mes","mes"],["you (formal / plural)","jūs","yoos"],["they (m)","jie","yee-eh"],["they (f)","jos","yos"]],"ex":[["I am a student","aš esu studentas","ash eh-SOO stoo-DEN-tas"],["you are tall","tu esi aukštas","too eh-SEE OWK-shtas"],["she is my older sister","ji yra mano vyresnė sesuo","yee ee-RAH MAH-noh vee-RES-neh seh-SOO-oh"],["we are friends","mes esame draugai","mes eh-SAH-meh drow-GAI"],["they are teachers","jie yra mokytojai","yee-eh ee-RAH moh-kee-TOH-yai"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Lithuanian has no \"the\" or \"a\". Masculine nouns end in -as, -is, -ys, -us; feminine in -a, -ė. Plural masculine: -ai, -iai, -ys: knyga, knygos; vaikas, vaikai."],"rows":[["the book","knyga","KNEE-gah"],["the books","knygos","KNEE-gos"],["the child","vaikas","VAI-kas"],["the children","vaikai","vai-KAI"]],"ex":[["one house, houses","namas, namai","NAH-mas, nah-MAI"],["one book, books","knyga, knygos","KNEE-gah, KNEE-gos"],["one cat, cats","katė, katės","kah-TEH, kah-TEHS"],["two books","dvi knygos","dvee KNEE-gos"],["the children","vaikai","vai-KAI"]]},{"id":"to-be-b-ti","title":"To be: būti","text":["The verb \"būti\" (to be) changes for each person: esu, esi, yra. \"Yra\" is also used for \"there is\"."],"rows":[["I am","aš esu","ash eh-SOO"],["you are (informal)","tu esi","too eh-SEE"],["he / she is","jis / ji yra","yis / yee ee-RAH"],["we are","mes esame","mes eh-SAH-meh"],["you are (formal / plural)","jūs esate","yoos eh-SAH-teh"],["they are","jie / jos yra","yee-eh / yos ee-RAH"]],"ex":[["I am a student","aš esu studentas","ash eh-SOO stoo-DEN-tas"],["you are tired","tu esi pavargęs","too eh-SEE pah-VAR-gehs"],["he is a doctor","jis yra gydytojas","yis ee-RAH GEE-dee-toh-yas"],["we are happy","mes esame laimingi","mes eh-SAH-meh lie-MIN-gee"],["they are at home","jie yra namie","yee-eh ee-RAH nah-MYEH"]]},{"id":"having-tur-ti","title":"Having: turėti","text":["Lithuanian uses \"turėti\" (to have): turiu mašiną (I have a car). For \"I do not have\", use \"neturiu\". \"There is no\" is \"nėra\" and takes the genitive."],"rows":[["I have a car","turiu mašiną","TOO-ryoo mah-SHEE-nah"],["you have a car","turi mašiną","TOO-ree mah-SHEE-nah"],["he / she has a car","turi mašiną","TOO-ree mah-SHEE-nah"],["I do not have","neturiu","neh-TOO-ryoo"]],"ex":[["I have an older brother","turiu vyresnį brolį","TOO-ryoo vee-RES-nee BROH-lee"],["I have a car","turiu mašiną","TOO-ryoo mah-SHEE-nah"],["I do not have time","neturiu laiko","neh-TOO-ryoo LAI-koh"],["there is a problem","yra problema","ee-RAH proh-bleh-MAH"],["there is no water","nėra vandens","neh-RAH van-DEHNS"]]},{"id":"present-tense","title":"Present tense","text":["Verbs change for person. Regular verbs (like \"valgyti\", to eat) take -u, -i, -a / -o: aš valgau, tu valgai, jis valgo."],"rows":[["I eat","aš valgau","ash VAL-gow"],["you eat","tu valgai","too VAL-gai"],["he / she eats","jis valgo","yis VAL-goh"],["we eat","mes valgome","mes VAL-goh-meh"]],"ex":[["I am eating bread","aš valgau duoną","ash VAL-gow DOO-oh-nah"],["you are reading a book","tu skaitai knygą","too SKAI-tai KNEE-gah"],["she works in a bank","ji dirba banke","yee DEER-bah BAN-keh"],["we drink tea","mes geriame arbatą","mes GEH-ryah-meh ar-BAH-tah"],["they are sleeping","jie miega","yee-eh MYEH-gah"]]},{"id":"basic-sentences","title":"Basic sentences","text":["The usual order is subject, verb, object: \"aš skaitau knygą\" (I read a book). The object ends change: knyga becomes knygą."],"rows":[["I read a book","aš skaitau knygą","ash SKAI-tow KNEE-gah"],["he drinks tea","jis geria arbatą","yis GEH-ryah ar-BAH-tah"],["a big house","didelis namas","DEE-deh-lis NAH-mas"],["a new car","nauja mašina","now-YAH mah-shee-NAH"]],"ex":[["I read a book","aš skaitau knygą","ash SKAI-tow KNEE-gah"],["he drinks tea","jis geria arbatą","yis GEH-ryah ar-BAH-tah"],["we go to school","mes einame į mokyklą","mes AY-nah-meh ee moh-KEEK-lah"],["they eat bread","jie valgo duoną","yee-eh VAL-goh DOO-oh-nah"],["the teacher writes","mokytojas rašo","moh-KEE-toh-yas RAH-shoh"]]},{"id":"negation","title":"Negation","text":["Put \"ne\" in front of the verb: nežinau (I do not know). With \"būti\", \"nėra\" replaces \"yra\": nėra vandens (there is no water). Nouns after \"nėra\" take the genitive."],"rows":[["I do not go","aš neinu","ash NAY-noo"],["you do not go","tu neini","too NAY-nee"],["he / she does not go","jis neina","yis NAY-nah"],["it is not good","tai nėra gerai","tie neh-RAH geh-RIE"]],"ex":[["I want","aš noriu","ash NOH-ryoo"],["I do not want","aš nenoriu","ash neh-NOH-ryoo"],["I speak English","aš kalbu angliškai","ash kal-BOO AN-glish-kai"],["I do not speak English","aš nekalbu angliškai","ash neh-kal-BOO AN-glish-kai"],["I like it","man tai patinka","man tie pah-TEEN-kah"],["I do not like it","man tai nepatinka","man tie neh-pah-TEEN-kah"],["she is here","ji yra čia","yee ee-RAH chya"],["she is not here","jos čia nėra","yos chya neh-RAH"],["I have a car","turiu mašiną","TOO-ryoo mah-SHEE-nah"],["I do not have a car","neturiu mašinos","neh-TOO-ryoo mah-SHEE-nos"],["I understand","aš suprantu","ash soo-PRAN-too"],["I do not understand","aš nesuprantu","ash neh-soo-PRAN-too"],["we are tired","mes esame pavargę","mes eh-SAH-meh pah-VAR-geh"],["we are not tired","mes nesame pavargę","mes neh-SAH-meh pah-VAR-geh"],["he works on Sundays","jis dirba sekmadieniais","yis DEER-bah sek-mah-dee-EH-nyais"],["he does not work on Sundays","jis nedirba sekmadieniais","yis neh-DEER-bah sek-mah-dee-EH-nyais"]]},{"id":"asking-questions","title":"Asking questions","text":["Put \"ar\" at the start to turn a sentence into a yes / no question: Ar tu esi studentas? (Are you a student?). Answer \"taip\" (yes) or \"ne\" (no)."],"rows":[["Do you go?","ar tu eini?","ar too AY-nee"],["Is it good?","ar tai gerai?","ar tie geh-RIE"],["Is it right?","ar tai teisinga?","ar tie tay-SIN-gah"]],"ex":[["is this your book?","ar tai tavo knyga?","ar tie TAH-voh KNEE-gah"],["are they here?","ar jie čia?","ar yee-eh chya"],["do you like tea?","ar tau patinka arbata?","ar tow pah-TEEN-kah ar-bah-TAH"],["is it cold?","ar šalta?","ar shal-TAH"],["do you speak English?","ar kalbi angliškai?","ar KAL-bee AN-glish-kai"]]},{"id":"question-words","title":"Question words","text":["Question words come at the start of the sentence."],"rows":[["who","kas","kas"],["what","ką","kah"],["where","kur","koor"],["when","kada","kah-DAH"],["why","kodėl","koh-DEHL"],["how","kaip","kype"],["how much","kiek","kyek"]],"ex":[["what is your name?","kaip tave vadina?","kype tah-VEH vah-DEE-nah"],["who is he?","kas jis?","kas yis"],["where do you live?","kur tu gyveni?","koor too gee-veh-NEE"],["when is the lesson?","kada pamoka?","kah-DAH pah-MOH-kah"],["why are you late?","kodėl vėluoji?","koh-DEHL veh-LOO-oh-yee"],["how much is it?","kiek tai kainuoja?","kyek tie kie-NOO-oh-yah"],["which book?","kuri knyga?","KOO-ree KNEE-gah"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["Lithuanian possessives do not change: mano (my), tavo (your), jo (his), jos (her), mūsų (our), jūsų (your, formal), jų (their). \"Patikti\" means \"to please\": man patinka arbata (tea pleases me)."],"rows":[["my book","mano knyga","MAH-noh KNEE-gah"],["my father","mano tėtis","MAH-noh TEH-tis"],["your book","tavo knyga","TAH-voh KNEE-gah"],["his / her book","jo / jos knyga","yoh / yos KNEE-gah"]],"ex":[["my phone","mano telefonas","MAH-noh teh-leh-FOH-nas"],["your house (formal)","jūsų namas","YOO-soo NAH-mas"],["his sister","jo sesuo","yoh seh-SOO-oh"],["I like music","man patinka muzika","man pah-TEEN-kah MOO-zee-kah"],["I love football","aš myliu futbolą","ash MEE-lyoo foot-BOH-lah"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Use \"jūs\" (with \"esate\", \"galite\") for one older person, a stranger or in a formal setting. Use \"tu\" with friends, family and children."],"rows":[["sir","pone","POH-neh"],["madam","ponia","POH-nyah"]],"ex":[["how are you? (informal)","kaip sekasi?","kype seh-kah-SEE"],["how are you? (formal)","kaip jums sekasi?","kype yooms seh-kah-SEE"],["where are you going? (informal)","kur eini?","koor AY-nee"],["where are you going? (formal)","kur einate?","koor AY-nah-teh"],["please sit down (formal)","prašom sėstis","prah-SHOM SEHS-tis"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: past forms (aš valgiau, I ate). Future: end in -siu (aš valgysiu, I will eat). The past of \"būti\": buvau, buvai, buvo."],"rows":[["I ate","aš valgiau","ash VAL-gyow"],["I will eat","aš valgysiu","ash val-GEE-syoo"],["I will go tomorrow","rytoj eisiu","ree-TOY AY-syoo"]],"ex":[["yesterday I was tired","vakar buvau pavargęs","VAH-kar boo-VOW pah-VAR-gehs"],["I will study tomorrow","rytoj mokysiuos","ree-TOY moh-KEE-syoo-os"],["we went to the park","mes ėjome į parką","mes eh-YOH-meh ee PAR-kah"],["I saw him","aš jį mačiau","ash yee MAH-chyow"],["she wrote a letter","ji parašė laišką","yee pah-rah-SHEH LAISH-kah"]]},{"id":"commands","title":"Commands","text":["Use the \"tu\" form: eik! (go!), ateik! (come!). Add \"-ite\" for \"jūs\": eikite! For \"do not\", put \"ne\" before: neik!"],"rows":[["come!","ateik!","ah-TAYK"],["wait!","palauk!","pah-LOWK"],["do not go","neik","nayk"],["please wait","prašom palaukti","prah-SHOM pah-LOWK-tee"]],"ex":[["come here","ateik čia","ah-TAYK chya"],["do not come here","neateik čia","neh-ah-TAYK chya"],["sit down","sėskis","SEHS-kis"],["do not sit down","nesėskis","neh-SEHS-kis"],["be quiet","tylėk","tee-LEHK"],["do not be late","nevėluok","neh-veh-LOO-ok"],["open the door","atidaryk duris","ah-tee-dah-REEK doo-REES"],["close the window","uždaryk langą","oozh-dah-REEK LAN-gah"],["listen to me","klausyk manęs","klow-SEEK mah-NEHS"],["do not worry","nesijaudink","neh-see-YOW-dink"],["speak slowly","kalbėk lėčiau","kal-BEHK leh-CHYOW"],["wait a moment","palauk minutėlę","pah-LOWK mee-noo-TEH-leh"]]},{"id":"can-must-want","title":"Can, must, want","text":["\"Galėti\" (can), \"turėti\" (must) and \"norėti\" (want) change for person. They are followed by the \"to\" form of the verb: aš galiu plaukti (I can swim)."],"rows":[["I can swim","galiu plaukti","GAH-lyoo PLOWK-tee"],["I must go","turiu eiti","TOO-ryoo AY-tee"],["I want to go","noriu eiti","NOH-ryoo AY-tee"],["may I?","ar galiu?","ar GAH-lyoo"]],"ex":[["I can swim","galiu plaukti","GAH-lyoo PLOWK-tee"],["I cannot swim","negaliu plaukti","neh-GAH-lyoo PLOWK-tee"],["can you help me?","ar gali man padėti?","ar GAH-lee man pah-DEH-tee"],["we must go","mes turime eiti","mes TOO-ree-meh AY-tee"],["we must not go","mums negalima eiti","moomz neh-GAH-lee-mah AY-tee"],["I want to eat","noriu valgyti","NOH-ryoo VAL-gee-tee"],["I do not want to eat","nenoriu valgyti","neh-NOH-ryoo VAL-gee-tee"],["you can come","gali ateiti","GAH-lee ah-TAY-tee"],["you cannot come","negali ateiti","neh-GAH-lee ah-TAY-tee"],["she wants to study","ji nori mokytis","yee NOH-ree MOH-kee-tis"],["I must work today","šiandien turiu dirbti","SHYAN-dyen TOO-ryoo DEER-tee"],["you must not run","negalima bėgti","neh-GAH-lee-mah BEHG-tee"]]},{"id":"in-on-at","title":"In, on, at","text":["Prepositions: \"ant\" (on), \"po\" (under), \"šalia\" (next to), \"prie\" (at, by), \"netoli\" (near). For \"in\" Lithuanian changes the noun ending: mokykla becomes mokykloje (at school), namai becomes namuose (at home)."],"rows":[["in the house","name","NAH-meh"],["on the table","ant stalo","ant STAH-loh"],["under the table","po stalu","poh STAH-loo"],["at school","mokykloje","moh-KEEK-loh-yeh"]],"ex":[["the book is on the table","knyga yra ant stalo","KNEE-gah ee-RAH ant STAH-loh"],["the cat is under the table","katė yra po stalu","kah-TEH ee-RAH poh STAH-loo"],["I am at school","esu mokykloje","eh-SOO moh-KEEK-loh-yeh"],["I am at home","esu namie","eh-SOO nah-MYEH"],["the shop is next to the bank","parduotuvė yra šalia banko","par-doo-oh-too-VEH ee-RAH shah-LYAH BAN-koh"],["the park is near the station","parkas yra netoli stoties","PAR-kas ee-RAH neh-toh-LEE stoh-TYES"],["we meet in the morning","susitinkame ryte","soo-see-TIN-kah-meh ree-TEH"],["the lesson is at nine","pamoka yra devintą valandą","pah-MOH-kah ee-RAH deh-VIN-tah VAH-lan-dah"],["the key is in the bag","raktas yra krepšyje","RAK-tas ee-RAH krep-SHEE-yeh"]]},{"id":"comparing-things","title":"Comparing things","text":["Add \"-esnis / -esnė\" to an adjective for \"more\": didelis, didesnis (big, bigger). For \"the most\", add \"-iausias\": didžiausias. \"Už\" means \"than\"."],"rows":[["big, bigger","didelis, didesnis","DEE-deh-lis, dee-DES-nis"],["good, better","geras, geresnis","GEH-ras, geh-RES-nis"],["the biggest","didžiausias","dee-JHYOW-syas"]],"ex":[["big, bigger, the biggest","didelis, didesnis, didžiausias","DEE-deh-lis, dee-DES-nis, dee-JHYOW-syas"],["small, smaller, the smallest","mažas, mažesnis, mažiausias","MAH-zhas, mah-ZHES-nis, mah-ZHYOW-syas"],["this is better than that","šis geresnis už tą","shis geh-RES-nis oozh tah"],["this is worse than that","šis blogesnis už tą","shis bloh-GES-nis oozh tah"],["she is taller than me","ji aukštesnė už mane","yee owk-SHTES-neh oozh mah-NEH"],["Tashkent is bigger than Samarkand","Taškentas didesnis už Samarkandą","tash-KEN-tas dee-DES-nis oozh sah-mar-KAN-dah"],["it is the cheapest","tai pigiausia","tie pee-GYOW-syah"],["the same as","toks pat kaip","toks pat kype"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Quick sentences to copy and change."],"rows":[["I am hungry","esu alkanas","eh-SOO al-KAH-nas"],["I am thirsty","noriu gerti","NOH-ryoo GEHR-tee"],["I am cold","man šalta","man shal-TAH"],["it is raining","lyja","LEE-yah"]],"ex":[["he is a teacher","jis yra mokytojas","yis ee-RAH moh-KEE-toh-yas"],["you (plural) are students","jūs esate studentai","yoos eh-SAH-teh stoo-DEN-tai"],["I am happy","aš esu laimingas","ash eh-SOO lie-MIN-gas"],["she is at school","ji yra mokykloje","yee ee-RAH moh-KEEK-loh-yeh"],["you are my friend","tu esi mano draugas","too eh-SEE MAH-noh DROW-gas"],["it is cold","šalta","shal-TAH"],["I study English","aš mokausi anglų kalbos","ash moh-KOW-see AN-gloo KAL-bos"],["he teaches maths","jis moko matematikos","yis MOH-koh mah-teh-MAH-tee-kos"],["they work every day","jie dirba kasdien","yee-eh DEER-bah KAS-dyen"],["is this your book?","ar tai tavo knyga?","ar tie TAH-voh KNEE-gah"],["are they here?","ar jie čia?","ar yee-eh chya"],["do you like tea?","ar tau patinka arbata?","ar tow pah-TEEN-kah ar-bah-TAH"],["what time is it?","kiek valandų?","kyek vah-LAN-doo"],["whose book is this?","čia kieno knyga?","chya KYEH-noh KNEE-gah"],["how old are you?","kiek tau metų?","kyek tow MEH-too"],["how do you say it?","kaip tai pasakyti?","kype tie pah-sah-KEE-tee"],["your book (formal)","jūsų knyga","YOO-soo KNEE-gah"],["their house","jų namas","yoo NAH-mas"],["my phone","mano telefonas","MAH-noh teh-leh-FOH-nas"],["excuse me, sir","atsiprašau, pone","at-see-prah-SHOW, POH-neh"],["please sit down (formal)","prašom sėstis","prah-SHOM SEHS-tis"],["come here (informal)","ateik čia","ah-TAYK chya"],["yesterday I was tired","vakar buvau pavargęs","VAH-kar boo-VOW pah-VAR-gehs"],["I will study tomorrow","rytoj mokysiuos","ree-TOY moh-KEE-syoo-os"],["we went to the park","mes ėjome į parką","mes eh-YOH-meh ee PAR-kah"]]}],"name":"Lithuanian (Lietuvių)","id":"lt","flag":"lt","note":""}