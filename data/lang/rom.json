o buy","kinel","KEE-nel"],["to sell","bikinel","bee-KEE-nel"],["to read","genel","GE-nel"],["to write","čhinel","CHEE-nel"],["to work","kerel buti","KE-rel BOO-tee"],["to live","beshel","BE-shel"],["to love","kamel","KA-mel"],["to like","pasandzol","pa-SAN-dzol"],["to wait","rodel","RO-del"],["to open","putrel","POO-trel"],["to close","phandel","PHAN-del"],["to say","phenel","PHE-nel"]]},{"id":"school-subjects","title":"School subjects","items":[["maths","matematika","ma-te-MA-tee-ka"],["physics","fizika","FEE-zee-ka"],["chemistry","kimia","KEE-mi-a"],["biology","biologia","bee-o-LO-gi-a"],["history","istoria","ees-TO-ri-a"],["geography","geografia","ge-o-gra-FEE-a"],["literature","literatura","lee-te-ra-TOO-ra"],["English","angličko čhib","ang-LEE-chko chib"],["Romani language","Romani čhib","RO-ma-nee chib"],["Russian language","rusiko čhib","roo-SEE-ko chib"],["foreign languages","aver čhiba","a-VER CHI-ba"],["art","arta","AR-ta"],["music","muzika","MOO-zee-ka"],["PE","sport","sport"],["computer science","informatika","een-for-MA-tee-ka"],["economics","ekonomia","e-ko-no-MEE-a"],["law","drom","drom"],["philosophy","filozofia","fee-lo-zo-FEE-a"],["psychology","psihologia","psee-ho-lo-GEE-a"],["science","nauka","NA-oo-ka"]]},{"id":"classroom","title":"Classroom","items":[["classroom","klasa","KLA-sa"],["desk","banka","BAN-ka"],["board","tabla","TAB-la"],["notebook","tetradka","te-TRAD-ka"],["textbook","manual","ma-noo-AL"],["homework","kherutni buti","ke-ROOT-nee BOO-tee"],["test","test","test"],["grade","nota","NO-ta"],["timetable","orar","o-RAR"],["break","pauza","PA-oo-za"],["bell","zvono","ZVO-no"],["ruler","linia","LEE-ni-a"],["rubber","gumi","GOO-mee"],["rucksack","rucsac","rook-SAK"],["dictionary","leksikono","lek-SEE-ko-no"],["question","puchipe","poo-CHEE-pe"],["answer","vakeripe","va-ke-REE-pe"],["mistake","greshala","GRE-sha-la"],["pen","penda","PEN-da"],["pencil","pencil","PEN-tseel"]]},{"id":"university","title":"University","items":[["university","universitato","oo-nee-ver-see-TA-to"],["lecture","prelegere","pre-LE-ge-re"],["professor","profesoro","pro-fe-SO-ro"],["degree","diplomo","dee-PLO-mo"],["scholarship","bursa","BOOR-sa"],["library","bibliotek","bee-blee-o-TEK"],["dormitory","kamin","KA-meen"],["campus","kampus","KAM-poos"],["tuition fees","taksa","TAK-sa"],["semester","semestro","se-MES-tro"],["course","kurso","KOOR-so"],["essay","eseu","e-SE-oo"],["thesis","tezo","TE-zo"],["diploma","diploma","dee-PLO-ma"],["seminar","seminaro","se-mee-NA-ro"],["entrance exam","examen de intrare","eg-ZA-men de een-TRA-re"],["application","cerere","tse-RE-re"],["student card","karta de studento","KAR-ta de stoo-DEN-to"],["faculty","fakultato","fa-kool-TA-to"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","siklol","SEE-klol"],["to teach","sikavel","see-KA-vel"],["to ask","puchel","poo-CHEL"],["to answer","dikhel","DEE-khel"],["to repeat","phenel palpale","PHE-nel pal-PA-le"],["to understand","haćarel","HA-cha-rel"],["to remember","yakharel","ya-KHA-rel"],["to forget","bistrel","BEES-trel"],["to explain","phenel","PHE-nel"],["to practise","kerel","KE-rel"],["to pass an exam","nakhel o examen","NA-khel o eg-ZA-men"],["to fail an exam","našavel o examen","na-SHA-vel o eg-ZA-men"],["to write down","ćhinel tele","CHEE-nel TE-le"],["to listen","šunel","SHOO-nel"],["to read aloud","genel andar","GE-nel an-DAR"],["to think","gindil","GEEN-dil"],["to count","genel","GE-nel"],["to spell","sikavel","see-KA-vel"],["to translate","tradusel","tra-DOO-sel"],["to graduate","agorel o skola","a-GO-rel o SKO-la"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Romani has separate subject and object forms. Subject: me, tu, vov / voj, amen, tumen, on. \"Tu\" is informal and \"tumen\" is the polite you, as well as the plural."],"rows":[["I","me","me"],["you (one)","tu","too"],["he","vov","vov"],["she","voj","voy"],["we","amen","A-men"],["you (plural, polite)","tumen","TOO-men"],["they","on","on"]],"ex":[["I am a student","me som studento","me som stoo-DEN-to"],["you are tall","tu san baro","too san BA-ro"],["she is my older sister","voj si miri bari pheň","voy see MEE-ree BA-ree phen"],["we are friends","amen sam amala","A-men sam a-MA-la"],["they are teachers","on si sikavne","on see see-KAV-ne"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Nouns change their ending: o ćhavo (the boy), e ćhave (the boys); i ćhaj (the girl), e ćhaja (the girls). The article is o (masculine), i (feminine), e (plural)."],"rows":[["the book","i kenvi","ee ken-VEE"],["the books","e kenvi","e ken-VEE"],["the child","o ćhavoro","o cha-VO-ro"],["the children","e ćhavore","e cha-VO-re"]],"ex":[["one house, houses","jekh kher, kher","yekh kher, kher"],["one book, books","jekh kenvi, kenvi","yekh ken-VEE, ken-VEE"],["one cat, cats","jekh mačka, mačke","yekh MACH-ka, MACH-ke"],["two books","duj kenvi","dooy ken-VEE"],["the children","e ćhavore","e cha-VO-re"]]},{"id":"to-be-som-san-si","title":"To be: som, san, si","text":["Present: me som, tu san, vov / voj si, amen sam, tumen san, on si. Past: me sim, tu sian, vov sas, amen sam, tumen san, on sas."],"rows":[["I am","me som","me som"],["you are","tu san","too san"],["he / she is","vov / voj si","vov / voy see"],["we are","amen sam","A-men sam"]],"ex":[["I am a student","me som studento","me som stoo-DEN-to"],["you are tired","tu san thaklo","too san THAK-lo"],["he is a doctor","vov si doktoro","vov see dok-TO-ro"],["we are happy","amen sam bahtale","A-men sam bakh-TA-le"],["they are at home","on si ando kher","on see AN-do kher"]]},{"id":"having-si-man","title":"Having: si man","text":["Romani says \"there is to me\": si man. I have: si man. You have: si tut. He has: si leske. She has: si laske. We have: si amen. To say not have, use \"nane\": nane man."],"rows":[["I have a car","si man mašina","see man ma-SHEE-na"],["you have a car","si tut mašina","see toot ma-SHEE-na"],["he has a car","si leske mašina","see LES-ke ma-SHEE-na"],["I do not have","nane man","NA-ne man"]],"ex":[["I have an older brother","si man jekh baro phral","see man yekh BA-ro phral"],["I have a car","si man mašina","see man ma-SHEE-na"],["I do not have time","nane man vrama","NA-ne man VRA-ma"],["there is a problem","si jekh problema","see yekh pro-BLE-ma"],["there is no water","nane pani","NA-ne PA-nee"]]},{"id":"present-tense","title":"Present tense","text":["Verbs end in -av (I), -es (you), -el (he / she), -as (we), -en (you plural / they). Example: xav, xas, xal, xas, xan. Add \"kamav te\" for want to."],"rows":[["I eat","xav","khav"],["you eat","xas","khas"],["he / she eats","xal","khal"],["we eat","xas","khas"]],"ex":[["I am eating bread","xav maro","khav MA-ro"],["you are reading a book","genes jekh kenvi","GE-nes yekh ken-VEE"],["she works in a bank","voj kerel buti ando banka","voy KE-rel BOO-tee AN-do BAN-ka"],["we drink tea","pijas ćaj","PEE-yas chay"],["they are sleeping","on sovel","on SO-vel"]]},{"id":"basic-sentences","title":"Basic sentences","text":["Word order is flexible. The usual pattern is subject, verb, object. Romani has no verb \"to be\" in some sentences when the meaning is clear."],"rows":[],"ex":[["I read a book","genav jekh kenvi","GE-nav yekh ken-VEE"],["he drinks tea","vov pijel ćaj","vov PEE-yel chay"],["we go to school","džas ki škola","jas kee SHKO-la"],["they eat bread","on xan maro","on khan MA-ro"],["the teacher writes","o sikavno ćhinel","o see-KAV-no CHEE-nel"]]},{"id":"negation","title":"Negation","text":["Put \"na\" before the verb: me na xav (I do not eat). For \"there is not\", use \"nane\". Never use na after a negative word: khanči (nothing), ni jekh (nobody)."],"rows":[["I do not eat","me na xav","me na khav"],["I do not know","me na žanav","me na ZHA-nav"],["there is not","nane","NA-ne"],["nothing","khanči","KHAN-chee"]],"ex":[["I want","kamav","KA-mav"],["I do not want","na kamav","na KA-mav"],["I speak English","rakirav anglikanes","ra-KEE-rav ang-LEE-ka-nes"],["I do not speak English","na rakirav anglikanes","na ra-KEE-rav ang-LEE-ka-nes"],["I like it","pasandzol man","pa-SAN-dzol man"],["I do not like it","na pasandzol man","na pa-SAN-dzol man"],["she is here","voj si kathe","voy see KA-te"],["she is not here","voj nane kathe","voy NA-ne KA-te"],["I have a car","si man mašina","see man ma-SHEE-na"],["I do not have a car","nane man mašina","NA-ne man ma-SHEE-na"],["I understand","haćarav","HA-cha-rav"],["I do not understand","na haćarav","na HA-cha-rav"],["we are tired","sam thakle","sam THAK-le"],["we are not tired","na sam thakle","na sam THAK-le"],["he works on Sundays","vov kerel buti duminika","vov KE-rel BOO-tee doo-MEE-nee-ka"],["he does not work on Sundays","vov na kerel buti duminika","vov na KE-rel BOO-tee doo-MEE-nee-ka"]]},{"id":"asking-questions","title":"Asking questions","text":["Questions have no special word order. Raise your voice at the end. You can also start with \"ma\" or put a question word in front."],"rows":[["is this your book?","si kava ćiri kenvi?","see KA-va CHEE-ree ken-VEE"],["are they here?","si on kathe?","see on KA-te"]],"ex":[["is this your book?","si kava ćiri kenvi?","see KA-va CHEE-ree ken-VEE"],["are they here?","si on kathe?","see on KA-te"],["do you like tea?","pasandzol tut o ćaj?","pa-SAN-dzol toot o chay"],["is it cold?","si šilalo?","see shee-LA-lo"],["do you speak English?","rakires anglikanes?","ra-KEE-res ang-LEE-ka-nes"]]},{"id":"question-words","title":"Question words","text":["so (what), kon (who), kaj (where), kana (when), sostar (why), sar (how), sode (how much), savo (which)."],"rows":[["what","so","so"],["who","kon","kon"],["where","kaj","kay"],["when","kana","KA-na"],["why","sostar","SOS-tar"],["how","sar","sar"],["how much","sode","SO-de"],["which","savo","SA-vo"]],"ex":[["what is your name?","sar akhardol tuke?","sar a-khar-DOL TOO-ke"],["who is he?","kon si vov?","kon see vov"],["where do you live?","kaj bešes?","kay BE-shes"],["when is the lesson?","kana si i lekcia?","KA-na see ee LEK-tsi-a"],["why are you late?","sostar san ko pheder?","SOS-tar san ko phe-DER"],["how much is it?","sode kerel?","SO-de ke-REL"],["which book?","savi kenvi?","SA-vee ken-VEE"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["Possessives agree with the thing owned: miro (my, masculine), miri (my, feminine), mire (my, plural). Same for tiro (your), leskero (his), lakero (her), amaro (our), tumaro (your plural), lengero (their)."],"rows":[["my","miro / miri","MEE-ro / MEE-ree"],["your","tiro / tiri","TEE-ro / TEE-ree"],["his","leskero / leskeri","LES-ke-ro"],["our","amaro / amari","a-MA-ro"]],"ex":[["my phone","miro telefono","MEE-ro te-le-FO-no"],["your house (formal)","tumaro kher","too-MA-ro kher"],["his sister","leskeri pheň","LES-ke-ree phen"],["I like music","kamav i muzika","KA-mav ee MOO-zee-ka"],["I love football","kamav o futbal","KA-mav o FOOT-bal"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Romani uses \"tu\" for one friend and \"tumen\" for respect or many people. The verb also changes: tu san (you are), tumen san (you, polite). It is respectful to use tumen with elders."],"rows":[["you (informal)","tu","too"],["you (formal)","tumen","TOO-men"]],"ex":[["how are you? (informal)","sar san?","sar san"],["how are you? (formal)","sar san tumen?","sar san TOO-men"],["where are you going? (informal)","kaj džas?","kay JAS"],["where are you going? (formal)","kaj džan tumen?","kay jan TOO-men"],["please sit down (formal)","beshen, mangav tumen","BE-shen, MAN-gav TOO-men"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["Past: add -ahm, -an, -as, -am, -an, -e. Example: kerdem (I did), kerdan (you did), kerdas (he did). Future: add -a to the verb: kerava (I will do), kereha (you will)."],"rows":[["I did","kerdem","KER-dem"],["you did","kerdan","KER-dan"],["he did","kerdas","KER-das"],["I will do","kerava","ke-RA-va"]],"ex":[["yesterday I was tired","kerdivěs sim thaklo","ker-DEE-vyes seem THAK-lo"],["I will study tomorrow","tehara sikljovava","te-HA-ra see-klyo-VA-va"],["we went to the park","geleam ando parko","ge-LEAM AN-do PAR-ko"],["I saw him","dikhlem les","DEEKH-lem les"],["she wrote a letter","voj ćhindas jekh vudar","voy CHIN-das yekh VOO-dar"]]},{"id":"commands","title":"Commands","text":["Command to one person: use the root of the verb (ač, dža). To several, add -en (ačen, džan). To forbid, say \"ma\" plus the verb: ma ač (do not stay)."],"rows":[["come","av","av"],["go","dža","ja"],["sit","beš","besh"],["do not","ma","ma"]],"ex":[["come here","av kathe","av KA-te"],["do not come here","ma av kathe","ma av KA-te"],["sit down","beš tele","besh TE-le"],["do not sit down","ma beš tele","ma besh TE-le"],["be quiet","ačh ćipo","ach CHEE-po"],["do not be late","ma avel ko pheder","ma A-vel ko phe-DER"],["open the door","putar o vudar","poo-TAR o VOO-dar"],["close the window","phand o prozori","phand o pro-ZO-ree"],["listen to me","šun man","shoon man"],["do not worry","ma daraj","ma da-RAY"],["speak slowly","rakir pomali","ra-KEER po-MA-lee"],["wait a moment","ažutav tut jekh minuta","a-ZHOO-tav toot yekh mee-NOO-ta"]]},{"id":"can-must-want","title":"Can, must, want","text":["Can: šaj + verb. Cannot: našti + verb. Must: trubul te or mušaj te. Want: kamav te + verb."],"rows":[["can","šaj","shay"],["cannot","našti","NASH-tee"],["must","mušaj","MOO-shay"],["want to","kamav te","KA-mav te"]],"ex":[["I can swim","šaj nuvav","shay noo-VAV"],["I cannot swim","našti nuvav","NASH-tee noo-VAV"],["can you help me?","šaj ažutis man?","shay a-ZHOO-tis man"],["we must go","mušaj te džas","MOO-shay te jas"],["we must not go","na mušaj te džas","na MOO-shay te jas"],["I want to eat","kamav te xav","KA-mav te khav"],["I do not want to eat","na kamav te xav","na KA-mav te khav"],["you can come","šaj aves","shay A-ves"],["you cannot come","našti aves","NASH-tee A-ves"],["she wants to study","voj kamel te siklol","voy KA-mel te SEE-klol"],["I must work today","mušaj te kerav buti adaleske","MOO-shay te KE-rav BOO-tee a-da-LES-ke"],["you must not run","na mušaj te našes","na MOO-shay te NA-shes"]]},{"id":"in-on-at","title":"In, on, at","text":["Romani uses endings and little words: ando (in), pe (on), tel (under), paš (next to), pašal (near), ko (at / to), anglal (in front of)."],"rows":[["in","ando","AN-do"],["on","pe","pe"],["under","tel","tel"],["next to","paš","pash"]],"ex":[["the book is on the table","i kenvi si pe skamind","ee ken-VEE see pe ska-MIND"],["the cat is under the table","i mačka si tel o skamind","ee MACH-ka see tel o ska-MIND"],["I am at school","som ki škola","som kee SHKO-la"],["I am at home","som ando kher","som AN-do kher"],["the shop is next to the bank","o dukjani si paš e banka","o doo-KYA-nee see pash e BAN-ka"],["the park is near the station","o parko si paš i stacia","o PAR-ko see pash ee STA-tsi-a"],["we meet in the morning","dikhas amen ando tosara","DEE-khas A-men AN-do to-SA-ra"],["the lesson is at nine","i lekcia si ko enja","ee LEK-tsi-a see ko EN-ya"],["the key is in the bag","o ćavi si ando tasko","o CHA-vee see AN-do TAS-ko"]]},{"id":"comparing-things","title":"Comparing things","text":["Add \"maj\" (more) before an adjective: maj baro (bigger). The most is \"sa maj\" (maj baro anda sa). Than is \"sar\"."],"rows":[["big","baro","BA-ro"],["bigger","maj baro","may BA-ro"],["the biggest","o maj baro","o may BA-ro"],["than","sar","sar"]],"ex":[["big, bigger, the biggest","baro, maj baro, o maj baro","BA-ro, may BA-ro, o may BA-ro"],["small, smaller, the smallest","tikno, maj tikno, o maj tikno","TEEK-no, may TEEK-no, o may TEEK-no"],["this is better than that","kava si maj lačho sar kova","KA-va see may LA-cho sar KO-va"],["this is worse than that","kava si maj bilačho sar kova","KA-va see may bee-LA-cho sar KO-va"],["she is taller than me","voj si maj bari sar me","voy see may BA-ree sar me"],["Tashkent is bigger than Samarkand","o Tashkent si maj baro sar o Samarkand","o tash-KENT see may BA-ro sar o sa-mar-KAND"],["it is the cheapest","si o maj lešno","see o may LESH-no"],["the same as","sar","sar"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Simple sentences are the best way to start. Use only the words you know and add more later."],"rows":[],"ex":[["he is a teacher","vov si sikavno","vov see see-KAV-no"],["you (plural) are students","tumen san studenti","TOO-men san stoo-DEN-tee"],["I am happy","som bahtalo","som bakh-TA-lo"],["she is at school","voj si ki škola","voy see kee SHKO-la"],["you are my friend","tu san miro amal","too san MEE-ro a-MAL"],["it is cold","si šil","see sheel"],["I study English","siklovav anglikanes","see-klo-VAV ang-LEE-ka-nes"],["he teaches maths","vov sikavel matematika","vov see-KA-vel ma-te-MA-tee-ka"],["they work every day","on keren buti sako dive","on KE-ren BOO-tee SA-ko DEE-ve"],["my phone","miro telefono","MEE-ro te-le-FO-no"],["please sit down (formal)","beshen, mangav tumen","BE-shen, MAN-gav TOO-men"],["yesterday I was tired","kerdivěs sim thaklo","ker-DEE-vyes seem THAK-lo"],["I will study tomorrow","tehara sikljovava","te-HA-ra see-klyo-VA-va"],["we went to the park","geleam ando parko","ge-LEAM AN-do PAR-ko"],["what time is it?","so ora si?","so O-ra see"],["whose book is this?","kasqiri kenvi si kava?","ka-SKEE-ree ken-VEE see KA-va"],["is this your book?","si kava ćiri kenvi?","see KA-va CHEE-ree ken-VEE"],["are they here?","si on kathe?","see on KA-te"],["do you like tea?","pasandzol tut o ćaj?","pa-SAN-dzol toot o chay"],["how old are you?","sode berša si tut?","SO-de BER-sha see toot"],["how do you say it?","sar phenes les?","sar PHE-nes les"],["your book (formal)","tumari kenvi","too-MA-ree ken-VEE"],["their house","lengero kher","LEN-ge-ro kher"],["excuse me, sir","mafi, raja","MA-fee, RA-ya"],["come here (informal)","av kathe","av KA-te"]]}],"name":"Romani (Romani čhib)","id":"rom","flag":"rom","note":""}