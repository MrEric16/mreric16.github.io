laf","","אלף"],["to teach","alef","","אלף"],["the Law (Torah)","oraita","","אורייתא"]]},{"id":"describing","title":"Describing","items":[["good","tav","","טב"],["bad","bish","","ביש"],["big","rav","","רב"],["small","z'er","","זעיר"],["new","khadat","","חדת"],["wise","khakim","","חכים"]]},{"id":"verbs-he-did","title":"Verbs (he did)","items":[["he said","amar","","אמר"],["he went","azal","","אזל"],["he came","ata","","אתא"],["he saw","khaza","","חזא"],["he heard","shma","","שמע"],["he wrote","ktav","","כתב"],["he ate","akhal","","אכל"],["he drank","shta","","שתי"],["he gave","yahav","","יהב"],["he got up","qam","","קם"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Aramaic has no verb \"to be\" in the present. You put the pronoun and the noun side by side: \"ana gavra\" (I a man = I am a man)."],"rows":[["I","ana","אנא"],["you (m)","at","את"],["you (f)","at","את"],["he","hu","הוא"],["she","hi","היא"],["we","anan","אנן"],["you (plural)","atun","אתון"],["they","inun","אינון"]],"ex":[["I am a man","ana gavra","","אנא גברא"],["you are a teacher","at rabbi","","את רבי"],["he is a king","hu malka","","הוא מלכא"],["we are students","anan talmidin","","אנן תלמידין"],["they are teachers","inun rabbanin","","אינון רבנין"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Masculine plural nouns end in -in (gavra, gavrin). Feminine plural nouns end in -an (malkata, malkatan). The ending -a on a noun means \"the\"."],"rows":[["-in (masculine plural)","gavra → gavrin","גברא → גברין"],["-an (feminine plural)","karta → kartan","קרתא → קרתן"]],"ex":[["the man","gavra","","גברא"],["the men","gavrin","","גברין"],["the city","karta","","קרתא"],["the cities","kartan","","קרתן"]]},{"id":"negation","title":"Negation","text":["Put \"la\" before the word you deny. \"Layt\" means \"there is not\". Always compare with the positive form."],"rows":[["not","la","לא"],["there is not","layt","לית"]],"ex":[["I want","ana tsave","","אנא צבי"],["I do not want","la tsave ana","","לא צבי אנא"],["I know","ana yada","","אנא ידע"],["I do not know","la yada ana","","לא ידע אנא"],["there is bread","it lakhma","","אית לחמא"],["there is no bread","layt lakhma","","לית לחמא"],["be afraid","tidchal","","תדחל"],["do not be afraid","la tidchal","","לא תדחל"]]},{"id":"questions","title":"Questions","text":["A question can be marked by the question word alone, with the same word order as a statement."],"rows":[["who","man","מן"],["what","ma","מה"],["where","heikha","היכא"],["why","lama","למה"],["how many","kma","כמה"]],"ex":[["who is he?","man hu","","מן הוא"],["what is this?","ma din","","מה דין"],["where is the house?","heikha beita","","היכא ביתא"],["why?","lama","","למה"],["how many?","kma","","כמה"]]},{"id":"commands","title":"Commands","text":["The command is the short stem. For a woman the ending is -i: qum (to a man), qumi (to a woman)."],"rows":[["get up (to a man)","qum","קום"],["get up (to a woman)","qumi","קומי"],["come","ta","תא"],["go","zil","זיל"]],"ex":[["get up (to a man)","qum","","קום"],["get up (to a woman)","qumi","","קומי"],["come","ta","","תא"],["go","zil","","זיל"]]},{"id":"formal-and-polite","title":"Formal and polite","text":["There is no separate polite pronoun. You show respect with a title: \"mari\" (my lord), \"rabbi\" (my teacher), \"marya\" (Lord)."],"rows":[["my lord","mari","מרי"],["my teacher","rabbi","רבי"],["Lord","marya","מריא"]],"ex":[["my teacher","rabbi","","רבי"],["my lord","mari","","מרי"],["peace be with you","shlama lakh","","שלמא לך"]]},{"id":"possession","title":"Possession","text":["Short endings are added to the noun: -i (my), -akh (your), -eh (his)."],"rows":[["my house","beiti","ביתי"],["your house","beitakh","ביתך"],["his house","beiteh","ביתיה"]],"ex":[["my father","abbi","","אבי"],["my house","beiti","","ביתי"],["your house","beitakh","","ביתך"],["his house","beiteh","","ביתיה"]]}],"name":"Aramaic (Jesus-era)","id":"arc","flag":"arc","script":"Hebrew letters","note":""}