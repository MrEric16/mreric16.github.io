k"],["desk","bàn học","bahn HAWK"],["board","bảng","BAHNG"],["notebook","vở","VUH"],["textbook","sách giáo khoa","sahk zow KHWAH"],["homework","bài tập về nhà","bie tuhp veh NYAH"],["test","bài kiểm tra","bie kiem CHAH"],["grade","điểm","DIEM"],["timetable","thời khóa biểu","toy khwah BIEW"],["break","giờ ra chơi","zuh rah CHOY"],["bell","chuông","CHWONG"],["ruler","thước kẻ","twok KEH"],["rubber","cục tẩy","kook TAY"],["rucksack","cặp sách","kahp SAHK"],["dictionary","từ điển","too DIEN"],["question","câu hỏi","kow HOY"],["answer","câu trả lời","kow chah LOY"],["mistake","lỗi","LOY"],["pen","bút","BOOT"],["pencil","bút chì","boot CHEE"]]},{"id":"university","title":"University","items":[["university","đại học","die HAWK"],["lecture","bài giảng","bie ZAHNG"],["professor","giáo sư","zow SOO"],["degree","bằng cấp","bahng KUHP"],["scholarship","học bổng","hawk BONG"],["library","thư viện","too VIEN"],["dormitory","ký túc xá","kee took SAH"],["campus","khuôn viên trường","khwon vien TRUNG"],["tuition fees","học phí","hawk FEE"],["semester","học kỳ","hawk KEE"],["course","khóa học","khwah HAWK"],["essay","bài luận","bie LWUHN"],["thesis","luận văn","lwuhn VAHN"],["diploma","bằng tốt nghiệp","bahng toht NGHIEP"],["seminar","hội thảo","hoy THOW"],["entrance exam","kỳ thi đầu vào","kee thee dow VOW"],["application","đơn đăng ký","duhn dahng KEE"],["student card","thẻ sinh viên","teh sing VIEN"],["faculty","khoa","KHWAH"]]},{"id":"school-verbs","title":"School verbs","items":[["to study","học","HAWK"],["to teach","dạy","ZAY"],["to ask","hỏi","HOY"],["to answer","trả lời","chah LOY"],["to repeat","lặp lại","luhp LIE"],["to understand","hiểu","HIEW"],["to remember","nhớ","NYUH"],["to forget","quên","KWEN"],["to explain","giải thích","zie THIK"],["to practise","luyện tập","lwien TUHP"],["to pass an exam","thi đỗ","thee DAW"],["to fail an exam","thi trượt","thee TRWUHT"],["to write down","ghi chép","gee CHEP"],["to listen","nghe","NGHE"],["to read aloud","đọc to","dawk TAW"],["to think","nghĩ","NGHEE"],["to count","đếm","DEM"],["to spell","đánh vần","dahng VUHN"],["to translate","dịch","ZIK"],["to graduate","tốt nghiệp","toht NGHIEP"]]}],"grammar":[{"id":"pronouns","title":"Pronouns","text":["Vietnamese pronouns depend on age and relationship. \"Tôi\" is a neutral I. \"Bạn\" is you for a friend of the same age. For older people use kinship words: anh (older brother, any young man), chị (older sister), ông (grandfather, old man), bà (grandmother, old woman). Younger people are \"em\"."],"rows":[["I (neutral)","tôi","toy"],["you (friend)","bạn","bahn"],["he","anh ấy","ahn AY"],["she","cô ấy","koh AY"],["we","chúng tôi","choong TOY"],["you (plural)","các bạn","kahk BAHN"],["they","họ","haw"]],"ex":[["I am a student","tôi là học sinh","toy lah hawk SING"],["you are tall","bạn cao","bahn KOW"],["she is my older sister","cô ấy là chị gái của tôi","koh ay lah chee gie koo-ah TOY"],["we are friends","chúng tôi là bạn","choong toy lah BAHN"],["they are teachers","họ là giáo viên","haw lah zow VIEN"]]},{"id":"singular-and-plural","title":"Singular and plural","text":["Nouns never change. Use \"những\" or \"các\" before the noun for a plural: những cuốn sách (the books). After a number, a classifier word goes between the number and the noun."],"rows":[["book (one or many)","sách","sahk"],["the books","những cuốn sách","nyoong kwon SAHK"],["two books","hai cuốn sách","hie kwon SAHK"],["three houses","ba ngôi nhà","bah ngoy NYAH"]],"ex":[["one house, houses","một ngôi nhà, những ngôi nhà","moht ngoy nyah, nyoong ngoy NYAH"],["one book, books","một cuốn sách, những cuốn sách","moht kwon sahk, nyoong kwon SAHK"],["one cat, cats","một con mèo, những con mèo","moht kon mew, nyoong kon MEW"],["two books","hai cuốn sách","hie kwon SAHK"],["the children","những đứa trẻ","nyoong doo-ah TREH"]]},{"id":"to-be-l-th","title":"To be: là, ở, thì","text":["\"Là\" links two nouns (I am a student). Adjectives need no verb. For places use \"ở\" (at)."],"rows":[["I am a teacher","tôi là giáo viên","toy lah zow VIEN"],["this is a book","đây là một cuốn sách","day lah moht kwon SAHK"],["I am at home","tôi ở nhà","toy uh NYAH"],["I am tall","tôi cao","toy KOW"]],"ex":[["I am a student","tôi là học sinh","toy lah hawk SING"],["you are tired","bạn mệt","bahn MET"],["he is a doctor","anh ấy là bác sĩ","ahn ay lah bahk SEE"],["we are happy","chúng tôi vui","choong toy VOOY"],["they are at home","họ ở nhà","haw uh NYAH"]]},{"id":"having-c","title":"Having: có","text":["\"Có\" means to have and also \"there is\". Put it before the thing."],"rows":[["I have","tôi có","toy KAW"],["you have","bạn có","bahn KAW"],["he / she has","anh ấy có","ahn ay KAW"],["I do not have","tôi không có","toy khohm KAW"]],"ex":[["I have an older brother","tôi có một anh trai","toy kaw moht ahn TRIE"],["I have a car","tôi có một chiếc xe hơi","toy kaw moht chiek seh HUHY"],["I do not have time","tôi không có thời gian","toy khohm kaw toy ZAHN"],["there is a problem","có một vấn đề","kaw moht vuhn DEH"],["there is no water","không có nước","khohm kaw NOOK"]]},{"id":"present-tense","title":"Present tense","text":["Verbs never change. \"Tôi ăn\", \"anh ăn\" and \"họ ăn\" all use \"ăn\". Add \"đang\" before the verb to say it is happening now."],"rows":[["I eat","tôi ăn","toy AHN"],["you eat","bạn ăn","bahn AHN"],["he / she eats","anh ấy ăn","ahn ay AHN"],["I am eating","tôi đang ăn","toy dahng AHN"]],"ex":[["I am eating bread","tôi đang ăn bánh mì","toy dahng ahn bahng MEE"],["you are reading a book","bạn đang đọc sách","bahn dahng dawk SAHK"],["she works in a bank","cô ấy làm việc ở ngân hàng","koh ay lahm viek uh nguhn HAHNG"],["we drink tea","chúng tôi uống trà","choong toy wong CHAH"],["they are sleeping","họ đang ngủ","haw dahng NGOO"]]},{"id":"basic-sentences","title":"Basic sentences","text":["The order is subject, verb, object, just as in English. Adjectives come after the noun."],"rows":[["I read a book","tôi đọc sách","toy dawk SAHK"],["he drinks tea","anh ấy uống trà","ahn ay wong CHAH"],["a big house","một ngôi nhà to","moht ngoy nyah TAW"],["a new car","một chiếc xe mới","moht chiek seh MUHY"]],"ex":[["I read a book","tôi đọc sách","toy dawk SAHK"],["he drinks tea","anh ấy uống trà","ahn ay wong CHAH"],["we go to school","chúng tôi đi học","choong toy dee HAWK"],["they eat bread","họ ăn bánh mì","haw ahn bahng MEE"],["the teacher writes","giáo viên viết","zow vien VIET"]]},{"id":"negation","title":"Negation","text":["Put \"không\" before the verb or adjective. For the past, use \"chưa\" (not yet) or \"không\" with \"đã\"."],"rows":[["I do not go","tôi không đi","toy khohm DEE"],["it is not good","không tốt","khohm TOHT"],["I have not eaten yet","tôi chưa ăn","toy choo-ah AHN"]],"ex":[["I want","tôi muốn","toy MWON"],["I do not want","tôi không muốn","toy khohm MWON"],["I speak English","tôi nói tiếng Anh","toy noy tiung AHN"],["I do not speak English","tôi không nói tiếng Anh","toy khohm noy tiung AHN"],["I like it","tôi thích nó","toy thik NAW"],["I do not like it","tôi không thích nó","toy khohm thik NAW"],["she is here","cô ấy ở đây","koh ay uh DAY"],["she is not here","cô ấy không ở đây","koh ay khohm uh DAY"],["I have a car","tôi có xe hơi","toy kaw seh HUHY"],["I do not have a car","tôi không có xe hơi","toy khohm kaw seh HUHY"],["I understand","tôi hiểu","toy HIEW"],["I do not understand","tôi không hiểu","toy khohm HIEW"],["we are tired","chúng tôi mệt","choong toy MET"],["we are not tired","chúng tôi không mệt","choong toy khohm MET"],["he works on Sundays","anh ấy làm việc vào chủ nhật","ahn ay lahm viek vow choo NHUHT"],["he does not work on Sundays","anh ấy không làm việc vào chủ nhật","ahn ay khohm lahm viek vow choo NHUHT"]]},{"id":"asking-questions","title":"Asking questions","text":["Add \"không\" at the end of the sentence for a yes or no question. Reply with the verb: \"Bạn đi không?\" \"Đi.\" (yes) or \"Không đi.\" (no)."],"rows":[["Do you go?","bạn đi không?","bahn dee KHOHM"],["Is it good?","tốt không?","toht KHOHM"],["Is it right?","đúng không?","doong KHOHM"]],"ex":[["is this your book?","đây có phải sách của bạn không?","day kaw fie sahk koo-ah bahn KHOHM"],["are they here?","họ có ở đây không?","haw kaw uh day KHOHM"],["do you like tea?","bạn có thích trà không?","bahn kaw thik chah KHOHM"],["is it cold?","có lạnh không?","kaw lahng KHOHM"],["do you speak English?","bạn có nói tiếng Anh không?","bahn kaw noy tiung ahn KHOHM"]]},{"id":"question-words","title":"Question words","text":["Question words stay in the place of the answer. \"Bạn tên là gì?\" is literally \"you name be what?\"."],"rows":[["who","ai","IE"],["what","gì","ZEE"],["where","ở đâu","uh DOW"],["when","khi nào","khee NOW"],["why","tại sao","tie SOW"],["how","như thế nào","nyoo teh NOW"],["how much","bao nhiêu","bow NHIEW"]],"ex":[["what is your name?","bạn tên là gì?","bahn ten lah ZEE"],["who is he?","anh ấy là ai?","ahn ay lah IE"],["where do you live?","bạn sống ở đâu?","bahn song uh DOW"],["when is the lesson?","khi nào có tiết học?","khee now kaw tiet HAWK"],["why are you late?","tại sao bạn đến muộn?","tie sow bahn den MWON"],["how much is it?","cái này giá bao nhiêu?","kie nie zah bow NHIEW"],["which book?","cuốn sách nào?","kwon sahk NOW"]]},{"id":"possessives-and-liking","title":"Possessives and liking","text":["Put \"của\" (of) between the owned thing and the owner: sách của tôi (book of me). In speech \"của\" is often dropped."],"rows":[["my book","sách của tôi","sahk koo-ah TOY"],["your house","nhà của bạn","nyah koo-ah BAHN"],["his sister","em gái của anh ấy","em gie koo-ah ahn AY"]],"ex":[["my phone","điện thoại của tôi","dien twie koo-ah TOY"],["your house (formal)","nhà của ông/bà","nyah koo-ah ong / BAH"],["his sister","chị gái của anh ấy","chee gie koo-ah ahn AY"],["I like music","tôi thích âm nhạc","toy thik uhm NHAHK"],["I love football","tôi yêu bóng đá","toy yiew bong DAH"]]},{"id":"formal-vs-informal","title":"Formal vs informal","text":["Politeness is shown by pronouns and by \"ạ\" at the end of a sentence for elders. Say \"dạ\" for yes to an older person, \"vâng\" in the north."],"rows":[["yes (polite)","dạ","yah"],["thank you (polite)","cảm ơn ạ","kahm uhn AH"],["excuse me (polite)","xin lỗi ạ","sin loy AH"]],"ex":[["how are you? (informal)","bạn khỏe không?","bahn KHWEH khohm"],["how are you? (formal)","ông/bà có khỏe không ạ?","ong / bah kaw KHWEH khohm AH"],["where are you going? (informal)","bạn đi đâu?","bahn dee DOW"],["where are you going? (formal)","ông/bà đi đâu ạ?","ong / bah dee DOW AH"],["please sit down (formal)","xin mời ông/bà ngồi","sin muhy ong / bah NGOY"]]},{"id":"past-and-future-simple","title":"Past and future (simple)","text":["No verb changes. Past: put \"đã\" before the verb. Future: put \"sẽ\" before the verb."],"rows":[["I ate","tôi đã ăn","toy dah AHN"],["I will eat","tôi sẽ ăn","toy seh AHN"],["I will go tomorrow","ngày mai tôi sẽ đi","ngay my toy seh DEE"]],"ex":[["yesterday I was tired","hôm qua tôi mệt","hohm kwah toy MET"],["I will study tomorrow","ngày mai tôi sẽ học","ngay my toy seh HAWK"],["we went to the park","chúng tôi đã đi công viên","choong toy dah dee kong VIEN"],["I saw him","tôi đã thấy anh ấy","toy dah thay ahn AY"],["she wrote a letter","cô ấy đã viết một lá thư","koh ay dah viet moht lah TOO"]]},{"id":"commands","title":"Commands","text":["Use the bare verb. Add \"đi\" at the end to make it friendlier, or \"xin\" at the start to be polite. To forbid, put \"đừng\" in front."],"rows":[["come!","đến đây","den DAY"],["wait!","đợi đã","duhy DAH"],["do not go","đừng đi","doong DEE"],["please wait","xin đợi","sin DUHY"]],"ex":[["come here","đến đây","den DAY"],["do not come here","đừng đến đây","doong den DAY"],["sit down","ngồi xuống","ngoy SWONG"],["do not sit down","đừng ngồi xuống","doong ngoy SWONG"],["be quiet","im lặng","im LAHNG"],["do not be late","đừng đến muộn","doong den MWON"],["open the door","mở cửa","muh KOO-ah"],["close the window","đóng cửa sổ","dong koo-ah SAW"],["listen to me","nghe tôi","nghe TOY"],["do not worry","đừng lo","doong LAW"],["speak slowly","nói chậm thôi","noy chuhm TOY"],["wait a moment","đợi một lát","duhy moht LAHT"]]},{"id":"can-must-want","title":"Can, must, want","text":["\"Có thể\" (can), \"phải\" (must) and \"muốn\" (want) go before the main verb. \"Không thể\" means cannot."],"rows":[["I can swim","tôi biết bơi","toy biet BUH"],["I must go","tôi phải đi","toy fie DEE"],["I want to go","tôi muốn đi","toy mwon DEE"],["may I?","tôi được không?","toy duk KHOHM"]],"ex":[["I can swim","tôi biết bơi","toy biet BUH"],["I cannot swim","tôi không biết bơi","toy khohm biet BUH"],["can you help me?","bạn giúp tôi được không?","bahn zoop toy duk KHOHM"],["we must go","chúng tôi phải đi","choong toy fie DEE"],["we must not go","chúng tôi không được đi","choong toy khohm duk DEE"],["I want to eat","tôi muốn ăn","toy mwon AHN"],["I do not want to eat","tôi không muốn ăn","toy khohm mwon AHN"],["you can come","bạn có thể đến","bahn kaw teh DEN"],["you cannot come","bạn không thể đến","bahn khohm teh DEN"],["she wants to study","cô ấy muốn học","koh ay mwon HAWK"],["I must work today","hôm nay tôi phải làm việc","hohm nie toy fie lahm VIEK"],["you must not run","bạn không được chạy","bahn khohm duk CHIE"]]},{"id":"in-on-at","title":"In, on, at","text":["Vietnamese uses little words before the place: \"ở\" (at), \"trong\" (in), \"trên\" (on), \"dưới\" (under), \"cạnh\" (next to), \"gần\" (near)."],"rows":[["in the house","trong nhà","trong NYAH"],["on the table","trên bàn","trehn BAHN"],["under the table","dưới bàn","zoo-uy BAHN"],["at school","ở trường","uh TRUNG"]],"ex":[["the book is on the table","quyển sách ở trên bàn","kwien sahk uh trehn BAHN"],["the cat is under the table","con mèo ở dưới bàn","kon mew uh zoo-uy BAHN"],["I am at school","tôi ở trường","toy uh TRUNG"],["I am at home","tôi ở nhà","toy uh NYAH"],["the shop is next to the bank","cửa hàng ở cạnh ngân hàng","koo-ah hahng uh kahng nguhn HAHNG"],["the park is near the station","công viên ở gần nhà ga","kong vien uh guhn nyah GAH"],["we meet in the morning","chúng ta gặp nhau vào buổi sáng","choong tah gahp nyow vow bwoy SAHNG"],["the lesson is at nine","tiết học lúc chín giờ","tiet hawk look cheen ZUH"],["the key is in the bag","chìa khóa ở trong túi","chee-ah khwah uh trong TOOY"]]},{"id":"comparing-things","title":"Comparing things","text":["Put \"hơn\" (more) after the adjective: to hơn (bigger). For \"the most\", put \"nhất\" after it: to nhất. \"Than\" is \"hơn\" and the second item follows."],"rows":[["big, bigger","to, to hơn","taw, taw HUHN"],["good, better","tốt, tốt hơn","toht, toht HUHN"],["the biggest","to nhất","taw NHUHT"]],"ex":[["big, bigger, the biggest","to, to hơn, to nhất","taw, taw huhn, taw NHUHT"],["small, smaller, the smallest","nhỏ, nhỏ hơn, nhỏ nhất","nyaw, nyaw huhn, nyaw NHUHT"],["this is better than that","cái này tốt hơn cái kia","kie nie toht huhn kie KEE-ah"],["this is worse than that","cái này tệ hơn cái kia","kie nie teh huhn kie KEE-ah"],["she is taller than me","cô ấy cao hơn tôi","koh ay kow huhn TOY"],["Tashkent is bigger than Samarkand","Tashkent lớn hơn Samarkand","tash-KENT luhn huhn sa-mar-KAHND"],["it is the cheapest","cái này rẻ nhất","kie nie reh NHUHT"],["the same as","giống như","zawng NYOO"]]},{"id":"everyday-sentences","title":"Everyday sentences","text":["Quick sentences to copy and change."],"rows":[["I am hungry","tôi đói","toy DOY"],["I am thirsty","tôi khát","toy KHAHT"],["I am cold","tôi lạnh","toy LAHNG"],["it is raining","trời mưa","troy MOO-ah"]],"ex":[["he is a teacher","anh ấy là giáo viên","ahn ay lah zow VIEN"],["you (plural) are students","các bạn là học sinh","kahk bahn lah hawk SING"],["I am happy","tôi vui","toy VOOY"],["she is at school","cô ấy ở trường","koh ay uh TRUNG"],["you are my friend","bạn là bạn của tôi","bahn lah bahn koo-ah TOY"],["it is cold","trời lạnh","troy LAHNG"],["I study English","tôi học tiếng Anh","toy hawk tiung AHN"],["he teaches maths","anh ấy dạy toán","ahn ay zay TWAHN"],["they work every day","họ làm việc mỗi ngày","haw lahm viek moy NGAY"],["is this your book?","đây có phải sách của bạn không?","day kaw fie sahk koo-ah bahn KHOHM"],["are they here?","họ có ở đây không?","haw kaw uh day KHOHM"],["do you like tea?","bạn có thích trà không?","bahn kaw thik chah KHOHM"],["what time is it?","mấy giờ rồi?","may zuh ROY"],["whose book is this?","đây là sách của ai?","day lah sahk koo-ah IE"],["how old are you?","bạn bao nhiêu tuổi?","bahn bow nhiew TWOY"],["how do you say it?","nói thế nào?","noy teh NOW"],["your book (formal)","sách của ông/bà","sahk koo-ah ong / BAH"],["their house","nhà của họ","nyah koo-ah HAW"],["my phone","điện thoại của tôi","dien twie koo-ah TOY"],["excuse me, sir","xin lỗi ông","sin loy ONG"],["please sit down (formal)","xin mời ông/bà ngồi","sin muhy ong / bah NGOY"],["come here (informal)","đến đây","den DAY"],["yesterday I was tired","hôm qua tôi mệt","hohm kwah toy MET"],["I will study tomorrow","ngày mai tôi sẽ học","ngay my toy seh HAWK"],["we went to the park","chúng tôi đã đi công viên","choong toy dah dee kong VIEN"]]}],"name":"Vietnamese","id":"vi","flag":"vn","note":""}